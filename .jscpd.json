{
  "threshold": 1,
  "minLines": 8,
  "format": [
    "python",
    "javascript",
    "typescript",
    "tsx"
  ],
  "ignore": [
    "**/tests/**",
    "**/vendor/**",
    "web/i18n-cs.js",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/.venv/**",
    "data/**",
    "**/dist/**",
    "**/bundle/**",
    "**/.next/**",
    "**/out/**"
  ],
  "reporters": [
    "console"
  ],
  "silent": true,
  "gitignore": true,
  "maxLines": 20000,
  "maxSize": "2mb"
}
