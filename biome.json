{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": { "includes": ["web/**/*.js", "!web/vendor/**"] },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 20 } } }
    }
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false }
}
