#!/usr/bin/env bash
# The one quality command. The pre-push hook runs it, CI runs it, agents run it before calling work done.
# Red means not done: fix the code, never lower a limit, skip a test or push with --no-verify.
set -euo pipefail
cd "$(dirname "$0")/.."
BASE="${CHECK_BASE:-origin/main}"   # what this change is compared with (CI passes the commit before the push)
FAST="${1:-}"                       # --fast: everything but the test suite (~3 min), for the pre-push hook

step() { printf '\n› %s\n' "$1"; }

step "lint: zero tolerance (ruff.toml)"
uvx ruff@0.17.6 check --quiet

step "quality ratchet: strict rules for new code, old code may not get worse"
python3 scripts/ratchet.py

step "type errors: pyright (pyrightconfig.json), count per area may only go down"
python3 scripts/scores.py types

step "copy-paste (jscpd, .jscpd.json)"
if ! command -v npx >/dev/null; then
  echo "warning: no Node here, copy-paste not checked (CI checks it)"
elif ! npx -y jscpd@4.0.5 --config .jscpd.json . >/dev/null; then
  npx -y jscpd@4.0.5 --config .jscpd.json --reporters consoleFull .
  exit 1
fi

step "the checks themselves were not loosened"
# What an agent stuck on a red check is tempted to do instead of fixing the code. Each needs a commit
# line `Quality-exception: <why>` in this change, so the reason is on record for the owner.
if git rev-parse -q --verify "$BASE^{commit}" >/dev/null; then
  # Compare with where this branch left the base, not the base's tip: origin/main moves under every worktree when
  # another session fetches, and a test file added there would read as deleted here.
  BASE="$(git merge-base "$BASE" HEAD)"
  problems=()
  [ -n "$(git diff --diff-filter=D --name-only "$BASE" -- tests/)" ] && problems+=("deletes a test file")
  git diff "$BASE" -- tests/ | grep -qE '^\+.*(unittest\.skip|skipTest\(|expectedFailure)' && problems+=("skips a test")
  git diff "$BASE" -- '*.py' '*.js' 'client/*' ':!scripts/check' | grep -qE '^\+.*(# *noqa|biome-ignore|# *type: *ignore|# *pyright: *(ignore|basic|standard))' && problems+=("adds a lint suppression")
  # A new Python module starts strict: `# pyright: strict` near its top, so it adds no type errors to carry.
  for f in $(git diff --diff-filter=A --name-only "$BASE" -- 'hub/*.py' 'collector/*.py' 'scripts/*.py' 'client/*'); do
    head -c 40 "$f" | grep -q python3 || [[ "$f" == *.py ]] || continue
    head -n 5 "$f" | grep -q '^# pyright: strict' || problems+=("adds $f without '# pyright: strict' in its first 5 lines")
  done
  [ -n "$(git diff --name-only "$BASE" -- ruff.toml ruff.strict.toml biome.json .jscpd.json \
      pyrightconfig.json .coveragerc requirements-dev.txt scripts/ratchet.py scripts/scores.py scripts/check .githooks)" ] \
    && problems+=("changes a check's configuration")
  python3 scripts/ratchet.py --raised-since "$BASE" || problems+=("loosens quality-baseline.json")
  if [ ${#problems[@]} -gt 0 ] && ! git log --format=%B "$BASE..HEAD" 2>/dev/null | grep -q '^Quality-exception: .\+'; then
    printf 'This change %s.\nFix the code instead, or add a commit line "Quality-exception: <why>".\n' "$(IFS=,; echo "${problems[*]}")"
    exit 1
  fi
fi

if [ "$FAST" = "--fast" ]; then printf '\n✓ fast check passed (CI runs the tests)\n'; exit 0; fi

step "tests, with coverage (.coveragerc): coverage per area may only go up"
# A throwaway env with the pinned tools (requirements-dev.txt) on this machine's Python.
dev() { uv run -q --no-project --python python3 --with-requirements requirements-dev.txt "$@"; }
dev python -m coverage run -m unittest discover -s tests -q
dev python scripts/scores.py coverage

printf '\n✓ check passed\n'
