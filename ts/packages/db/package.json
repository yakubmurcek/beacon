{
  "name": "@beacon/db",
  "private": true,
  "description": "Postgres access for the api and worker: the connection pool, the Drizzle schema, migrations, and the SQLite copy and reverse-copy tools.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "node build.mjs",
    "generate": "drizzle-kit generate --dialect postgresql --schema src/schema.ts --out drizzle",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "drizzle-kit": "0.31.11"
  }
}
