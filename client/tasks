class AnswerWait:
    """`tasks wait`: polls the questions until one is answered, withdrawn or handed to a fresh session, while
    telling the hub a live asker is waiting. Each answered state has its own step; a step returns DONE (the
    answer is printed), NEXT (look at the next question) or AGAIN (the hub hiccupped: poll again later)."""
    DONE, NEXT, AGAIN = 'done', 'next', 'again'
    TRIES = 6  # hub hiccups in a row before a claim or a handoff stops waiting for it

    def __init__(self, ids, timeout, every):
        self.start, self.left = time.time(), list(dict.fromkeys(ids))
        self.parent, self.beat, self.misses, self.hmisses = os.getppid(), 0, 0, 0
        self.timeout, self.every = min(timeout or WAIT_MAX, WAIT_MAX), every

    def run(self):
        while True:
            if os.name != 'nt' and os.getppid() != self.parent:  # its session is gone: never swallow his answer
                sys.exit(4)
            self.heartbeat()
            if self.poll() == self.DONE:
                return
            if time.time() - self.start >= self.timeout:
                if self.left:  # nothing left = all quietly handed off: the session is not woken to hear it
                    print(f"no answer yet: {' '.join('?%d' % x for x in self.left)}. Stop waiting: don't run `tasks wait` "
                          f"again, end your turn now with no text. When he answers, answer-dispatcher resumes this "
                          f"session with his answer.")
                sys.exit(2)
            time.sleep(self.every)

    def heartbeat(self):
        """A live asker: the answer dispatcher leaves the answer to this chat."""
        if time.time() - self.beat < 15:
            return
        self.beat = time.time()
        for qid in self.left:
            try:
                call(f'/api/questions/{qid}/waiting', {})
            except SystemExit:
                pass

    def poll(self):
        for qid in list(self.left):
            try:
                q = call(f'/api/questions/{qid}', auth=False)
            except SystemExit as e:  # the hub restarting or the network gone a while: keep waiting
                if 'unreachable' not in str(e) and 'server error' not in str(e):
                    raise
                return self.AGAIN
            got = self.settle(qid, q)
            if got != self.NEXT:
                return got
        return self.NEXT

    def rest(self, qid):
        return [x for x in self.left if x != qid]

    def settle(self, qid, q):
        if q['status'] == 'withdrawn':
            print(f"?{qid} withdrawn" + (f": {q['answer_note']}" if q.get('answer_note') else ''))
            sys.exit(3)
        if q['status'] != 'answered':
            return self.NEXT
        if q.get('applied_at'):
            return self.applied(qid, q)
        if not q.get('handoff_at') and self.hmisses < self.TRIES:
            got = self.hand_off(qid, q)
            if got:
                return got
        if q.get('handoff_at'):
            print(handed(q, q.get('handoff_reason') or 'it was handed off'), flush=True)
            still_open(self.rest(qid))
            return self.DONE
        return self.claim(qid, q)

    def applied(self, qid, q):
        if str(qid) in os.environ.get('BEACON_QID', '').split(','):
            print(said(q) + '\nThis run was started to carry it out: do it now.', flush=True)
            return self.DONE
        # carried out already: in this chat (a button), or by the answer dispatcher while this machine slept.
        # Say so, so the session never does it a second time.
        print(f"?{qid} answered: {q['answer']}\nAlready carried out "
              + ('in this chat' if q.get('answered_via') == 'chat' else 'elsewhere (answer-dispatcher; he got a Telegram and a note on the task)')
              + ': check its result, do not repeat it.', flush=True)
        still_open(self.rest(qid))
        return self.DONE

    def hand_off(self, qid, q):
        """His answer goes to a fresh session when it is other work or this one is too big and idle; None when
        this session carries it out."""
        try:
            task = call(f"/api/tasks/{q['task_id']}", auth=False) if q.get('task_id') else None
        except SystemExit:
            task = None
        size, idle = session_size()
        why = hand_off_why(q, task, size, idle)
        if not why:
            return None
        # quiet only when nothing here must change course (else it would build on its old default)
        quiet = bool(too_big_idle(q, size, idle)) and not switch_line(q)
        try:
            call(f'/api/questions/{qid}/handoff', {'reason': why})
        except SystemExit:  # a hub blip, or a hub without handoffs yet: after a few, carry it out here
            self.hmisses += 1
            return self.AGAIN
        self.left = self.rest(qid)
        if quiet:
            return self.NEXT  # waking a big idle session only to say "handed" costs what the handoff saves
        print(handed(q, why), flush=True)
        still_open(self.left)
        return self.DONE

    def claim(self, qid, q):
        """Claimed, so the dispatcher never starts a second run on it."""
        try:
            won = call(f'/api/questions/{qid}/claim', {'by': session_id() or 'tasks wait'}).get('won', True)
        except SystemExit:  # a hub blip: try again; only a hub gone for good still hands it over
            self.misses += 1
            won = self.misses >= self.TRIES
            if not won:
                return self.AGAIN
        if not won:
            return self.NEXT  # the dispatcher took it this second: the next poll says so
        print(said(q), flush=True)
        still_open(self.rest(qid))
        return self.DONE


