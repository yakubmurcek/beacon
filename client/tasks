def hook_gate(stdin):
    """The PreToolUse hook. Prints nothing (the call goes on, normal permissions apply) or a deny.
    Never an allow: that would raise permissions everywhere. On its own crash: a call the cheap
    check already found irreversible is denied in enforce mode, anything else goes on, logged."""
    ev, hit = {}, None
    try:
        ev = json.load(stdin)
        if gate_mode() == 'off':
            return 0
        decision, rec = gate(ev)
        if rec:
            gate_log(rec)
        if decision == 'deny':
            reason = DENY.format(cz=CZ[rec['category']], what=rec['what'], verb=VERB[rec['category']], cat=rec['category'])
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'deny',
                                                     'permissionDecisionReason': reason}}, ensure_ascii=False))
        return 0
    except Exception as e:  # noqa: BLE001
        try:
            hit = risky_call(ev.get('tool_name'), ev.get('tool_input') or {}, ev.get('cwd') or '')
        except Exception:  # noqa: BLE001
            hit = None
        gate_log({'ts': time.time(), 'session': ev.get('session_id'), 'tool': ev.get('tool_name'),
                  'error': f'{type(e).__name__}: {e}'[:300], 'category': hit and hit[0]})
        if hit and hit[0] in IRREVERSIBLE and gate_mode() == 'enforce':
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'deny',
                                                     'permissionDecisionReason': '🛑 Brána schválení spadla na riskantní '
                                                     'akci: čeká na jeho ano (`tasks ask --blocking`).'}}, ensure_ascii=False))
        return 0


if __name__ == '__main__' and sys.argv[1:2] == ['hook-gate']:
    sys.exit(hook_gate(sys.stdin))

