def urgency(t, week_ago):
    """Overdue by more than a week is a decision, not today's work (same rule as Lighthouse /today):
    live tasks first, then priority, then the soonest due."""
    return (t.get('due') or '9')[:10] < week_ago, t.get('priority') or 5, t.get('due') or '9', -t['updated_at']


def ls_query(flag):
