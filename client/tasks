def refuse_unfit_ask(a, opts):
    """A card he can't decide from his phone is refused before it is sent: too long, nothing to look at, or
    by-hand work without a checklist."""
    if manual_here() and session_id():
        sys.exit('tasks: refused: this session runs on a machine outside Beacon (he explores here by hand). '
                 'Ask him in this chat instead.')
    if len(a.question.strip()) > ASK_MAX:  # the card's title: a wall of bold text is unreadable
        sys.exit(f'tasks: refused: the question is {len(a.question.strip())} chars, keep it under {ASK_MAX}: only the '
                 'question itself. Put the rest in -c as 2-4 short markdown bullets, each starting with an emoji '
                 '("- 💰 costs 0 Kč", "- ⏱️ 10 min of your time"), and option details in -o "Label :: detail".')
    refuse_unseen(a, opts)


def ask_words(a, opts):
    """The ask's question and options as one text, and its kind as a slug: what the look and hands rules read."""
    text = '\n'.join([a.question, *[o if isinstance(o, str) else o['label'] + ' ' + (o.get('detail') or '') for o in opts]])
    return text, KIND_SLUG.sub('-', (a.kind or '').lower()).strip('-')


def refuse_unseen(a, opts):
    """A look-or-try decision without what to look at, or by-hand work without a checklist."""
    text, kind = ask_words(a, opts)
    look = needs_look(text, kind)
    if look and not a.see and not a.no_see:
        sys.exit(f'tasks: refused: "{look}" means he has to look at or try something to decide, and he decides on '
                 'his phone without opening Claude. Add what he looks at: --see <preview link> (http://<project> on '
                 'the tailnet, or a public Vercel preview that opens logged out) and/or --see <screenshot.png> '
                 '(390 px wide, cropped to the part he decides on; a frame for a video). Several --see are fine. Nothing to see at all? '
                 '--no-see "why".')
    hands = needs_hands(text, kind)
    if hands and not any(x.get('url') for x in step_items(a.step)):
        sys.exit(f'tasks: refused: "{hands}" means he has to do something by hand, on his phone, without opening '
                 'Claude. Give him a checklist: --step "Open Agreements :: <exact page link>" --step "Tap Accept on Paid '
                 'Apps" … (2-6 short steps in plain words; open the link first and check it lands on that page). Keep the '
                 'question one plain line ("Sign Apple\'s Paid Apps agreement?"), one short option ("Done"; never "Not now": his Later button puts it off without waking an agent), and '
                 'put ids, error codes and script names after a "---" line in -c. Not by hand after all? Add a --step anyway.')


