PRIORITY = {1: 'urgent', 2: 'high', 3: 'normal', 4: 'low'}
# A hub restart or a tailnet blip is seconds, not a dead hub: try again before giving up
# (2026-10-30: one timed-out read killed the task agent's whole run).
RETRY_WAITS = (1, 3, 8)
GATEWAY = (502, 503, 504)  # tailscale serve while the hub (re)starts: the hub never saw the request
_vault = None


def token():
    global _vault
    t = os.environ.get('TASKS_TOKEN')
    if t:
        return t
    if _vault is None:  # one vault lookup per process, not one per request
        try:
            _vault = subprocess.run(['secrets', 'get', 'TASKS_TOKEN'], capture_output=True, text=True, timeout=20).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            _vault = ''
    return _vault


def unsent(e):
    """The request never reached the hub, so even a write is safe to send again."""
    reason = getattr(e, 'reason', e)
    return isinstance(reason, (ConnectionRefusedError, socket.gaierror))


def call(path, body=None, auth=True):
    """The hub's JSON answer; a gateway error or a lost connection is retried, anything else exits with why."""
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(URL + path, data=data, headers=_headers(data is not None, auth),
                                 method='POST' if data is not None else 'GET')
    for wait in (*RETRY_WAITS, None):
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code in GATEWAY and wait is not None:
                time.sleep(wait)
                continue
            sys.exit(_http_error(e, path))
        except (OSError, http.client.HTTPException, ValueError) as e:
            # Unreachable, timed out, cut off mid-answer. A write that may have landed is not sent
            # twice (a second note, a second task); a read always is.
            if wait is not None and (data is None or unsent(e)):
                time.sleep(wait)
                continue
            sys.exit(f'tasks: hub unreachable at {URL} ({getattr(e, "reason", None) or e or type(e).__name__})')


def _headers(has_body, auth):
    headers = {'Accept': 'application/json'}
    if has_body:
        headers['Content-Type'] = 'application/json'
    t = token() if auth else None
    if t:
        headers['Authorization'] = 'Bearer ' + t
    return headers


def _http_error(e, path):
    """The line `tasks` exits with for a hub's error answer."""
    try:
        msg = json.load(e).get('error')
    except ValueError:
        msg = None
    if e.code == 401:
        return 'tasks: not allowed to write (no or wrong TASKS_TOKEN; `secrets get TASKS_TOKEN`)'
    if e.code == 404:
        return 'tasks: no such question' if path.startswith('/api/questions') else 'tasks: no such task'
    if e.code >= 500:
        return f'tasks: hub server error {e.code} ({msg or e.reason})'
    return f'tasks: {msg or e}'


