RISK_TEXT_RE = {k: re.compile(v) for k, v in RISK_TEXT.items()}
# client names that, with accents off, read as an English word (settings `agent.client_words`): kept as people
STEPS_RE = re.compile(settings.CONFIG['agent'].get('client_words') or r'(?!x)x', re.I)


def risk_words(text):
    """{category: the word that hit} for a question's text, judged without accents."""
    t = fold(text)
    out = {}
    for cat, rx in RISK_TEXT_RE.items():
        m = rx.search(t)
        if m:
            out[cat] = m.group(0).strip()
    hit = 'people' not in out and STEPS_RE.search(str(text or ''))
    if hit:
        out['people'] = hit.group(0)
    return out


# A decision he can only make by looking or trying (2026-11-22: "I can't decide without seeing it"): the ask
# must carry what to look at (`--see`: the preview link, a screenshot), or say why there is nothing (`--no-see`).
# The hub uses the same words to mark a card that has nothing to look at.
LOOK_KINDS = frozenset({'merge', 'design', 'visual', 'ui', 'ux', 'look', 'copy', 'launch', 'publish', 'release', 'layout',
                        'branding', 'logo', 'video', 'thumbnail', 'playtest', 'taste', 'going-public'})
LOOK_RE = re.compile(r'\b(merge|go(es|ing)? live|live on|put \w+ live|publish|launch|preview|look(s|ing)? (at|like|ok|good|right)|'
                     r'look|look test|public link|design|redesign|screens?|screenshots?|landing|web ?page|website|site|layout|ui|logo|icons?|thumbnails?|'
                     r'banner|mock-?ups?|trailer|video|clip|photo|picture|image|font|colou?rs?|theme|playtest|try it|test it|'
                     r'vzhled|náhled|stránk\w*|webovk\w*|obrázek|fotk\w*|design\w*|vyzkoušej|otestuj|zveřejn\w*|nasadit|spustit)\b', re.I)


KIND_SLUG = re.compile(r'[^a-z0-9]+')


def needs_look(text, kind=None):
    """The word that makes it a look-or-try decision, else None."""
    if kind and (kind in LOOK_KINDS or kind.split('-')[-1] in LOOK_KINDS):  # internal-design, ui-copy...
        return kind
    m = LOOK_RE.search(str(text or ''))
    return m.group(0) if m else None


# A decision he carries out by hand (sign an agreement, top up credit, flip a setting, make a key): the card is a
# checklist, not prose (2026-11-22: "a direct link and clear steps"). The ask must carry `--step`s, one with the
# exact page's link; ids, error codes and script names go after a `---` line in -c (folded under "For the agent").
HANDS_KINDS = frozenset({'setup', 'secrets', 'secret', 'money', 'account', 'billing', 'payment', 'signup', 'login', 'hands',
                         'verify', 'verification', 'settings', 'agreement'})
HANDS_RE = re.compile(r'\b(sign(s|ed|ing)? (it|the|up|in)|agreements?|top (it )?up|turn (it )?on|switch (it )?(on|off)|'
                      r'send (it|the|this|them)|pošleš|pošli|odešleš|log ?in|verify|verification|ID check|pay|payment|invoice|bank account|tax forms?|(api |new )keys?|password|'
                      r'settings?|toggle|podepi\w*|zaplat\w*|dobij\w*|zapni|vypni|přihlas\w*|ověř\w*|nastaven\w*|klíč\w*)\b', re.I)


def needs_hands(text, kind=None):
    """The word that makes it a do-it-by-hand ask, else None."""
    if kind and (kind in HANDS_KINDS or kind.split('-')[-1] in HANDS_KINDS):
        return kind
    m = HANDS_RE.search(str(text or ''))
    return m.group(0) if m else None


def step_items(values):
    """`--step` values: "Click Agreements" or "Open Agreements :: https://…" (the link opens that exact page)."""
    out = []
    for v in values or []:
        text, _, url = v.rpartition('::') if re.search(r'::\s*(https?://|mailto:)', v) else (v, '', '')
        out.append({'text': text.strip(), **({'url': url.strip()} if url.strip() else {})})
    return out


def see_items(values):
    """`--see` values: a link stays a link, a local picture or sound (a voice sample) is uploaded with the ask."""
    out = []
    for v in values or []:
        label, _, ref = v.rpartition('::') if '::' in v else ('', '', v)
        ref, label = ref.strip(), label.strip()
        if re.match(r'^https?://', ref):
            out.append({'url': ref, **({'label': label} if label else {})})
            continue
        path = os.path.expanduser(ref)
        if not os.path.isfile(path):
            sys.exit(f'tasks: --see {ref!r}: not a link (http…) and no such file')
        if path.rsplit('.', 1)[-1].lower() not in ('png', 'jpg', 'jpeg', 'webp', 'gif', 'mp3', 'm4a', 'wav', 'ogg'):
            sys.exit(f'tasks: --see {ref!r}: a picture is png, jpg, webp or gif (screenshot the page or video); '
                     'a sound is mp3, m4a, wav or ogg')
        with open(path, 'rb') as f:
            data = f.read()
        if len(data) > 8 * 1024 * 1024:
            sys.exit(f'tasks: --see {ref!r}: over 8 MB, take a smaller screenshot')
        out.append({'name': os.path.basename(path), 'data': base64.b64encode(data).decode(), **({'label': label} if label else {})})
    return out


URL_IN_TEXT = re.compile(r'https?://[^\s<>()\[\]"\'`]+[^\s<>()\[\]"\'`.,;:!?]')


def links_in(text):
    """The links in a text, in order, once each: what a next-step box question points at."""
    return list(dict.fromkeys(URL_IN_TEXT.findall(str(text or ''))))


def question_blocks(kind, texts, asked_blocking=False, default=None):
    """Layer 1: (blocking, why) for a question. Every question blocks unless its kind is on the
    low-risk list AND no risk word shows; an agent may raise it, never lower it."""
    if asked_blocking:
        return True, 'the agent asked it as blocking'
    if default in (None, ''):
        return True, 'no default to go on with'
    hits = risk_words('\n'.join(str(t or '') for t in texts))
    if hits:
        cat, word = next(iter(hits.items()))
        return True, f'risk word "{word}" ({cat})'
    if kind not in LOW_RISK_KINDS:
        return True, f'kind "{kind}" is not on the low-risk list'
    return False, f'low-risk kind "{kind}", no risk word'


