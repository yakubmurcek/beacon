# Where an answer is carried out (research 2026-11-22, ai-brain knowledge/reference/claude-code-session-size.md):
# vendors agree same work continues in the session that has its context ("Continue: same task, context is still
# relevant", Anthropic), new work gets a new session ("when you start a new task, you should also start a new
# session"), and a big session left idle is resumed from a summary anyway ("a session past about 200K tokens that
# sits idle is compacted shortly before the cache expires ... a fresh session still costs less", Claude Code docs).
# A fresh session gets the task, its notes and the card: that is the brief.
BIG_CONTEXT = 200_000
DISPATCHER_NAME = 'answer-dispatcher'  # the hub's taken_by for its runs (hub/questions.py DISPATCHER)
WAIT_MAX = 600.0  # `tasks wait` is for a live chat only; longer, the session ends its turn and the dispatcher resumes it (task 1884)
COLD_AFTER = 50 * 60  # Claude Code's cache lasts an hour on his plan; it compacts a big idle session before that
NO_PROJECT = ('', 'personal', None)


def went_on(q):
    """He picked what a non-blocking asker already went on with (`tasks ask` told it to): nothing new to carry out
    anywhere. An asker that holds the work until he answers says so with --blocking."""
    return bool(q.get('matched_default')) and not q.get('blocking')


def other_work(q, task):
    """Why his answer is other work than its task's session ('' when it is the same work): a card filed on a
    task of one project whose yes means work in another the asker named with -p (2026-11-22: 14 repos' cards on
    one cleanup task). Never a next-step box (the chat's own next step) or a default it already went on with."""
    q = q or {}
    if not task or not q.get('project_asked') or q.get('kind') == 'next-step' or went_on(q):
        return ''
    qp, tp = q.get('project'), task.get('project')
    if qp not in NO_PROJECT and tp not in NO_PROJECT and qp != tp:
        return f"it is work in {qp}, not this task's {tp}"
    return ''


def too_big_idle(q, size, idle):
    """Why this session should not carry the answer itself for its size ('' when it should)."""
    q = q or {}
    if q.get('kind') != 'next-step' and not went_on(q) and size and size >= BIG_CONTEXT and idle is not None \
            and idle >= COLD_AFTER:
        return (f"this session holds {size // 1000}k tokens and sat idle {int(idle // 60)} min, so it would resume "
                f"from a summary; a fresh one starts clean and costs less")
    return ''


def switch_line(q):
    """When the asker already went on with its default and he picked otherwise: who changes course."""
    if q.get('default_answer') and not q.get('matched_default') and not q.get('blocking'):
        return (f"The asking session already went on with {q['default_answer']!r}; he picked {q['answer']!r}, so the "
                f"fresh session switches it.")
    return ''


def session_size(sid=None):
    """(context tokens of the last main-thread model call, seconds since it) of this Claude Code session, from its
    transcript; (None, None) when unknown (not in Claude Code, transcript not found)."""
    path = _transcript_of(sid or os.environ.get('CLAUDE_CODE_SESSION_ID'))
    if not path:
        return None, None
    try:
        with open(path, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4 * 1024 * 1024))  # the tail holds the last call; transcripts reach many MB
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except OSError:
        return None, None
    for raw in reversed(lines):
        ev = _main_call(raw) if '"usage"' in raw else None
        if not ev:
            continue
        u = (ev.get('message') or {}).get('usage') or {}
        size = sum(u.get(k) or 0 for k in ('input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens'))
        if not size:
            continue
        try:
            at = datetime.datetime.fromisoformat(ev['timestamp'].replace('Z', '+00:00')).timestamp()
        except (KeyError, ValueError, AttributeError):
            at = os.path.getmtime(path)
        return size, max(0.0, time.time() - at)
    return None, None


def _transcript_of(sid):
    """The transcript file of a Claude Code session id, or None."""
    if not sid:
        return None
    base = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(os.path.expanduser('~'), '.claude')
    root = os.path.join(base, 'projects')
    try:
        return next((os.path.join(root, d, sid + '.jsonl') for d in os.listdir(root)
                     if os.path.isfile(os.path.join(root, d, sid + '.jsonl'))), None)
    except OSError:
        return None


def _main_call(raw):
    """A transcript line that is a main-thread model call with a usage dict, parsed; else None."""
    try:
        ev = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(ev, dict) or ev.get('type') != 'assistant' or ev.get('isSidechain'):
        return None
    return ev if isinstance((ev.get('message') or {}).get('usage') or {}, dict) else None


def hand_off_why(q, task, size=None, idle=None):
    """Why a fresh session should carry out this answer instead of the asking one ('' = the asking one does)."""
    return other_work(q, task) or too_big_idle(q, size, idle)


def handed(q, why):
    """What `tasks wait` prints when it lets the answer go to a fresh session."""
    t = q.get('task_id')
    out = [f"?{q['id']} answered: {q['answer']}"]
    if q.get('answer_note'):
        out.append(f"note: {q['answer_note']}")
    out.append(f"Handed to a fresh session, because {why}. Do not carry it out here.")
    switch = switch_line(q)
    if switch:
        out.append(switch + ' Stop work that depends on your default; leave the switch to it.')
    if t:
        out.append(f"It starts shortly with task #{t}, its notes and the card. If it needs something only "
                   f"you know (branch or worktree, files, what you ruled out, how to check), add it now: tasks note {t} \"…\"")
    return '\n'.join(out)


def said(q):
    """What `tasks wait` prints once he has answered: the answer first, then how it relates to
    what the agent assumed."""
    out = [f"?{q['id']} answered: {q['answer']}"]
    if q.get('answer_note'):
        out.append(f"note: {q['answer_note']}")
    if q.get('default_answer'):
        out.append('(your default)' if q.get('matched_default') else f"(not your default: you went on with {q['default_answer']!r}; change course)")
    if q.get('standing'):
        out.append('He marked it a standing rule: answer this kind the same way from now on, without asking.')
    # the desktop app keeps the last next-step box until a new one replaces it (2026-11-22: he saw his answered
    # question asked again after this session acted on the page answer)
    out.append('In the desktop app, end the turn that acts on this with the next-step box (wrap_up) so the old '
               'question disappears.')
    return '\n'.join(out)


def project_of(cwd):
    """The project of a hook event's folder (its repo), else personal."""
    if not cwd or not os.path.isdir(cwd):
        return 'personal'
    here = os.getcwd()
    try:
        os.chdir(cwd)
        return current_project()
    finally:
        os.chdir(here)


# The app's next-step box (Claude Code desktop): a question and 1-2 buttons as plain fields, so it is copied to
# http://beacon/decisions as it is, buttons = options, the first = the default (2026-11-22: "když mi zobrazíš
# tohle, tak to musí jít poznat"). A button click comes back as his next prompt with the label as its text.
BOX_TOOL = 'mcp__ccd_turn__wrap_up'
ASK_CMD = re.compile(r'(^|[;&|\n(]|\$\()\s*(\S*/)?tasks\s+ask\b')
LEFT_CMD = re.compile(r'(^|[;&|\n(]|\$\()\s*(\S*/)?tasks\s+(note|handoff|add|ask|done)\b')  # what is left, written down


APP_ACTIONS = {'commit': 'Commit', 'create_pr': 'Open a pull request', 'merge': 'Merge', 'fix_ci': 'Fix the CI',
               'address_comments': 'Address the comments', 'resolve_conflicts': 'Resolve conflicts',
               'verify': 'Verify it', 'archive': 'Archive the session', 'new_session': 'New session'}


def quick(path, body=None, timeout=3):
    """One try with a short timeout, for hooks: a hub that is down must never hold a session (call() retries
    for over a minute). Raises on any failure; the hook swallows it."""
    headers = {'Accept': 'application/json'}
    data = None
    if body is not None:
        headers['Content-Type'] = 'application/json'
        data = json.dumps(body).encode()
        t = token()
        if t:
            headers['Authorization'] = 'Bearer ' + t
    req = urllib.request.Request(URL + path, data=data, headers=headers, method='POST' if data is not None else 'GET')
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


ASK_MAX = 120  # a decision card's title: the question only, the details go in the context as bullets


def box_file(sid):
    return os.path.join(os.path.expanduser('~/.cache/tasks-hook'), f'{sid}.box')


def read_box(sid):
    try:
        with open(box_file(sid)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def hook_box(ev):
    """PostToolUse on the next-step box: a question the box showed is filed at http://beacon/decisions, unless a
    `tasks ask` already ran this turn (it is there already). Not tied to the task: an answer on a task
    goes to the task agent, while this session is still working it (the task is named in the context)."""
    inp = ev.get('tool_input') or {}
    ask, sid = str(inp.get('ask') or '').strip(), ev.get('session_id')
    if not ask or not sid or hooks_off():
        return
    if not _box_shown(ev.get('tool_response')):
        return  # the app dropped the question (an app action no longer available): he never saw it
    labels = _box_labels(_box_actions(inp))
    asked_now = task_touched_this_turn(ev.get('transcript_path'), ASK_CMD, unknown=False)
    same = open_question_for_box(sid, ask, labels, asked_now)
    if not same and asked_now:
        return  # `tasks ask` ran this turn: it is on the page already
    if same:  # the box shows a question already on the page: a button answers that one, nothing is filed twice
        _write_box(sid, same['id'], labels)
        return
    q = quick('/api/questions', _box_card(ev, inp, ask, sid, labels))
    old = read_box(sid)
    if old and old.get('id') != q['id']:  # asked again before he answered: the newer box replaces it
        try:
            quick(f"/api/questions/{old['id']}/withdraw", {'note': 'asked again in a newer next-step box'})
        except Exception:
            pass  # already answered or the hub is away: leave it
    _write_box(sid, q['id'], labels)


def _box_shown(res):
    """The tool's answer says the box was shown (no answer at all counts as shown)."""
    res = json.dumps(res) if res is not None and not isinstance(res, str) else (res or '')
    return not res or 'shown in the next-step box' in res.lower()


def _box_actions(inp):
    """The box's buttons as a list; a JSON string is parsed, anything else is no buttons."""
    actions = inp.get('actions') or []
    if isinstance(actions, str):
        try:
            actions = json.loads(actions)
        except ValueError:
            actions = []
    return actions if isinstance(actions, list) else []


def _box_labels(actions):
    """Each button's label once (case-insensitive); an app action shows under its app name."""
    labels = []
    for a in actions:
        if isinstance(a, dict):
            label = a.get('label') if not a.get('action') else APP_ACTIONS.get(a['action'], a['action'].replace('_', ' ').capitalize())
        else:
            label = a
        label = str(label or '').strip()[:200]
        if label and label.lower() not in (x.lower() for x in labels):
            labels.append(label)
    return labels


def _write_box(sid, qid, labels):
    os.makedirs(os.path.dirname(box_file(sid)), exist_ok=True)
    with open(box_file(sid), 'w') as f:
        json.dump({'id': qid, 'labels': labels}, f)


def _box_card(ev, inp, ask, sid, labels):
    """The decision card a box question files: headed by the task this session is doing, if any."""
    linked = quick('/api/tasks?' + urllib.parse.urlencode({'session': f'Claude Code:{sid}', 'limit': 50}))['tasks']
    # the card heads with this task's title (the page drops the id); a hub-filed "Decide: …" holder names nothing
    # (2026-11-23, ?333 read "Decide: Click Yes on the Windows admin prompt…": "which project is this?")
    doing = [f"#{t['id']} {t['title']}" for t in linked if t['status'] == 'doing' and not t['title'].startswith('Decide:')]
    recap = str(inp.get('recap') or '').strip()
    context = '\n\n'.join(x for x in (recap, ('Task: ' + '; '.join(doing)) if doing else '',
                                       "_Asked in the session's next-step box._") if x)
    return {
        'question': ask[:400], 'options': labels[:8], 'kind': 'next-step', 'project': project_of(ev.get('cwd')),
        'context': context, 'see': [{'url': u} for u in links_in(ask + '\n' + recap)[:4]],
        'session_id': f'Claude Code:{sid}', 'asked_by': f'Claude Code {sid[:8]}',
        'source': f"box:{sid}:{ev.get('tool_use_id') or ask[:80]}"}


def norm(text):
    return re.sub(r'\s+', ' ', str(text or '')).strip().rstrip('?').strip().casefold()


GENERIC = {'yes', 'no', 'ano', 'ne', 'ok', 'go ahead', 'do it', 'udělej to', 'not now', 'later', 'skip', 'done',
           'hotovo', 'cancel', 'approve', 'keep', 'stop', 'try again', 'not needed'}


def same_question(q, ask, labels):
    """The box shows question q: the same buttons, when they say what they do ("Finish it" / "Stop at what is
    done", in any language of the question). Buttons any question has (Yes / No) also need the question's words:
    "Merge PR #12?" and "Deploy to prod?" both offer Yes / No, and a tap on one must never answer the other."""
    want = sorted(norm(x) for x in labels)
    if not want or sorted(norm(x) for x in option_labels(q)) != want:
        return False
    if not all(x in GENERIC for x in want):
        return True
    wa, wb = (set(re.findall(r'\w{3,}', norm(x))) for x in (q['question'], ask))
    return bool(wa and wb) and len(wa & wb) / min(len(wa), len(wb)) >= 0.6


def option_labels(q):
    return [str(o.get('label') if isinstance(o, dict) else o).strip() for o in q.get('options') or []]


def open_question_for_box(sid, ask, labels, asked_now=False):
    """The open question of this session the box shows, if it is one already on http://beacon/decisions: same text, or
    the same buttons; or, after a `tasks ask` this turn, the newest one. None means a new question."""
    rows = [q for q in quick('/api/questions?' + urllib.parse.urlencode({'status': 'open', 'limit': 500}),
                             timeout=2)['questions'] if q.get('session_id') == f'Claude Code:{sid}']
    for q in rows:
        if norm(q['question']) == norm(ask):
            return q
    for q in rows:
        if same_question(q, ask, labels):
            return q
    if asked_now and rows:
        return max(rows, key=lambda q: q.get('created_at') or 0)
    return None


def box_answer(sid, prompt):
    """His next prompt after a box question. A button's label answers it on the page (via chat). An answer
    he gave on the page meanwhile, or a typed reply, is handed to the session to settle. One prompt
    settles the box either way."""
    box = read_box(sid)
    if not box:
        return None
    try:
        os.remove(box_file(sid))
    except OSError:
        pass
    q = quick(f"/api/questions/{box['id']}", timeout=2)
    if q['status'] == 'answered' and q.get('answered_via') != 'chat':
        won = ((not q.get('applied_at') and quick(f"/api/questions/{box['id']}/claim", {'by': chat_claimer(sid)}, timeout=2).get('won'))
               or q.get('taken_by') == chat_claimer(sid))
        if not won:  # answer-dispatcher took it meanwhile (task 1776): a fork of this session or a fresh run did it
            return (f"He answered the next-step box question ?{q['id']} on the decisions page ({q['answer']}) and "
                    f"answer-dispatcher already carried it out in another run" + (f" (see task #{q['task_id']})" if q.get('task_id') else '')
                    + ": check its result there, do not repeat it.")
        note = f" (note: {q['answer_note']})" if q.get('answer_note') else ''
        return f"He answered the next-step box question ?{q['id']} on the decisions page: {q['answer']}{note}. Act on that."
    if q['status'] != 'open':
        return None
    pick = next((x for x in box.get('labels') or [] if x.casefold() == prompt.strip().casefold()), None)
    if pick:
        quick(f"/api/questions/{box['id']}/answer", {'answer': pick, 'via': 'chat'}, timeout=2)
        return None
    return (f"Your next-step box question ?{q['id']} ({q['question']}) is still open on the decisions page. If this "
            f"prompt answers it, log it: `tasks answer {q['id']} \"<his words>\" --chat`; if it makes it moot: "
            f"`tasks withdraw {q['id']} -m \"<why>\"`; otherwise leave it.")


def chat_claimer(sid):
    """Who the prompt hook claims as: its own mark, so an answer it won but never handed in is found again."""
    return f'Claude Code:{sid} (chat)'


def own_answers(sid):
    """What this open chat must know when he next types here (task 1884): an answer to one of its own questions
    that nobody took yet is claimed and handed to it; one answer-dispatcher already carried out in another run
    (a fork of this session or a fresh run) is named once, so it is never redone or undone."""
    rows = quick('/api/questions?' + urllib.parse.urlencode({'status': 'answered', 'limit': 300}), timeout=2)['questions']
    mine = [q for q in rows if q.get('session_id') == f'Claude Code:{sid}' and q.get('kind') != 'ending'
            and q.get('answered_via') != 'chat' and not q.get('handoff_at') and time.time() - (q.get('answered_at') or 0) < 3 * 86400]
    told_file = os.path.join(os.path.expanduser('~/.cache/tasks-hook'), f'{sid}.told')
    try:
        with open(told_file) as f:
            told = set(json.load(f))
    except (OSError, ValueError):
        told = set()
    lines = []
    for q in mine:
        if q['id'] in told:
            continue
        try:
            line = _answer_for_chat(q, sid)
        except _HubSlow:
            break  # what was won so far is still handed in; the rest next prompt
        if line:
            lines.append(line)
            told.add(q['id'])
    if lines:
        os.makedirs(os.path.dirname(told_file), exist_ok=True)
        with open(told_file, 'w') as f:
            json.dump(sorted(told), f)
    return '\n\n'.join(lines)


class _HubSlow(Exception):
    """The hub did not answer a claim in time."""


def _answer_for_chat(q, sid):
    """What this chat is told about one answered question of its own, or None (nothing, or not yet)."""
    if not q.get('applied_at'):
        return _claim_for_chat(q, sid)
    if q.get('taken_by') == chat_claimer(sid):  # won here, but the hook died before it was handed in
        return said(q)
    if q.get('taken_by') == DISPATCHER_NAME:
        return (f"?{q['id']} ({q['question'][:80]}): he answered {q['answer']!r} and answer-dispatcher already "
                f"carried it out in another run" + (f" (its result is a note on task #{q['task_id']})" if q.get('task_id') else '')
                + ": check it, do not repeat or undo it.")
    return None


def _claim_for_chat(q, sid):
    """An answer nobody carried out yet: claimed for this chat and handed in, unless it is other work the asker
    named (the dispatcher's fresh run does that) or the dispatcher took it this second."""
    if q.get('project_asked') and q.get('task_id'):
        try:
            if other_work(q, quick(f"/api/tasks/{q['task_id']}", timeout=2)):
                return None
        except Exception:  # noqa: BLE001 - unsure: leave it to the dispatcher, which routes it
            return None
    try:
        won = quick(f"/api/questions/{q['id']}/claim", {'by': chat_claimer(sid)}, timeout=2).get('won')
    except Exception as e:  # noqa: BLE001 - hub slow
        raise _HubSlow from e
    return said(q) if won else None


def chat_questions(ev):
    """The questions of an AskUserQuestion call, each with its button labels."""
    out = []
    for q in (ev.get('tool_input') or {}).get('questions') or []:
        labels = [str(o.get('label', ''))[:200] for o in q.get('options') or [] if o.get('label')][:8]
        if q.get('question'):
            out.append((q, labels))
    return out


def chat_card_source(ev, i):
    return f"chat:{ev.get('session_id')}:{ev.get('tool_use_id') or ''}:{i}"


def hook_ask_shown(ev):
    """PreToolUse on AskUserQuestion: the buttons he sees in the chat are on http://beacon/decisions at the same moment,
    so he can answer in either place (he said so 2026-11-24: buttons in the app, and the page, both). A card a
    `tasks ask` already filed for the same question is reused, never doubled."""
    sid = ev.get('session_id')
    if not sid or hooks_off():
        return
    for i, (q, labels) in enumerate(chat_questions(ev)):
        if open_question_for_box(sid, q['question'], labels):
            continue
        quick('/api/questions', {
            'question': q['question'][:400], 'kind': q.get('header') or 'chat', 'project': project_of(ev.get('cwd')),
            'options': chat_options(q),
            'context': "_Asked with buttons in the chat; answer here or there._",
            'session_id': f'Claude Code:{sid}', 'asked_by': f'Claude Code {sid[:8]}',
            'source': chat_card_source(ev, i)})


def chat_options(q):
    return [{'label': o.get('label', '')[:200], 'detail': (o.get('description') or '')[:1000]}
            for o in q.get('options') or [] if o.get('label')][:8]


def _answer_note(notes, text):
    """The note he typed with his answer to `text`, from the tool's annotations."""
    note = notes.get(text) if isinstance(notes, dict) else None
    return (note or {}).get('notes') if isinstance(note, dict) else None


def hook_ask_answered(ev):
    """PostToolUse on AskUserQuestion: each answer settles the card its buttons were mirrored to, or is logged
    as a new answered card when none was filed."""
    res = ev.get('tool_response') or {}
    if isinstance(res, str):
        res = {'answers': dict(re.findall(r'"([^"]+)"="([^"]*)"', res))}
    answers = res.get('answers') or {}
    notes = res.get('annotations') or {}
    project = project_of(ev.get('cwd'))
    sid = ev.get('session_id')
    for i, (q, labels) in enumerate(chat_questions(ev)):
        text = q['question']
        if not answers.get(text):
            continue
        note = _answer_note(notes, text)
        card = open_question_for_box(sid, text, labels) if sid else None
        if card:  # the card the buttons were mirrored to: the chat answer settles it
            quick(f"/api/questions/{card['id']}/answer", {'answer': answers[text], 'note': note, 'via': 'chat'}, timeout=5)
            continue
        call('/api/questions', {
            'question': text[:400], 'kind': q.get('header') or 'chat', 'options': chat_options(q),
            'answer': answers[text], 'note': note, 'via': 'chat', 'project': project,
            'session_id': f'Claude Code:{sid}' if sid else None,
            'asked_by': f'Claude Code {sid[:8]}' if sid else 'chat',
            'source': chat_card_source(ev, i) if sid else None,
        })


def hook_ask(stdin):
    """AskUserQuestion: shown (PreToolUse) files its card; answered (PostToolUse) answers that card, or logs a new
    answered one when none was filed. On the next-step box: file its question (hook_box). Never fails the tool."""
    try:
        ev = json.load(stdin)
        if manual_here():
            return  # outside Beacon: what he answers in the chat stays in the chat
        if ev.get('tool_name') == BOX_TOOL:
            hook_box(ev)
            return
        if ev.get('hook_event_name') == 'PreToolUse':
            hook_ask_shown(ev)
            return
        hook_ask_answered(ev)
    except SystemExit:
        pass
    except Exception as e:  # a broken log must never break the session
        print(f'tasks hook-ask: {e}', file=sys.stderr)


def last_reply(path):
    """The text of the session's last assistant message, from its transcript (JSON lines)."""
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.readlines()[-200:]
    except (OSError, TypeError):
        return ''
    for raw in reversed(lines):
        try:
            m = json.loads(raw)
        except ValueError:
            continue
        if m.get('type') != 'assistant':
            continue
        content = (m.get('message') or {}).get('content')
        text = content if isinstance(content, str) else '\n'.join(
            c.get('text', '') for c in content or [] if isinstance(c, dict) and c.get('type') == 'text')
        if text.strip():
            return text
    return ''


def hooks_off():
    """The task hooks are for sessions he talks to (the app, the web, a terminal), never for a one-shot
    `claude -p` an automation runs (answer-dispatcher, Hermes jobs): there a block rewrites the output
    that goes to his phone. Those sessions look like `claude -p "…"`; his app and Remote Control
    sessions also run --print, but with --input-format stream-json. TASKS_HOOKS=0/1 forces it."""
    force = os.environ.get('TASKS_HOOKS')
    if force in ('0', '1'):
        return force == '0'
    pid = os.getppid()
    for _ in range(5):
        try:
            out = subprocess.run(['ps', '-o', 'ppid=', '-o', 'args=', '-p', str(pid)],
                                 capture_output=True, text=True, timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return False
        if not out:
            return False
        ppid, _, args = out.partition(' ')
        argv = args.split()
        if argv and 'claude' in argv[0]:
            return ('-p' in argv or '--print' in argv) and 'stream-json' not in argv
        try:
            pid = int(ppid)
        except ValueError:
            return False
        if pid <= 1:
            return False
    return False


# A reply that ends by offering more work ("Mám to předělat?", "Shall I fix it?"). 2026-11-21: an offer
# went out with no task behind it, against "every later step is a task filed before the reply".
OFFER = re.compile(r'(^|[\s*_>"„(])(m[aá]m\b|chce[sš],? abych|nem[aá]m\b|shall i\b|should i\b|want me to\b|'
                   r'do you want me\b|let me know if you want me)', re.I)
TASK_CMD = re.compile(r'(^|[;&|\n(]|\$\()\s*(\S*/)?tasks\s+(add|note|doing|set|ask|done|handoff|answer|withdraw)\b')


# A first-person promise anywhere in the reply ("once it's online, I'll point the logger at it", "až to bude, pustím
# to"): task #1652, missed 5x in 24 h (2026-11-17) and again 2026-11-21 (Shelly plug). Matched without diacritics.
PROMISE = re.compile(r"\b(i'll|i will|i'm going to|i am going to|we'll|budu|udelam|dodelam|predelam|opravim|"
                     r"zkontroluj[iu]|overim|otestuj[iu]|pustim|spustim|nasadim|pripravim|nastavim|pridam|poslu|"
                     r"napisu|ozvu se|podivam se|mrknu|zarid[im]|dam (ti )?vedet|pohlidam|hlidam)\b", re.I)
QUOTED = re.compile(r'`[^`]*`|„[^“”]*[“”]|"[^"\n]*"|```.*?```', re.S)


def offers_work(reply):
    """The reply's last paragraph asks to do something, or the reply promises something for later."""
    import unicodedata
    text = QUOTED.sub(' ', reply or '')  # quoted examples and commands are not promises
    paras = [p.strip() for p in text.strip().split('\n\n') if p.strip()]
    tail = paras[-1] if paras else ''
    if any(OFFER.search(s) for s in re.findall(r'[^.!?\n]*\?', tail)):
        return True
    plain = ''.join(c for c in unicodedata.normalize('NFKD', text) if not unicodedata.combining(c))
    return bool(PROMISE.search(plain))


# A plan he carries out himself, left only in a chat (task 1891): "I want to make an anonymous Pinterest account"
# got a 5-step how-to and a ✅, and the idea died with the session (2026-11-23: "my ideas always get stuck in the
# first phase"). A list item that starts with an order (EN, or a Czech imperative stem), after its emoji and bold.
STEP_ITEM = re.compile(r'^\s*(?:\d{1,2}[.)]|[-*•])\s+(.+)$')
DO_EN = frozenset((
    'reset wipe turn make create sign pick choose open go tap click press install download buy order pay post upload set '
    'switch use add write send call ask find get log register enter type copy paste connect plug unplug restart reboot '
    'delete remove skip start try put take leave keep save check verify record film follow join book print wait visit '
    'read watch fill submit publish share reply email text message schedule move rename compare test draft prepare '
    'apply upgrade update enable disable allow accept confirm grab bring charge never don\'t do avoid stop give tell '
    'cancel claim link unlink scan photograph shoot export import back sync name label tag drop hold insert'
).split())
DO_CS = re.compile(r'^(otev[řr]|klikn|kliknu|vytvo[řr]|nastav|zapn|vypn|po[šs]l|st[áa]hn|nainstaluj|p[řr]ihla[sš]|'
                   r'zaregistruj|ud[ěe]lej|vyber|zkus|napi[šs]|zavolej|kup|zapla[ťt]|nahraj|zkop[íi]ruj|vlo[žz]|'
                   r'restartuj|odpoj|p[řr]ipoj|jdi|dej|vezmi|ulo[žz]|sma[žz]|zkontroluj|ov[ěe][řr]|po[čc]kej|spus[ťt]|'
                   r'vypl[ňn]|ode[šs]li|potvr[ďd]|zvol|pou[žz]ij|nikdy|nepou[žz][íi]vej|neklikej|resetuj|vyma[žz]|'
                   r'p[řr]epni|zadej|naskenuj|vyfo[ťt]|natoč|sd[íi]lej|zve[řr]ejni|po[žz][áa]dej)', re.I)


def hands_plan(reply):
    """How many list items of the reply are orders for him to carry out ("1. 📱 **Reset the spare phone**")."""
    import unicodedata
    n = 0
    for line in QUOTED.sub(' ', reply or '').splitlines():
        m = STEP_ITEM.match(line)
        if not m:
            continue
        t = plain(m.group(1))
        t = ''.join(c for c in t if not unicodedata.category(c).startswith('S') and c != '️').strip(' :-–')
        word = (re.match(r"[^\W\d_][\w']*", t) or [''])[0]
        if word.lower() in DO_EN or DO_CS.match(word):
            n += 1
    return n


PLAN_MIN = 3  # orders in one reply that make it a plan for him, not advice


def plan_reason(steps):
    """The Stop hook's send-back for a plan he carries out that lives only in this chat."""
    return (f'Your reply hands him a plan to carry out ({steps} steps), but only this chat holds it: he loses the chat '
            'and the idea never gets done (2026-11-23: "my ideas always get stuck in the first phase"). Run, in order:\n'
            '1. `tasks add "<the outcome he gets>" --doing -b -` with ## Goal, ## Done-test, ## Steps: the whole plan, '
            f'each step 🤖 agent or 👤 {settings.OWNER_NAME}\n'
            '2. every 🤖 step you can do now (look it up, draft it, set it up)\n'
            '3. `tasks ask "<his next step, one plain line>" --task ID -o "Done" --step "<what he taps> :: <exact link>" '
            '--step "…"`: only his next 1-3 👤 steps; open each link first\n'
            'Then end with one line in the language of your reply: "❓ <his next step>" (he already read the rest). '
            'Not steps for him after all (what you did, options to pick from, an example)? End with no text.')


def his_message(m, content):
    """A transcript line that is his own message (the start of the turn), not a tool result, a meta line or a
    background notification (task, Monitor, agent completion), which arrive as user text too."""
    if m.get('isMeta'):
        return False
    if isinstance(content, str):
        text = content
    elif any(isinstance(c, dict) and c.get('type') == 'text' for c in content or []):
        if 'tool_result' in json.dumps(content)[:200]:
            return False
        text = ' '.join(c.get('text', '') for c in content if isinstance(c, dict) and c.get('type') == 'text')
    else:
        return False
    head = text.lstrip()[:300]
    return not (head.startswith('<task-notification') or '[SYSTEM NOTIFICATION' in head
                or head.startswith('<system-reminder>') or head.startswith('Stop hook feedback'))


def task_touched_this_turn(path, pattern=TASK_CMD, unknown=True):
    """A `tasks add/note/doing/set/ask/done` command (or `pattern`) ran since his last message (transcript,
    JSON lines). `unknown`: the answer when the transcript can't be read."""
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.readlines()[-3000:]
    except (OSError, TypeError):
        return unknown  # by default: can't tell, never block on a guess
    for raw in reversed(lines):
        try:
            m = json.loads(raw)
        except ValueError:
            continue
        content = (m.get('message') or {}).get('content')
        if m.get('type') == 'user':
            if his_message(m, content):
                return False  # reached his message without a task command after it
            continue
        if m.get('type') == 'assistant':
            for c in content or []:
                cmd = (c.get('input') or {}).get('command') if isinstance(c, dict) and c.get('type') == 'tool_use' else None
                if isinstance(cmd, str) and pattern.search(cmd):  # a shell command, not text that mentions one
                    return True
    return False


def box_filed(sid):
    """A next-step box question is on http://beacon/decisions and he has not written since (hook-ask wrote the .box
    file after filing it; his next prompt removes it). A box the app dropped, or a hub that was down, leaves none."""
    return bool(sid) and os.path.exists(box_file(sid))


def last_box(path):
    """(time, ask) of the last next-step box this session showed, from its transcript; None if none."""
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.readlines()[-3000:]
    except (OSError, TypeError):
        return None
    for raw in reversed(lines):
        try:
            m = json.loads(raw)
        except ValueError:
            continue
        use = _box_use(m) if m.get('type') == 'assistant' else None
        if use:
            return _box_seen(m, use)
    return None


def _box_use(m):
    """The last next-step box call in an assistant message, else None."""
    return next((c for c in reversed((m.get('message') or {}).get('content') or [])
                 if isinstance(c, dict) and c.get('type') == 'tool_use' and c.get('name') == BOX_TOOL), None)


def _box_seen(m, use):
    """(time, ask, labels of its own buttons) of a box call; None when its message has no readable time."""
    try:
        ts = datetime.datetime.fromisoformat(str(m.get('timestamp')).replace('Z', '+00:00')).timestamp()
    except ValueError:
        return None
    inp = use.get('input') or {}
    labels = [str(a.get('label') or '') if isinstance(a, dict) else str(a) for a in _box_actions(inp)
              if not (isinstance(a, dict) and a.get('action'))]
    return ts, str(inp.get('ask') or '').strip(), labels


def unshown_question(path, sid):
    """An open question of this session that the next-step box does not show (2026-11-22: "shouldn't
    this be a question right here and on the web too?"): he must be able to answer it in the chat as well.
    The oldest one, else None."""
    rows = [q for q in quick('/api/questions?' + urllib.parse.urlencode({'status': 'open', 'limit': 500}),
                             timeout=2)['questions'] if q.get('session_id') == f'Claude Code:{sid}']
    box = last_box(path)
    if not rows or not box:  # no box in this session (a terminal, `claude -p`): the page is the only place
        return None
    if box[1]:
        want = sorted(norm(x) for x in box[2])  # loose on purpose: a wrong match here costs one reminder, never an answer
        if any(norm(q['question']) == norm(box[1]) or (want and sorted(norm(x) for x in option_labels(q)) == want)
               for q in rows):
            return None
    return min(rows, key=lambda q: q.get('created_at') or 0)


def stale_box(path, sid):
    """The app still shows a next-step box question he has since answered on the page (2026-11-22: "once
    I answer, it must never show again"). The box stays until the next box replaces it. Returns the answered
    question, else None."""
    box = last_box(path)
    if not box or not box[1]:
        return None
    rows = quick('/api/questions?' + urllib.parse.urlencode({'status': 'answered', 'limit': 300}), timeout=2)['questions']
    hits = [q for q in rows if q.get('session_id') == f'Claude Code:{sid}' and (q.get('answered_at') or 0) > box[0]
            and q.get('answered_via') != 'chat' and q.get('kind') != 'ending']
    return hits[0] if hits else None


def left_open_reason(reply, linked, path, sid=None):
    """Land the plane (2026-11-22: sessions are disposable, he does not read them): a reply that starts
    with ⚠️ (work is left) or ❓ (he must decide) ends only once that is in a task or on http://beacon/decisions.
    None when it already is."""
    head = reply.lstrip()
    linked = [t for t in linked if 'decision' not in (t.get('tags') or [])]  # the hub filed it to hold a question only
    if head.startswith('❓'):  # with or without a task: a question left only in a chat became a bare card (2026-11-22)
        if task_touched_this_turn(path, ASK_CMD) or box_filed(sid):
            return None
        return ('Your reply starts with ❓, but the question is not on http://beacon/decisions, and he decides there, not '
                'in sessions he may never open. File it: `tasks ask "<the question>" -o "<your pick> :: why" -o '
                '"<other>" [--task ID]` (add --blocking only when there is no safe default). Run the command only, '
                'then end with no text: he already read your reply.')
    if not linked or not head.startswith('⚠'):  # a chat, not work: no task to land in ("not checked")
        return None
    if task_touched_this_turn(path, LEFT_CMD):
        return None
    mine = [t for t in linked if t['status'] in ('doing', 'todo') and not handed_off(t)]
    out = ["Your reply starts with ⚠️, so work is left, but nothing was written to a task this turn. Sessions are "
           "disposable and he does not read them: what is left must live in a task, or nobody does it. Run ONE:",
           '- agent work that nobody is running now: `tasks handoff ID "<the next step, concrete>"` (the task '
           'agent continues it; a task tagged auto still waits for his OK)',
           '- already running somewhere (a queued build, another session) or waiting on his hands: '
           '`tasks note ID "<what is left, who does it, when>"`',
           '- his decision: `tasks ask "<question>" -o "<your pick> :: why" -o "<other>" --task ID`',
           '- no task fits: `tasks add "<outcome>" -b -` with ## Goal, ## Done-test, ## Steps (the template); '
           'add `-t auto` when it is your idea, not his ask']
    if mine:
        out.append("This session's open tasks:")
        out += [f"  #{t['id']} ({t['status']}) {t['title']}" for t in mine]
    out.append('Run the command only, then end with no text: he already read your reply. If nothing is in fact '
               'left for anyone, end with one line that starts with ✅ instead.')
    return '\n'.join(out)


def handed_off(t):
    """Queued for the task agent (his go-ahead on a todo task): no longer this session's to close or note."""
    return t['status'] == 'todo' and 'claude' in (t.get('tags') or [])


# ------------------------------------------------------------ endings (task 1857)
# Every reply's first line (✅ done / ⚠️ stuck / ❓ needs you) and its suggested next step become one card per
# session in the feed on http://beacon/decisions, so he never opens a session to learn what it did.
NEXT_LEAD = re.compile(r'^(?:[-*>#\s]|👉|➡️?|→|\*\*)*(?:(?:the\s+)?next(?:\s+step)?|další\s+krok|teď|now)\s*[:：-]\s*', re.I)
GO_LABEL = 'Go ahead'  # a done/stuck card's button when the agent gave a next step but no buttons of its own


def plain(line):
    """A markdown line as he reads it: no bold, code ticks, link syntax or list marks."""
    t = re.sub(r'\[([^\]]+)\]\([^)]*\)', r'\1', line or '')
    t = re.sub(r'[*_`]{1,3}', '', t)
    return ' '.join(t.lstrip('-•>#').split())


def ending_of(reply, box=None):
    """(first line, next step, button labels) of a final reply; None for an empty one."""
    lines = [x.strip() for x in (reply or '').splitlines() if x.strip() and not x.strip().startswith('```')]
    if not lines:
        return None
    first = plain(lines[0])
    nxt = _next_step(lines, first)
    labels = [x for x in (box or [])[:2] if x]
    if not labels and nxt:
        labels = [GO_LABEL]
    return first, nxt, labels


def _ending_wanted(ev, reply):
    if not ev.get('session_id') or os.environ.get('TASKS_HOOKS') == '0':  # a hook's own helper run (naming, the backstop)
        return False
    if ev.get('stop_hook_active') and not (reply or '').lstrip().lstrip('*_ ').startswith(('✅', '⚠', '❓')):
        return False  # the answer to a block ("Filed."): the card keeps the reply he read
    # an automation's `claude -p` reports its own way; answer-dispatcher's runs set BEACON_ENDINGS=1
    return not hooks_off() or os.environ.get('BEACON_ENDINGS') == '1'


def _next_step(lines, first):
    """The reply's last line as its next step, unless it is the only line, repeats the first or is a table row."""
    if len(lines) < 2:
        return None
    last = plain(lines[-1])
    if not last or last == first or last.startswith('|'):
        return None
    return NEXT_LEAD.sub('', last).strip() or None


def post_ending(ev, reply):
    """The Stop hook's first step, before anything may return early: this reply, as its session's card.
    One short try; a hub that is down loses one card (the nightly backstop finds it), never the session."""
    sid = ev.get('session_id')
    if not _ending_wanted(ev, reply):
        return
    path = ev.get('transcript_path')
    box = last_box(path)
    fresh_box = box[2] if box and time.time() - box[0] < 900 and not box[1] else None
    got = ending_of(reply, fresh_box)
    if not got:
        return  # "end with no text" after a block: the card keeps the reply he already has
    first, nxt, labels = got
    cwd = ev.get('cwd') or os.getcwd()
    try:
        names = log_titles(path, 64 * 1024) if path else []
    except Exception:  # noqa: BLE001
        names = []
    quick('/api/endings', {
        'session_id': f'Claude Code:{sid}', 'line': first, 'next': nxt, 'actions': labels,
        'reply': (reply or '')[:6000], 'project': project_of(cwd), 'cwd': cwd, 'machine': socket_host(),
        'title': names[-1] if names else None, 'agent': 'Claude Code',
    }, timeout=2)


def hook_stop(stdin):
    """Stop hook: a reply that says ✅ (nothing left in this session) while a task this session
    took is still open goes back once: close it, or say what is left. A task it filed and has
    not been reminded of yet is named too. A reply that offers more work with no task command this
    turn goes back once too. Never blocks twice in a row, never fails the session."""
    try:
        ev = json.load(stdin)
        if manual_here():
            return  # outside Beacon: no card, never a reply sent back
        sid = ev.get('session_id')
        reply = ev.get('last_assistant_message') or last_reply(ev.get('transcript_path'))
        try:
            post_ending(ev, reply)
        except Exception as e:  # noqa: BLE001 - the card is a nicety, the session goes on
            print(f'tasks hook-stop: ending not posted: {e}', file=sys.stderr)
        if ev.get('stop_hook_active') or not sid or hooks_off():
            return
        _StopCheck(ev, sid, reply).run()
    except Exception as e:  # a broken hub or hook must never hold a session
        print(f'tasks hook-stop: {e}', file=sys.stderr)


class _StopCheck:
    """One Stop hook's checks on a reply, in order; the first that blocks ends the turn's check. A question the
    next-step box does not show rides along with whichever block goes out (one block per turn: never lose it)."""

    def __init__(self, ev, sid, reply):
        self.sid, self.reply, self.path = sid, reply, ev.get('transcript_path')
        self.wait_note = ''

    def linked_tasks(self):
        q = urllib.parse.urlencode({'session': f'Claude Code:{self.sid}', 'limit': 50})
        with urllib.request.urlopen(f'{URL}/api/tasks?{q}', timeout=2) as r:
            return json.load(r)['tasks']

    def emit(self, reason):
        if self.wait_note:
            reason, self.wait_note = self.wait_note + '\n\n' + reason, ''
        print(json.dumps({'decision': 'block', 'reason': reason}))

    def done(self):
        if self.wait_note:
            self.emit('Run the command only, then end with no text: he already read your reply.')

    def run(self):
        try:
            stale = stale_box(self.path, self.sid)
        except Exception:
            stale = None
        if stale:
            print(json.dumps({'decision': 'block', 'reason': (
                f"He already answered ?{stale['id']} on the decisions page ({stale['answer']}), but the app still shows "
                f"your old next-step box with that question, and he can answer it again. Call the next-step box tool "
                f"(wrap_up) now with a recap of what is true now and NO ask (or the next real question), then end "
                f"with no text.")}))
            return
        # No waiter reminder any more (task 1884): a session with an open question just ends its turn, and
        # answer-dispatcher resumes it when he answers.
        self.wait_note = self.unshown_note()
        head = self.reply.lstrip()
        if head.startswith(('⚠', '❓')):
            why = left_open_reason(self.reply, self.linked_tasks(), self.path, self.sid)
            if why:
                self.emit(why)
            return self.done()  # ⚠️/❓ is stricter than the offer check below
        if self.plan_block() or self.offer_block():
            return None
        if head.startswith('✅'):
            self.open_tasks_block()
        return self.done()

    def unshown_note(self):
        try:
            unshown = unshown_question(self.path, self.sid)
        except Exception:
            unshown = None
        if not unshown:
            return ''
        labels = option_labels(unshown)
        labels.sort(key=lambda x: x != unshown.get('default_answer'))
        return (f"His decision ?{unshown['id']} is open on http://beacon/decisions, but your next-step box does not show "
                f"it, so he can't answer it here in the chat. Call the next-step box tool (wrap_up) now: ask = "
                f"\"{unshown['question'][:100]}\" (that exact wording), buttons with exactly these labels, in this "
                f"order: {json.dumps(labels, ensure_ascii=False)}, and a recap. It is the same question: nothing is "
                f"filed twice.")

    def no_task_in_hand(self):
        """No task command ran this turn and the session works no task of its own ("doing")."""
        return not task_touched_this_turn(self.path) and not any(t['status'] == 'doing' for t in self.linked_tasks())

    def plan_block(self):
        steps = hands_plan(self.reply)
        if steps >= PLAN_MIN and self.no_task_in_hand():
            self.emit(plan_reason(steps))
            return True
        return False

    def offer_block(self):
        """A session working its own task may say what it does next in this session ("once the agents finish,
        I'll merge it"); only one with no task in hand, and no task command this turn, goes back."""
        if offers_work(self.reply) and self.no_task_in_hand():
            self.emit('Your reply offers or promises more work, but no task was filed or noted this turn. Every later '
                      'step is a task before the reply: `tasks add "<outcome>" -b "<what only this session knows + '
                      'done-test>"`, or `tasks note ID "<the step>"` on the task it belongs to. Run the command only: he '
                      'already read your reply, do not repeat or rewrite it, no task talk, end with no text.')
            return True
        return False

    def open_tasks_block(self):
        """A ✅ reply while tasks linked to this session are open: each is named once (the seen file)."""
        linked = self.linked_tasks()
        seen_file = os.path.join(os.path.expanduser('~/.cache/tasks-hook'), self.sid)
        try:
            with open(seen_file) as f:
                seen = set(f.read().split())
        except OSError:
            seen = set()
        # the hub's "Decide:" holder of an open question is not this session's to close: dropping it withdraws his question
        linked = [t for t in linked if 'decision' not in (t.get('tags') or [])]
        doing = [t for t in linked if t['status'] == 'doing' and str(t['id']) not in seen]
        filed = [t for t in linked if t['status'] == 'todo' and str(t['id']) not in seen and not handed_off(t)]
        if not doing and not filed:
            return
        os.makedirs(os.path.dirname(seen_file), exist_ok=True)
        with open(seen_file, 'a') as f:
            f.write(''.join(f"{t['id']}\n" for t in doing + filed))
        self.emit('\n'.join(_open_tasks_lines(doing, filed)))


def _open_tasks_lines(doing, filed):
    out = ['Your reply says ✅, but tasks linked to this session are still open.']
    if doing:
        out.append('Taken by this session (close it: `tasks done ID -m "<result>"`; not finished: '
                   '`tasks note ID "<what is left>"` and reply ⚠️ or ❓ instead of ✅):')
        out += [f"  #{t['id']} {t['title']}" for t in doing]
    if filed:
        out.append('Filed by this session for later: close or drop any this session already did, keep the rest:')
        out += [f"  #{t['id']} {t['title']}" for t in filed]
    out.append('Fix the task with the command only; never close a task whose PR is still open or whose result '
               'is not there. He already read your reply: do not repeat or rewrite it, and no task talk. If your ✅ '
               'was right, end with no text. If work is in fact left, one line in the language of your reply: '
               '"⚠️ <what is left>".')
    return out


# ------------------------------------------------------------ session names (task 1789)
# Every Claude Code session gets a short human name in `claude --resume`, the live page and the usage
# page, instead of its cut-off first prompt. The name is the same `custom-title` line `/rename` and
# `--name` write into the session's log: the title of the task it took (`tasks doing` writes it), else
# 2-5 words Haiku writes once from its first prompts (the Stop hook, in the background). A name he gave
# (`/rename`, `--name`) is never replaced by the hook. Scheduled `claude -p` jobs are named by the
# script that starts them (`--name`); a one-off headless run with no name gets Haiku's, from a smaller
# daily allowance, so an eval batch never uses up the names for the sessions he talks to.
NAMES_DIR = os.path.expanduser('~/.cache/tasks-hook/names')
NAMES_DAILY = int(os.environ.get('TASKS_NAMES_DAILY', '60'))  # Haiku calls a day on this machine, at most
NAMES_DAILY_HEADLESS = int(os.environ.get('TASKS_NAMES_DAILY_HEADLESS', '20'))  # of those, for `claude -p` runs
NAME_TAIL = 48 * 1024  # Claude Code reads a session's name near the end of its log (a re-write costs one short line)
NAME_PROMPT = '''Name this AI coding-agent session for a list of sessions. Below is the project and the
first messages the agent got. Write a title of 2 to 5 words that says what the work is about, in plain
English, sentence case, like a to-do item: "Fix login redirect", "Review gate PR", "Grade code reviews".
No task numbers, file paths, quotes, emoji or trailing period. If the messages are in Czech, still
answer in English. Reply with the title only.

Project: {project}
{prompts}'''


def session_log(sid):
    """The log of session `sid` on this machine (~/.claude/projects/<folder>/<sid>.jsonl), else None."""
    import glob
    base = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude')
    hits = glob.glob(os.path.join(glob.escape(base), 'projects', '*', glob.escape(sid) + '.jsonl'))
    return max(hits, key=os.path.getmtime) if hits else None


def log_titles(path, tail=None):
    """The custom-title names in a session's log (its last `tail` bytes only, when given), oldest first."""
    out = []
    try:
        with open(path, 'rb') as f:
            if tail:
                f.seek(max(0, os.path.getsize(path) - tail))
            for raw in f:
                if b'"custom-title"' not in raw:
                    continue
                try:
                    o = json.loads(raw)
                except ValueError:
                    continue
                if o.get('type') == 'custom-title' and o.get('customTitle'):
                    out.append(o['customTitle'])
    except OSError:
        pass
    return out


def write_name(path, sid, title):
    """Append the line `/rename` writes; Claude Code takes the last one as the session's name."""
    line = json.dumps({'type': 'custom-title', 'customTitle': title, 'sessionId': sid}, ensure_ascii=False,
                      separators=(',', ':'))  # byte for byte the line Claude Code writes
    with open(path, 'rb+') as f:
        f.seek(0, 2)
        if f.tell():
            f.seek(-1, 2)
            lead = b'' if f.read(1) == b'\n' else b'\n'
        else:
            lead = b''
    with open(path, 'ab') as f:
        f.write(lead + line.encode() + b'\n')
    os.makedirs(NAMES_DIR, exist_ok=True)
    with open(os.path.join(NAMES_DIR, sid), 'w', encoding='utf-8') as f:
        f.write(title)


def tidy_name(title):
    t = re.sub(r'\s+', ' ', str(title or '')).strip().strip('"\'.').strip()
    t = re.sub(r'^(?:task\s*)?#?\d+[:\s-]+', '', t, flags=re.I)  # never a bare task number
    return (t if len(t) <= 80 else t[:79].rsplit(' ', 1)[0] + '…') if len(t) >= 2 else None  # whole task titles (up to 70)


def first_prompts(path, n=2):
    """The first `n` things a person typed in the session (system reminders and notices left out)."""
    out, project = [], None
    try:
        with open(path, encoding='utf-8') as f:
            for i, raw in enumerate(f):
                if i > 400 or len(out) >= n:
                    break
                try:
                    o = json.loads(raw)
                except ValueError:
                    continue
                project = project or o.get('cwd')
                text = _typed_prompt(o)
                if text:
                    out.append(re.sub(r'\s+', ' ', text)[:500])
    except OSError:
        pass
    return out, os.path.basename((project or '').rstrip('/\\')) or '?'


def _typed_prompt(o):
    """The text a person typed in this transcript record, without system reminders; None for anything else."""
    if o.get('type') != 'user' or o.get('isMeta') or o.get('isSidechain') or o.get('promptSource') == 'system':
        return None
    content = _user_text((o.get('message') or {}).get('content'))
    if content is None:
        return None
    text = re.sub(r'^(?:\s*<system-reminder>.*?</system-reminder>)+\s*', '', content, flags=re.S).strip()
    if re.search(r'<command-name>(.*?)</command-name>', text, re.S):  # /clear, /model: says nothing about the work
        return None
    return text if text and not text.startswith('<') else None


def _user_text(content):
    """A user record's text: a string, or its text blocks joined; None for a tool result or anything else."""
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content):
            return None
        content = '\n'.join(b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
    return content if isinstance(content, str) else None


def ask_haiku_name(project, prompts):
    import shutil
    claude = shutil.which('claude') or os.path.expanduser('~/.local/bin/claude')
    prompt = NAME_PROMPT.format(project=project, prompts='\n'.join(f'- {p}' for p in prompts))
    try:
        r = subprocess.run([claude, '-p', prompt, '--model', 'claude-haiku-4-5', '--setting-sources', '', '--tools', '',
                            '--strict-mcp-config', '--no-chrome', '--no-session-persistence', '--output-format', 'json'],
                           capture_output=True, text=True, timeout=90, cwd=os.path.expanduser('~'),
                           env={**os.environ, 'TASKS_HOOKS': '0'}, stdin=subprocess.DEVNULL,
                           creationflags=0x08000000 if os.name == 'nt' else 0)  # CREATE_NO_WINDOW
        out = json.loads(r.stdout)
        result = out.get('result') or ''
        # Not logged in, a usage limit, an API error: the text is a message, not a name.
        if r.returncode or out.get('is_error') or not out.get('usage', {}).get('output_tokens') or '/login' in result:
            return None
        return tidy_name(result)
    except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
        return None


def task_name(sid):
    """The title of the task this session took (doing or done), the latest first."""
    q = urllib.parse.urlencode({'session': f'Claude Code:{sid}', 'limit': 50, 'status': 'all'})
    with urllib.request.urlopen(f'{URL}/api/tasks?{q}', timeout=3) as r:
        tasks = json.load(r)['tasks']
    took = [t for t in tasks if t['status'] in ('doing', 'done')]
    took.sort(key=lambda t: t.get('updated_at') or 0)
    return tidy_name(took[-1]['title']) if took else None


def name_budget(headless=False):
    """One more Haiku name today on this machine? Counts it if so. Headless runs draw on their own
    smaller allowance (h), and every call counts toward the machine's total."""
    os.makedirs(NAMES_DIR, exist_ok=True)
    day = os.path.join(NAMES_DIR, '.calls-' + datetime.date.today().isoformat())
    try:
        with open(day) as f:
            used = f.read().split()
    except OSError:
        used = []
    if len(used) >= NAMES_DAILY or (headless and used.count('h') >= NAMES_DAILY_HEADLESS):
        return False
    with open(day, 'a') as f:
        f.write('h\n' if headless else 'i\n')
    return True


def name_session(sid, path, headless=False):
    """Background half of hook-name: the task's title, else Haiku's. Never replaces a name set meanwhile."""
    try:
        title = task_name(sid)
    except Exception:
        title = None
    if not title:
        prompts, project = first_prompts(path)
        if not prompts or not name_budget(headless):
            return
        title = ask_haiku_name(project, prompts)
    if title and not log_titles(path):
        write_name(path, sid, title)


def rename_for_task(title):
    """`tasks doing`: the session working a task is called by the task's title."""
    sid = os.environ.get('CLAUDE_CODE_SESSION_ID')
    title = tidy_name(title)
    path = sid and title and session_log(sid)
    if path and (log_titles(path) or [None])[-1] != title:
        try:
            write_name(path, sid, title)
        except OSError:
            pass


def hook_name(stdin):
    """Stop hook: a session with no name gets one, once, in the background (the hook returns at once).
    A named session whose name has scrolled far up its log gets the line again near the end, where
    `claude --resume` reads it. Silent, never blocks, never fails the session."""
    try:
        ev = json.load(stdin)
        sid, path = ev.get('session_id'), ev.get('transcript_path')
        if not sid or not path or not os.path.exists(path) or os.environ.get('TASKS_NAMES') == '0':
            return
        if log_titles(path, NAME_TAIL):
            return
        marker = os.path.join(NAMES_DIR, sid)
        known = log_titles(path)
        if known:  # named, but long ago: say it again near the end
            write_name(path, sid, known[-1])
            return
        if os.path.exists(marker):  # asked already
            return
        os.makedirs(NAMES_DIR, exist_ok=True)
        open(marker, 'a').close()
        kw = {'creationflags': 0x08000000 | 0x00000200} if os.name == 'nt' else {'start_new_session': True}
        subprocess.Popen([sys.executable, os.path.abspath(__file__), 'hook-name', '--bg', sid, path]
                         + (['--headless'] if hooks_off() else []),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kw)
    except Exception as e:  # a broken log or hub must never hold a session
        print(f'tasks hook-name: {e}', file=sys.stderr)


STOP = set('this that with from have what when will your into then than them they also just only about there '
           'which would could should make need want udělej oprav jako když nebo jsem není bude máme tady tohle '
           'protože prostě vlastně takže'.split())


def words(text):
    import unicodedata
    text = unicodedata.normalize('NFKD', (text or '').lower())
    text = ''.join(c for c in text if not unicodedata.combining(c))
    return {w for w in re.findall(r'[a-z0-9]{4,}', text) if w not in STOP}


def hook_prompt(stdin):
    """UserPromptSubmit hook: a session opened anywhere (the app, the web, a terminal) that has not
    taken a task is shown the open tasks its prompt may be about, so it takes one (`tasks doing`),
    marks a duplicate, or files its own. Its first 3 prompts at most; silent once it has a task."""
    try:
        ev = json.load(stdin)
        sid, prompt = ev.get('session_id'), ev.get('prompt') or ''
        if not sid or prompt.lstrip().startswith('/') or hooks_off():
            return
        if manual_here():  # outside Beacon: told once, on its first prompt
            if _first_time(sid, 'manual'):
                _prompt_context(MANUAL_NOTE)
            return
        seen = _answers_news(sid, prompt)
        if seen:
            _prompt_context(seen)
            return
        if not _counted_prompt(sid) or _has_task(sid):
            return
        _prompt_context(_task_hint(ev, prompt))
    except Exception as e:  # a broken hub or hook must never hold a prompt
        print(f'tasks hook-prompt: {e}', file=sys.stderr)


def _prompt_context(text):
    print(json.dumps({'hookSpecificOutput': {'hookEventName': 'UserPromptSubmit', 'additionalContext': text}}))


def _first_time(sid, what):
    """True once per session for `what`: a mark file remembers it was done."""
    mark = os.path.join(os.path.expanduser('~/.cache/tasks-hook'), f'{sid}.{what}')
    if os.path.exists(mark):
        return False
    os.makedirs(os.path.dirname(mark), exist_ok=True)
    open(mark, 'w').close()
    return True


def _answers_news(sid, prompt):
    """What this prompt's session must know about answers to its questions ('' when nothing)."""
    try:
        seen = box_answer(sid, prompt)
    except Exception:  # the hub away: the box question stays open on the page
        seen = None
    try:
        own = own_answers(sid)
    except Exception:  # the hub away: the dispatcher still carries the answers out
        own = ''
    return '\n\n'.join(x for x in (seen, own) if x)


def _counted_prompt(sid):
    """Count this prompt; False from the 4th on (the task hint is for a session's first 3 prompts only)."""
    mark = os.path.join(os.path.expanduser('~/.cache/tasks-hook'), f'{sid}.prompts')
    try:
        with open(mark) as f:
            n = int(f.read() or 0)
    except (OSError, ValueError):
        n = 0
    if n >= 3:
        return False
    os.makedirs(os.path.dirname(mark), exist_ok=True)
    with open(mark, 'w') as f:
        f.write(str(n + 1))
    return True


def _has_task(sid):
    """The session has taken (or finished) a task already."""
    q = urllib.parse.urlencode({'session': f'Claude Code:{sid}', 'status': 'all', 'limit': 50})
    with urllib.request.urlopen(f'{URL}/api/tasks?{q}', timeout=2) as r:
        return any(t['status'] in ('doing', 'done') for t in json.load(r)['tasks'])


def _task_hint(ev, prompt):
    """The nudge to take a task, with the open tasks whose words the prompt shares."""
    project = project_of(ev.get('cwd'))
    here = project != 'personal'  # in a repo: its tasks only; elsewhere every project, stricter
    q = urllib.parse.urlencode({'status': 'todo', 'limit': 2000, **({'project': project} if here else {})})
    with urllib.request.urlopen(f'{URL}/api/tasks?{q}', timeout=2) as r:
        open_ = [t for t in json.load(r)['tasks'] if 'parked' not in t['tags']]
    want = words(prompt)
    scored = sorted(((len(want & words(t['title'] + ' ' + (t.get('body') or '')[:400])), t) for t in open_),
                    key=lambda x: (-x[0], -x[1]['updated_at']))
    hits = [t for score, t in scored[:5] if score >= (2 if here else 3)]
    out = ['No task at http://beacon is taken by this session yet. If this prompt starts work that outlives this '
           'reply, take its task first: `tasks doing ID` only for a task that is clearly the same outcome; none '
           'is → `tasks add "<outcome>" --doing -b "<why + Done-test>"`. A question, chat or quick fix needs no '
           'task, but an idea of his to make, start, try or set up something is one, even asked as "how do I…": '
           'file it with the whole plan as 🤖/👤 steps, do the 🤖 ones, and end ❓ with his next 👤 steps as a '
           '`tasks ask --task ID --step …` card. Word matches below are guesses; ignore any that is not the same work.']
    if hits:
        out.append(f"Open tasks that share words with the prompt ({project if here else 'all projects'}):")
        out += [f"  #{t['id']} [{t['project']}] {t['status']}: {t['title'][:120]}" for t in hits]
    return '\n'.join(out)


def utf8_console():
    """A Windows console is cp1252: titles carry → and emoji."""
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding='utf-8', errors='replace')
        except (AttributeError, ValueError):
            pass


