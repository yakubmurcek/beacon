def gate(ev, now=None, hub=None):
    """Decide one PreToolUse event: (decision, record). decision is None (let it be) or 'deny'."""
    tool, ti, cwd = ev.get('tool_name'), ev.get('tool_input') or {}, ev.get('cwd') or ''
    hit = risky_call(tool, ti, cwd)
    if not hit:
        return None, None
    cat, what = hit
    mode = gate_mode()
    sid = ev.get('session_id')
    rec = {'ts': now or time.time(), 'machine': socket_host(), 'session': sid, 'tool': tool, 'category': cat,
           'what': what, 'input': (ti.get('command') if tool == 'Bash' else json.dumps(ti, ensure_ascii=False))[:500],
           'cwd': cwd, 'mode': mode, 'permission_mode': ev.get('permission_mode')}
    yes = chat_yes(ev.get('transcript_path'), cat)
    if yes:
        rec['approved'] = 'chat: ' + yes
        return None, rec
    try:
        h = (hub or hub_yes)(f'Claude Code:{sid}' if sid and ':' not in sid else sid, cat, cwd)
    except Exception as e:  # noqa: BLE001 - the hub down: irreversible waits, the rest goes on (logged)
        rec['hub_error'] = type(e).__name__
        h = None
        if cat not in IRREVERSIBLE:
            rec['approved'] = 'hub unreachable, reversible: let through'
            return None, rec
    if h:
        rec['approved'] = f'question #{h[0]}: {h[1]}'[:200]
        return None, rec
    rec['approved'] = None
    return ('deny' if mode == 'enforce' else None), rec


