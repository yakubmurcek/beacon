ASSIGN = re.compile(r'''(?:^|[\s;&|(])([A-Za-z_]\w*)=("[^"$`]*"|'[^']*'|[^\s;&|$`()'"]+)(?=[\s;&|)]|$)''')


def _expand_vars(cmd):
    """$VAR / ${VAR} replaced by a plain value assigned in the same command (B=https://site; curl "$B/api")."""
    vals = {}
    for m in ASSIGN.finditer(cmd):
        vals.setdefault(m.group(1), m.group(2).strip('"\''))
    if not vals:
        return cmd
    return re.sub(r'\$\{?([A-Za-z_]\w*)\}?', lambda m: vals.get(m.group(1), m.group(0)), cmd)


def _scratch(path):
    p = (path or '').lower().rstrip('/') + '/'
    return bool(SAFE_RM.search(p + 'x')) or any(s in p for s in ('/agent-work/', '/.claude/worktrees/', '/scratchpad/',
                                                                  '/.worktrees/', '-wt-', '-wt/'))


def _repo_owner(cwd):
    """The GitHub owner of the repo at cwd (from .git/config), or None."""
    d = cwd or ''
    for _ in range(8):
        if not d:
            return None
        cfg = os.path.join(d, '.git')
        if os.path.isfile(cfg):  # a worktree: "gitdir: /x/.git/worktrees/y"
            try:
                with open(cfg) as f:
                    cfg = f.read().split('gitdir:', 1)[1].strip().split('/.git/')[0] + '/.git'
            except (OSError, IndexError):
                return None
        if os.path.isdir(cfg):
            try:
                with open(os.path.join(cfg, 'config')) as f:
                    m = re.search(r'url\s*=\s*\S*github\.com[:/]([\w.-]+)/', f.read())
                return m.group(1).lower() if m else None
            except OSError:
                return None
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent
    return None


def _where(cmd, cwd):
    """The folder a command acts in: the last `cd X` in it, else the session's cwd."""
    m = None
    for m in CD_RE.finditer(cmd):
        pass
    if not m:
        return cwd or ''
    d = os.path.expanduser(m.group(1).strip('"\''))
    return d if os.path.isabs(d) else os.path.join(cwd or '', d)


SHARED = re.compile(r'(^|[\s:/+])(main|master|dev|develop|production|prod|release|gh-pages)($|[\s:])')


def _shared_branch(cmd, where):
    """Does this force push / delete hit a shared branch? Named in the command, or (none named) the
    branch checked out where it runs. Unknown counts as shared."""
    m = re.search(r'\bgit\s+push\b([^|;&\n]*)', cmd)
    args = [a for a in (m.group(1).split() if m else []) if not a.startswith('-') and not a.startswith('2>')]
    if any(SHARED.search(' ' + a) for a in args[1:]) or '--mirror' in cmd:
        return True
    if len(args) >= 2:  # remote + branch(es), none shared
        return False
    return _checkout_is_shared(where)


def _checkout_is_shared(where):
    """Is the branch checked out at `where` (or the nearest folder above holding .git) shared?
    A detached HEAD, no repo or an unreadable one count as shared."""
    d = where or ''
    for _ in range(8):
        try:
            return _head_is_shared(_git_dir(d))
        except (OSError, IndexError):
            parent = os.path.dirname(d)
            if not d or parent == d:
                return True
            d = parent
    return True


def _git_dir(d):
    """The git dir of a checkout at d: d/.git, or where a worktree's .git file points."""
    git = os.path.join(d, '.git')
    if os.path.isfile(git):
        with open(git) as f:
            git = f.read().split('gitdir:', 1)[1].strip()
    return git


def _head_is_shared(git_dir):
    with open(os.path.join(git_dir, 'HEAD')) as f:
        ref = f.read().strip()
    return bool(SHARED.search(' ' + ref.rsplit('/', 1)[-1])) if ref.startswith('ref:') else True


def _after_cd(here, line):
    """Where the next command runs when this line is `cd X`; else unchanged."""
    c = re.match(r'^cd\s+("[^"]+"|\'[^\']+\'|\S+)', line.strip())
    if not c:
        return here
    d = os.path.expanduser(c.group(1).strip('"\''))
    return d if os.path.isabs(d) else os.path.join(here, d)


def _here_of(cmd, rx, cwd):
    """The folder the first command matching rx runs in: cwd moved by the cd's before it."""
    here = cwd or ''
    for part in cmd.split('\n'):
        here = _after_cd(here, part)
        if rx.search(part):
            return here
    return here


def _internal(path):
    return any(f'/{r}' in path.lower() for r in INTERNAL_REPOS)


def _rm_risky(args, where=''):
    """rm -r of anything but scratch and build output (a relative path inside a scratch folder is scratch)."""
    flags, rest = args
    if not re.search(r'(^|\s)-\w*r|--recursive', flags):
        return False
    targets = [t.strip('"\'') for t in re.split(r'\s+', rest.strip()) if t and not t.startswith('-')]
    targets = [t for t in targets if t not in ('2>/dev/null', '>/dev/null', '2>&1', '||', 'true', '&&')
               and not t.startswith(('>', '2>')) and re.search(r'[\w~$*]', t) and not re.match(r'^[\d)(]+$', t)]
    scratch = SAFE_RM.search((where or '').lower().rstrip('/') + '/x') or '/agent-work' in (where or '')

    def safe(t):
        t = t.lower()
        return bool(SAFE_RM.search(t)) or (scratch and not t.startswith(('/', '~', '$home', '..')))
    return any(not safe(t) for t in targets) if targets else False


# (not a here-string <<< or a bit shift $((1<<4)): those carry no body)
HEREDOC = re.compile(r"(?<![<\w)])<<(?!<)-?\s*(['\"]?)([A-Za-z_]\w*)\1[^\n]*\n(.*?)\n\s*\2\s*(?=\n|$)", re.S)
# A segment starting with one of these only carries text (a note, a message, a search pattern).
TEXT_CMDS = frozenset({'echo', 'printf', 'tasks', 'grep', 'egrep', 'fgrep', 'rg', 'ag', 'awk', 'sed', 'jq', 'cat', 'head',
                       'tail', 'less', 'ls', 'wc', 'sort', 'uniq', 'cut', 'tr', 'tee', 'diff', 'test', '[', 'true', 'false',
                       'read', 'export', 'local', 'declare', 'set', 'notify', 'say', 'man', 'which', 'type', 'command'})
TEXT_GIT = frozenset({'commit', 'tag', 'log', 'show', 'diff', 'grep', 'notes', 'status', 'blame', 'stash'})
SHELLS = frozenset({'bash', 'sh', 'zsh', 'ssh', 'su', 'eval', 'watch', 'docker', 'exec', 'systemd-run'})
# Prefixes that run the command after them: strip them and look at that command.
WRAPPER = re.compile(r'^(?:sudo(?:\s+-[ugCDhpRrTt]\s+(?!-)\S+|\s+-[a-zA-Z]+)*|timeout(?:\s+-\S+)*\s+\S+|nice(?:\s+-n)?\s*-?\d*|'
                     r'ionice(?:\s+-c\s*\d)?(?:\s+-n\s*\d)?|nohup|time|env(?:\s+-\S+)*|xargs(?:\s+-\S+(?:\s+\d+)?)*|'
                     r'setsid|stdbuf(?:\s+-\S+)*|command)\s+')
AGENTS = re.compile(r'^(\S*/)?(claude|codex|gemini|opencode|aider|grok)$')  # their quoted prompt is text, not a command
CODE_CMDS = re.compile(r'^(python3?|node|bun|deno|ruby|perl|php|uv|npx|tsx|ts-node|osascript)$')
PREFIX = re.compile(r"^(?:\w+=(?:'[^']*'|\"[^\"]*\"|\S*)\s+)*")


def _segments(cmd):
    """Split a shell line on unquoted ; && || | & and newlines (good enough to find each command's first word)."""
    out, cur, q, i = [], [], None, 0
    while i < len(cmd):
        c = cmd[i]
        if q:
            q, i = _quoted_char(cmd, i, q, cur)
        elif c in '\'"':
            q = c
            cur.append(c)
        elif c in ';|&\n)' or (c == '(' and (i == 0 or cmd[i - 1] == '$')):  # $(…) opens and ) closes a command
            out.append(''.join(cur))
            cur = []
        elif c == '#' and (not cur or cur[-1] in ' \t'):
            end = cmd.find('\n', i)  # a comment runs to the end of its line
            i = len(cmd) if end < 0 else end
            continue
        else:
            cur.append(c)
        i += 1
    out.append(''.join(cur))
    return [x.strip() for x in out if x.strip()]


def _quoted_char(cmd, i, q, cur):
    """Take the character at i inside quote q (a backslash in double quotes takes the next one with it):
    (the quote still open, the index of the last character taken)."""
    c = cmd[i]
    if c == q:
        q = None
    elif c == '\\' and q == '"' and i + 1 < len(cmd):
        cur.append(c)
        i += 1
        c = cmd[i]
    cur.append(c)
    return q, i


def _unquote_payloads(seg):
    """The quoted commands inside ssh host '...', bash -c "...", su -c '...'."""
    return [m.group(2) for m in re.finditer(r"(['\"])(.*?)\1", seg, re.S)]


def _unquoted(seg):
    """The segment with its quoted strings blanked: the command and flags stay, the text goes."""
    return re.sub(r"(['\"]).*?\1", ' ', seg, flags=re.S)


def _unwrapped(seg):
    """The segment without VAR=x prefixes and wrappers (sudo, timeout, env, xargs …) before its command."""
    seg = PREFIX.sub('', seg)
    while True:
        w = WRAPPER.match(seg)
        if not w:
            return seg
        seg = PREFIX.sub('', seg[w.end():])


def _only_text(first, words):
    """A command whose arguments are text that never acts (echo, grep, a commit message, a heredoc to a file)."""
    if first in TEXT_CMDS or first.startswith('__heredoc'):
        return True
    stash_drop = words[1:3] in (['stash', 'drop'], ['stash', 'clear'])
    return first == 'git' and len(words) > 1 and words[1] in TEXT_GIT and not stash_drop


SQL_CLIS = frozenset({'psql', 'sqlite3', 'mysql', 'supabase', 'turso', 'duckdb'})


def _segment_runs(seg, bodies, depth):
    """(shell, code) lists one segment adds to _executed's answer; bodies maps heredoc keys to their text."""
    seg = _unwrapped(seg)
    words = seg.split()
    if not words:
        return [], []
    first = words[0].rsplit('/', 1)[-1]
    keys = [k for k in bodies if k in seg]
    heredocs = [bodies[k] for k in keys]
    if _only_text(first, words):
        return [], []  # (cat > file <<EOF drops the body with it)
    if AGENTS.match(words[0]):
        return [_unquoted(seg)], []
    if CODE_CMDS.match(first):
        return [_unquoted(seg)], heredocs + _unquote_payloads(seg)  # e.g. `npx vercel --prod` still counts
    if first in SHELLS and depth < 3:
        return _nested_runs(seg, heredocs, depth)
    if first in SQL_CLIS:
        return [seg + ' ' + ' '.join(heredocs)], []
    if first == 'gh':  # titles and bodies are text; the command and its repo are not
        return [_unquoted(seg)], []
    if keys and any(CODE_CMDS.match(w.rsplit('/', 1)[-1]) for w in words[1:]):
        return [seg], heredocs  # e.g. `PW=… python3 - <<EOF` the prefix hid: its code still runs
    return [seg], []


def _nested_runs(seg, heredocs, depth):
    """A shell, ssh or eval segment: what its quoted payloads and heredocs run, then the segment itself."""
    shell, code = [], []
    for payload in _unquote_payloads(seg) + heredocs:
        s2, c2 = _executed(payload, depth + 1)
        shell.append(s2)
        code += c2
    shell.append(_unquoted(seg))
    return shell, code


def _executed(cmd, depth=0):
    """(shell, code): the parts of a Bash command that run as shell commands, and the code that
    interpreters run (python heredocs, -c strings). Text handed to echo, tasks, grep, a commit
    message or a file-writing heredoc is dropped: words in it don't act."""
    bodies = {}

    def take(m):
        key = f'__heredoc{len(bodies)}__'
        bodies[key] = m.group(3)
        return key
    cmd = HEREDOC.sub(take, cmd)
    shell, code = [], []
    for seg in _segments(cmd):
        s, c = _segment_runs(seg, bodies, depth)
        shell += s
        code += c
    return '\n'.join(shell), code


def risky_call(tool, tool_input, cwd=''):
    """Layer 2: (category, what) when a tool call sends, pays, publishes, deletes, goes live or
    reaches other people; else None. Pure and fast: a file is read only for gh in an unnamed repo
    and for a script the command runs."""
    tool = str(tool or '')
    ti = tool_input if isinstance(tool_input, dict) else {}
    if tool == 'Bash':
        return _BashCall(str(ti.get('command') or ''), cwd).risk()
    if tool.startswith('mcp__'):
        return _risky_mcp(tool.lower(), ti)
    return None


class _BashCall:
    """One Bash command as the gate reads it: the raw line, what runs as shell (lowercased) and the
    code interpreters run. Each check returns (category, what) or None; the first hit wins."""

    def __init__(self, command, cwd):
        self.cwd = cwd
        self.raw = _expand_vars(command)
        self.where = _where(self.raw, cwd)
        shell, code = _executed(re.sub(r'\\\n', ' ', self.raw))
        self.cmd = shell.lower()
        self.body = '\n'.join(code).lower()

    def risk(self):
        return self.rule_hit() or self.inline_code_hit() or self.delete_hit() or self.script_hit()

    def rule_hit(self):
        for cat, what, rx in BASH_RULES:
            if rx.search(self.cmd) and not self.exempt(cat, what, rx):
                return cat, what
        return None

    def exempt(self, cat, what, rx):
        """A rule's hit that is his own housekeeping, not a risk."""
        if cat == 'live' and what == 'production deploy':
            return _internal(self.where)  # his internal tools ship straight to production
        if cat == 'people' and what.startswith('GitHub'):
            return self.own_repo(rx)
        check = next((getattr(self, name) for w, name in self.EXEMPT if w == what), None)
        return bool(check and check(rx))

    def own_repo(self, rx):
        """gh writes only to someone else's repo count: named in the command, or the checkout it runs in.
        No GitHub checkout (owner None) leaves gh no repo to write to."""
        m = GH_REPO.search(self.cmd) or GH_API_REPO.search(self.cmd)
        owner = m.group(1).lower() if m else _repo_owner(_here_of(self.cmd, rx, self.cwd))
        return owner in (OWN, None)

    def own_branch_delete(self, rx):
        """Deleting his own feature branch through the GitHub API."""
        cmd = self.cmd
        return bool(re.search(rf'api\.github\.com/repos/{OWN}/[^/\s]+/git/refs/heads/', cmd)
                    and not SHARED.search(cmd.split('/git/refs/heads/', 1)[1][:40].split()[0]
                                          if '/git/refs/heads/' in cmd else ''))

    def preview_protection_off(self, rx):
        return 'ssoprotection' in self.raw.lower()  # his rule: preview protection off with exactly this PATCH

    def db_read(self, rx):
        return 'database/query' in rx.pattern and not SQL_WRITE.search(self.raw.lower())  # a Management API read

    def in_scratch(self, rx):
        return _scratch(_here_of(self.cmd, rx, self.cwd))  # scratch clones and agent worktrees hold only its own work

    def own_branch_push(self, rx):
        return not _shared_branch(self.cmd, self.where)  # rewriting his own feature branch is housekeeping

    EXEMPT = (  # (rule, the check that makes its hit housekeeping)
        ('delete a project', 'own_branch_delete'),
        ('Vercel settings', 'preview_protection_off'),
        ('production DB write', 'db_read'),
        ('discard uncommitted work', 'in_scratch'),
        ('force push / remote delete', 'own_branch_push'),
    )

    def inline_code_hit(self):
        body = self.body
        for cat, what, rx in SCRIPT_RULES:
            if body and rx.search(body):
                return cat, what + ' (inline code)'
        if 'api.hackmd.io' in self.raw and re.search(r'readperm\w*["\'\s:=]+["\']?guest', self.raw.lower()):
            return 'publish', 'note readable by anyone'
        if 'database/query' in body and 'api.supabase.com' in body and SQL_WRITE.search(body):
            return 'live', 'production DB write (inline code)'
        return None

    def delete_hit(self):
        """rm -r, rm on an external drive and find -delete, each judged where the cd's before it left off."""
        here = self.cwd or ''
        for part in self.cmd.split('\n'):
            here = _after_cd(here, part)
            hit = _line_deletes(part, here)
            if hit:
                return hit
        return None

    def script_hit(self):
        """A script file the command runs that sends or pays."""
        for m in SCRIPT_RE.finditer(self.raw):
            hit = _script_file_hit(os.path.join(self.where, os.path.expanduser(m.group(1))))
            if hit:
                return hit
        return None


def _line_deletes(part, here):
    m = RM_RE.search(part)
    if m and _rm_risky(m.groups(), here):
        return 'delete', 'rm -r ' + m.group(2).strip()[:60]
    if here.lower().startswith('/volumes/') and re.search(r'(^|\s)rm\s', part):
        return 'delete', 'rm on an external drive'
    m = FIND_DELETE.search(part)
    if m and not SAFE_RM.search(m.group(1).strip('"\'')):
        return 'delete', 'find -delete ' + m.group(1)[:60]
    return None


def _script_file_hit(path):
    try:
        if os.path.getsize(path) >= 400_000:
            return None
        with open(path, errors='ignore') as f:
            body = f.read().lower()
    except OSError:
        return None
    for cat, what, rx in SCRIPT_RULES:
        if rx.search(body):
            return cat, f'{what} in {os.path.basename(path)}'
    return None


def _risky_mcp(name, ti):
    """An MCP tool call (name lowercased) that reaches people, deletes, deploys, posts or pays."""
    if _mcp_reaches_nobody(name):
        return None
    if 'calendar' in name and name.endswith(('__create_event', '__update_event')):
        att = ti.get('attendees') or ti.get('attendee_emails') or []
        return ('people', 'calendar invite') if att else None
    if SQL_TOOLS.search(name):
        q = fold(ti.get('query') or ti.get('sql') or '')
        return ('delete', 'SQL delete') if SQL_DELETE.search(q) else None
    return next(((cat, what) for cat, what, rx in MCP_RULES if rx.search(name)), None)


def _mcp_reaches_nobody(name):
    if 'claude-in-chrome' in name or 'claude_browser' in name:
        return True  # clicks carry no meaning here; see the gap in the README
    return name.split('__')[1] in INTERNAL_MCP or 'draft' in name  # his own agent sessions, notes and drafts


# His yes. A risky call passes when HE said it: his own words in this chat (a typed or dictated
# turn: turnOrigin human; never a brief another agent wrote, a task notification or a summary), or
# a question about it he answered on the page or a task (the hub checks that one).
YES_WORDS = {
    'send': r'\bposl|\bodesl|\bsend|\bmail (it|him|her|them)|\bnapis (mu|ji|jim)|\breply|odpovez|\bforward',
    'pay': r'\bzaplat|\bkup|\bobjedn|\bpay\b|\bbuy\b|\border it|\bpurchase|\bsubscribe|\bpredplat',
    'publish': r'\bpublik|\bzverejn|\bpostn|\bpost (it|that|this)|\bpublish|\blaunch|\breleas|\bpust (to )?ven|\bvydej|\bsubmit',
    'delete': r'\bsmaz|\bvymaz|\bdelete|\bremove|\bodstran|\bdrop\b|\bwipe|\bzrus|\bclean (it|up)|\buklid',
    'live': r'\bdeploy|\bnasad|\bprod\b|\bproduction|\bostr|\blive\b|\bmerge|\bmergn|\bpust (to )?ven|\bship',
    'people': r'\bposl|\bnapis|\bkomentuj|\bcomment|\breply|\bodpovez|\boslov|\bpozvi|\binvite',
}
YES_RE = {k: re.compile(v) for k, v in YES_WORDS.items()}
GENERIC_YES = re.compile(r'^\W*(ano|jo|jj|jasne|ok|okay|oki|yes|yep|yeah|sure|go|go ahead|do it|udelej( to)?|jed|'
                         r'souhlas(im)?|schval(uji|eno)?|approved?|potvrzuji|klidne|v poradku|muzes|dobre|sounds good|'
                         r'perfektni|super|parada|zapni)\b')
NOT_YES = re.compile(r'\b(ne\b|nee|nikdy|never|don\'?t|do not|neposil|nepos|nemaz|nesmaz|nedelej|nenasaz|nepublik|'
                     r'pockej|cekej|wait|stop|zatim ne|not yet|jen draft|only (a )?draft|koncept|nejdriv mi ukaz|show me first|'
                     r'neodesil|bez odeslani)')
MARKUP = ('<', '[request interrupted', 'caveat:', 'this session is being continued')


def his_words(transcript, limit=3, tail=600_000):
    """His last `limit` messages in a transcript, newest first: (text, timestamp)."""
    try:
        with open(transcript, 'rb') as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - tail))
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except (OSError, TypeError):
        return []
    return his_words_in(lines, limit)


def his_words_in(lines, limit=3):
    """The same from transcript lines (oldest first). Only turns he typed or dictated count; tool
    results, hook text, summaries and prompts written by another agent never do."""
    out = []
    for line in reversed(lines):
        turn = _his_turn(line) if '"user"' in line else None
        if turn:
            out.append(turn)
            if len(out) >= limit:
                break
    return out


def _his_turn(line):
    """(text, timestamp) when this transcript line is a turn he typed or dictated, else None."""
    try:
        d = json.loads(line)
    except ValueError:
        return None
    if not _typed_by_him(d):
        return None
    c = (d.get('message') or {}).get('content')
    if isinstance(c, list):
        if any(isinstance(x, dict) and x.get('type') == 'tool_result' for x in c):
            return None
        c = '\n'.join(x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text')
    c = str(c or '').strip()
    if not c or c.lower().startswith(MARKUP):
        return None
    return c, d.get('timestamp')


def _typed_by_him(d):
    """A user turn of the main thread with a human origin; with no origin recorded, an old record counts unless it
    came headless or from the app."""
    if d.get('type') != 'user' or d.get('isMeta') or d.get('isSidechain') or d.get('isCompactSummary'):
        return False
    origin = d.get('turnOrigin') or (d.get('origin') or {}).get('kind')
    if origin is not None:
        return origin == 'human'
    return not (d.get('promptSource') in ('sdk', 'system') or d.get('entrypoint') == 'sdk-cli')


def chat_yes(transcript, category, words=None):
    """The words of his that OK this category of action, or None. His latest message may be a bare
    yes ("ano", "pošli to"); an older one must name the action. A no or a wait in it wins.
    `words` (his_words_in) instead of a transcript path: the replay eval."""
    rx = YES_RE.get(category)
    for i, (text, _) in enumerate(his_words(transcript) if words is None else words):
        t = fold(text)
        t = '\n'.join(l for l in t.splitlines() if not l.lstrip().startswith('>')).strip()  # not a quoted agent reply
        if not t:
            continue
        if NOT_YES.search(t):
            return None
        if rx and rx.search(t):
            return text[:160]
        if i == 0 and GENERIC_YES.search(t) and len(t) < 160 and '?' not in t:  # "ok ... is it ready??" asks, not OKs
            return text[:160]
    return None


def gate_mode():
    """shadow (log only, the default) or enforce. The env can raise it for one run (the live test),
    never lower it: a nested agent can't switch the gate off for itself."""
    mode = 'shadow'
    for p in (os.path.expanduser('~/.claude/gate-mode'), os.path.expanduser('~/.claude-config/gate-mode')):
        try:
            with open(p) as f:
                mode = f.read().strip().lower() or 'shadow'
            break
        except OSError:
            continue
    if os.environ.get('GATE_MODE') == 'enforce':
        mode = 'enforce'
    return mode if mode in ('shadow', 'enforce', 'off') else 'shadow'


IRREVERSIBLE = ('send', 'pay', 'publish', 'delete', 'people')


def gate_log(rec):
    """One line per flagged call: local (~/.claude/state/gate.jsonl) and on the hub (best effort)."""
    line = json.dumps(rec, ensure_ascii=False)
    try:
        p = os.path.expanduser('~/.claude/state')
        os.makedirs(p, exist_ok=True)
        with open(os.path.join(p, 'gate.jsonl'), 'a', encoding='utf-8') as f:
            f.write(line + '\n')
    except OSError:
        pass
    try:
        import urllib.request
        req = urllib.request.Request(URL + '/api/gate/log', data=line.encode(), method='POST',
                                     headers={'Content-Type': 'application/json', **_auth_header()})
        urllib.request.urlopen(req, timeout=1.5).close()
    except Exception:  # noqa: BLE001 - the log never decides anything
        pass


