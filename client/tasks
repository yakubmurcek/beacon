def current_project():
    """The repo you are in (its main checkout's folder name, also from a worktree), else personal."""
    try:
        common = subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                                capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        common = ''
    if common:
        name = os.path.basename(os.path.dirname(common.rstrip('/\\')))
        if name and name not in ('Projects', 'projects'):
            return name
    return folder_project(os.getcwd()) or 'personal'


def folder_project(cwd):
    """A project outside git (an Unreal game is never in git): the folder right under a *projects folder
    (`~/Projects/X`, `Documents/Unreal Projects/X`), named the way the usage collector names it. Else None.
    2026-11-23: the Unreal game's sessions filed every task and card under "personal"."""
    parts = [x for x in re.split(r'[\\/]', cwd or '') if x]
    under = [i for i, x in enumerate(parts) if x.lower().endswith('projects')]
    if not under or under[-1] + 1 >= len(parts):
        return None
    i = under[-1] + 1
    if parts[i].lower() in ('parked', 'archive') and i + 1 < len(parts):
        i += 1
    return parts[i] if not parts[i].startswith('.') else None


