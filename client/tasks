def hook_parsers(sub):
    """The Claude Code hooks: each reads its event from stdin."""
    for name, hook in (('hook-ask', hook_ask), ('hook-stop', hook_stop), ('hook-prompt', hook_prompt)):
        sub.add_parser(name, help=argparse.SUPPRESS).set_defaults(run=lambda a, hook=hook: hook(sys.stdin))
    sub.add_parser('hook-gate', help=argparse.SUPPRESS).set_defaults(run=lambda a: sys.exit(hook_gate(sys.stdin)))
    hn = sub.add_parser('hook-name', help=argparse.SUPPRESS)
    hn.add_argument('--bg', nargs=2, metavar=('SESSION', 'LOG'))
    hn.add_argument('--headless', action='store_true')
    hn.set_defaults(run=cmd_hook_name)


def build_parser():
    ap = argparse.ArgumentParser(prog='tasks', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd')
    task_parsers(sub)
    question_parsers(sub)
    hook_parsers(sub)
    return ap


