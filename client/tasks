# Progress written into a title or body instead of the status makes the list lie: the task reads
# finished to an eye and open to every filter (2026-09-14). Narrow on purpose: headings and
# standalone claims, not the word "done" inside a sentence. EN + CZ.
MARKERS = (r'✅|DONE|COMPLETE|COMPLETED|FINISHED|SHIPPED|HOTOVO|DOKONČENO'
           r'|⏳|🛑|⚠️|👉|IN PROGRESS|PARTIAL|BLOCKED|NEEDS YOU|STILL OPEN|WIP')
# A heading that names the done-test ("## Done-test", "## Done when") is the body's job, not a claim.
PROGRESS = re.compile(rf'^\s*#{{1,6}}\s*.*({MARKERS})(?![- ]?(test|when)\b)'
                      rf'|^\s*(✅|⏳|🛑|⚠️|👉|\*\*)?\s*({MARKERS})(?![- ]?(test|when)\b)\s*(\*\*)?\s*(:|—|-|$)'
                      r'|^\s*[-*]\s*\[x\]', re.I | re.M)


def guard_progress(fields):
    if 'status' in fields:
        return
    text = '\n'.join(fields.get(k) or '' for k in ('title', 'body'))
    if PROGRESS.search(text):
        sys.exit('tasks: refused: that title/body records progress, which belongs in the status.\n'
                 '  Status is where it stands (tasks doing/done/drop, or status= in the same set).\n'
                 '  The body is what REMAINS plus the done-test. What happened goes in a note:\n'
                 '  tasks done ID -m "✅ Done — …"  /  tasks note ID "⚠️ Partial — …"')


def read_text(v):
    return sys.stdin.read() if v == '-' else v


def parse_set(pairs):
    out = {}
    for p in pairs:
        k, sep, v = p.partition('=')
        if not sep:
            sys.exit(f'tasks: expected key=value, got {p!r}')
        if k == 'priority':
            out[k] = int(v) if v else None
        elif k == 'tags':
            out[k] = [x.strip() for x in v.split(',') if x.strip()]
        elif k in ('due',):
            out[k] = v or None
        elif k in ('title', 'body', 'project', 'status'):
            out[k] = read_text(v)
        else:
            sys.exit(f'tasks: unknown field {k} (title, body, project, status, priority, due, tags)')
    return out


