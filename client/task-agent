def sweep_orphans():
    """A run that died mid-way (the box rebooted, the process was killed) leaves its task doing,
    the pickup its last word, with nobody on it, for good (#598 sat so for 15 days). Called while
    holding the run lock, so no run of this box is going: such a task is given back. The first
    time, within a day, it goes back in the queue (most deaths are the box, not the task);
    otherwise to him."""
    for t in cli.call('/api/tasks?status=doing&limit=2000', auth=False)['tasks']:
        n = t.get('last_note') or {}
        mid_check = n.get('text', '').startswith(('🔎', '🔁'))  # it died while its fix was being checked
        if not allowed(t) or n.get('author') != ME or not (n.get('text', '').startswith(f'{PICKUP} on {MACHINE} ') or mid_check):
            continue
        full = cli.call(f"/api/tasks/{t['id']}", auth=False)
        died = sum(1 for c in full['comments'] if c['author'] == ME and c['text'].startswith('⚠️ The agent\'s run died'))
        again = (died == 0 and time.time() - n['at'] < 86400 and TAG in full['tags']
                 and not any(w in full['tags'] for w in WAITS))
        tags = full['tags'] if again else [x for x in full['tags'] if x != TAG]
        cli.call(f"/api/tasks/{t['id']}", {'status': 'todo', 'tags': tags})
        note(t['id'], "⚠️ The agent's run died mid-way and nothing came back. "
             + ('It goes back in the queue for one more try.' if again
                else 'Back with you: a reply with more detail hands it back to the agent.'))
        print(f"task-agent: #{t['id']} was left mid-run; {'queued again' if again else 'given back'}", file=sys.stderr)


def pr_state(url, env):
    try:
        r = subprocess.run([GH, 'pr', 'view', url, '--json', 'state', '-q', '.state'], env=env,
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    state = r.stdout.strip()
    return state if r.returncode == 0 and state in ('OPEN', 'MERGED', 'CLOSED') else None


def sync_prs(force=False):
    """A PR on a doing task that was merged or closed on GitHub (by him, or by a session) moves
    the task, the way his `merge` reply would: merged -> done, closed unmerged -> back on his list.
    Without this a merged PR left its task doing for good (34 of them on 2026-11-01). Only a task
    whose newest note names a PR, with none of its PRs still open: a later note (a review ask, a
    question) means the task has moved past its PR. Every SYNC_EVERY seconds, quietly."""
    stamp = os.path.join(STATE, 'synced')
    try:
        if not force and time.time() - os.path.getmtime(stamp) < SYNC_EVERY:
            return
    except OSError:
        pass
    os.makedirs(STATE, exist_ok=True)
    with open(stamp, 'w'):  # first: a failure waits for the next window, not the next minute
        pass
    env = None
    for t in cli.call('/api/tasks?status=doing&limit=2000', auth=False)['tasks']:
        if t['project'] in AGENT['publish_gated']:  # merged is not live until a publish (a game's); his call (2026-11-22)
            continue
        if not PR_URL.search((t.get('last_note') or {}).get('text') or ''):
            continue
        full = cli.call(f"/api/tasks/{t['id']}", auth=False)
        if not full['comments'] or not PR_URL.search(full['comments'][-1]['text']):
            continue
        env = env or gh_env()
        prs = list(dict.fromkeys(m.group(0) for c in full['comments'] for m in PR_URL.finditer(c['text'])))
        states = {pr: pr_state(pr, env) for pr in prs}
        newest = list(dict.fromkeys(PR_URL.findall(full['comments'][-1]['text'])))
        if None in states.values() or 'OPEN' in states.values():
            continue
        tags = [x for x in full['tags'] if x != TAG]
        names = ', '.join('#' + pr.rsplit('/', 1)[-1] for pr in newest)
        if any(states[pr] == 'MERGED' for pr in newest):
            cli.call(f"/api/tasks/{t['id']}", {'status': 'done', 'tags': tags})
            note(t['id'], f'✅ PR {names} merged on GitHub, so the task is done.')
        else:
            cli.call(f"/api/tasks/{t['id']}", {'status': 'todo', 'tags': tags})
            note(t['id'], f'↩️ PR {names} was closed without merging. Back on his list.')


def land_moves():
    """A tapped move in a repo of his own notes (agent.self_merge: job-search drafts and the like) that ended at an open
    PR is merged here and its task closed, so the page shows the result. The auto mode classifier refuses an agent's
    push to main even when the brief asks for it (Wattstor draft sat on a branch, 2026-11-24); nothing in these repos
    goes out to anyone, a draft is still only a draft."""
    own = set(AGENT.get('self_merge') or ())
    env = None
    for t in cli.call('/api/tasks?status=doing&limit=2000', auth=False)['tasks']:
        if t['project'] not in own or not tapped(t) or not PR_URL.search((t.get('last_note') or {}).get('text') or ''):
            continue
        env = env or gh_env()
        full = cli.call(f"/api/tasks/{t['id']}", auth=False)
        prs = list(dict.fromkeys(PR_URL.findall(full['comments'][-1]['text'])))
        if not prs or any(f"/{t['project']}/pull/" not in pr for pr in prs):
            continue  # a PR in another repo is not ours to merge
        for pr in prs:
            if pr_state(pr, env) == 'OPEN':
                r = subprocess.run([GH, 'pr', 'merge', pr, '--squash', '--delete-branch'], env=env,
                                   capture_output=True, text=True, timeout=120, check=False)
                if r.returncode:
                    print(f"task-agent: couldn't merge {pr}: {(r.stderr or r.stdout).strip()[-200:]}", file=sys.stderr)
        if all(pr_state(pr, env) == 'MERGED' for pr in prs):
            cli.call(f"/api/tasks/{t['id']}", {'status': 'done', 'tags': [x for x in full['tags'] if x != TAG]})
            note(t['id'], f"✅ {', '.join('#' + p.rsplit('/', 1)[-1] for p in prs)} merged, so the result is on the page.")


# ------------------------------------------------------------------ his replies

def latest_pr(task):
    for c in reversed(task['comments']):
        m = PR_URL.search(c['text'])
        if m:
            return m.group(0)
    return None


def take_answers(tid):
    """His reply carried out here: the task's answers it settles are claimed, so answer-dispatcher never runs
    them a second time."""
    try:
        for q in cli.call(f'/api/questions?status=answered&task={tid}&pending=1', auth=False)['questions']:
            if q["task_id"] != tid:  # an older hub reads task=1 as "any task"
                continue
            cli.call(f"/api/questions/{q['id']}/claim", {'by': ME})
    except SystemExit as e:
        print(f'task-agent: answers on #{tid} not claimed: {e}', file=sys.stderr)


def reply(tid, text, noted=False):
    """His Telegram reply about a task, passed on verbatim by Hermes. `merge` merges the PR the
    agent opened, `drop` drops the task, `mine` keeps it his; anything else is an answer or a
    change request: noted as his, and the task goes back to the agent. Prints one line for him."""
    word = ' '.join(text.lower().strip(' .!?`"\'').split())
    if word in STOP_WORDS:  # the kill switch: a reply to any of the agent's messages
        stop_agent(f'his "{text.strip()[:40]}" on Telegram (#{tid})')
        print('Zastaveno: agent nezačne nic nového (a běžící běh ukončil), dokud nenapíšeš start.')
        return 0
    if word in START_WORDS:
        was = stopped()
        start_agent()
        print('Agent zase běží.' if was else 'Agent už běží.')
        return 0
    task = cli.call(f'/api/tasks/{tid}', auth=False)
    pr = latest_pr(task)
    if str(tid) in scorecard() and claims_fix(next((c['text'] for c in reversed(task['comments'])
                                                    if c['text'].startswith('⏳')), '')):
        # His word on a fix the agent asked him to test (guardrail 7).
        score(tid, outcome='přijato' if word in OK_WORDS else None if word in MINE else 'zamítnuto')
    if word in MERGE:
        if not pr:
            print(f"There's nothing to merge on #{tid} yet.")
            return 1
        env = gh_env()
        subprocess.run([GH, 'pr', 'ready', pr], env=env, capture_output=True, text=True, timeout=60)
        r = subprocess.run([GH, 'pr', 'merge', pr, '--squash', '--delete-branch'], env=env,
                           capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            print(f"Couldn't merge #{tid}: {(r.stderr or r.stdout).strip().splitlines()[-1:] or ['no reason given']}"[:300])
            return 1
        # His note first: it answers the task's open question, which closing would withdraw.
        note(tid, f'✅ Merged {pr} (his reply on Telegram).', OWNER)
        take_answers(tid)
        cli.call(f'/api/tasks/{tid}', {'status': 'done', 'tags': [t for t in task['tags'] if t != TAG]})
        print(f'Merged. #{tid} is done.')
    elif word in DROP and re.search(rf'-- AGENT #{tid}\b', json.dumps(task.get('comments') or [], ensure_ascii=False)):
        # A repo agent's change is still in the game (marked `-- AGENT #id`): dropping the task would leave it there.
        # The agent takes it back and reverts its lines first, then closes the task itself.
        note(tid, f'{text.strip()} (vrať změny agenta a zavři úkol)', OWNER)
        take_answers(tid)
        cli.call(f'/api/tasks/{tid}', {'status': 'todo', 'tags': [*[t for t in task['tags'] if t != TAG], TAG]})
        print(f'Understood. The agent reverts its change on #{tid}, then closes it.')
    elif word in DROP:
        if pr:
            subprocess.run([GH, 'pr', 'close', pr, '--delete-branch'], env=gh_env(), capture_output=True, timeout=60)
        note(tid, '🗑️ Dropped (his reply on Telegram).' + (f' Closed {pr}.' if pr else ''), OWNER)
        take_answers(tid)
        cli.call(f'/api/tasks/{tid}', {'status': 'dropped', 'tags': [t for t in task['tags'] if t != TAG]})
        print(f'Dropped #{tid}' + (' and closed its PR.' if pr else '.'))
    elif word in MINE:
        cli.call(f'/api/tasks/{tid}', {'status': 'todo', 'tags': [t for t in task['tags'] if t != TAG]})
        note(tid, '👉 He takes it himself (his reply on Telegram).', OWNER)
        take_answers(tid)
        print(f'Very well, #{tid} is yours.')
    else:
        if not noted:  # answered on the task itself: his note is there already
            note(tid, text.strip(), OWNER)  # an answer: a `needs-spec` question is answered by it
        cli.call(f'/api/tasks/{tid}', {'status': 'todo', 'tags': [*[t for t in task['tags'] if t not in (TAG, 'needs-spec')], TAG]})
        if allowed(task):  # this agent works it next; a task outside its scope is answer-dispatcher's to resume
            take_answers(tid)
        print(f'Understood. The agent picks #{tid} back up shortly.')
    return 0


def step(name, fn, *args):
    """One housekeeping step; a hub blip or a bug in it never stops the others or the queue."""
    try:
        return fn(*args)
    except (Exception, SystemExit) as e:
        print(f'task-agent: {name} skipped: {str(e).strip() or type(e).__name__}', file=sys.stderr)
        return None


def hold_lock():
    """The box's run lock, held until the process exits: a run by hand (`--id`) and the timer's
    never work at once, and while it is held nobody is mid-run, which the orphan sweep relies on."""
    os.makedirs(STATE, exist_ok=True)
    f = open(os.path.join(STATE, 'lock'), 'w')
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] in (['pause'], ['resume'], ['status']):
        return pause(argv[0])
    if argv[:1] == ['stop']:  # the kill switch, also for Hermes on a bare "agent stop"
        stop_agent(' '.join(argv[1:]) or 'by hand')
        print('Zastaveno: agent nezačne nic nového (a běžící běh ukončil), dokud nenapíšeš start.')
        return 0
    if argv[:1] == ['start']:
        was = stopped()
        start_agent()
        print('Agent zase běží.' if was else 'Agent už běží.')
        return 0
    if argv[:1] == ['sync-prs']:  # its own timer (task-pr-sync): runs whatever mode the agent is in (task 1828)
        sync_prs(force=True)
        return 0
    if argv[:1] == ['scorecard']:
        return show_scorecard(argv[1:])
    if argv[:1] == ['reply']:
        r = argparse.ArgumentParser(prog='task-agent reply', description='Pass on his reply about a task.')
        r.add_argument('--noted', action='store_true', help='he answered on the task: his note is there already')
        r.add_argument('id', type=lambda v: int(v.lstrip('#')))
        r.add_argument('text', nargs='+')
        a = r.parse_args(argv[1:])
        return reply(a.id, ' '.join(a.text), a.noted)
    p = argparse.ArgumentParser(description='Route new tasks, then work the next one handed to the agent.')
    p.add_argument('--dry-run', action='store_true', help="show what it would take, change nothing")
    p.add_argument('--id', type=int, help='work this task now (it must be handed to the agent)')
    a = p.parse_args(argv)
    if a.dry_run:
        return run(a)
    lock = hold_lock()
    if not lock:
        print('task-agent: another run is going on this box', file=sys.stderr)
        return 0
    try:
        step('leftover jails', stop_leftover_jails)
        step('orphan sweep', sweep_orphans)
        return run(a)
    finally:
        lock.close()


def paused():
    return os.path.exists(os.path.join(STATE, 'paused'))


def pause(cmd):
    """He can stop the agent working on its own (2026-11-01: "for now no agents autonomously").
    A file in the state folder, so it survives reboots and deploys; resume deletes it."""
    path = os.path.join(STATE, 'paused')
    if cmd == 'pause':
        os.makedirs(STATE, exist_ok=True)
        with open(path, 'w') as f:
            f.write(time.strftime('%Y-%m-%d %H:%M\n'))
    elif cmd == 'resume' and paused():
        os.remove(path)
    print('paused: no routing, no runs (PR check and dead-run sweep still go)' if paused()
          else 'running: routes new tasks and works the queue')
    return 0


def run(a):
    if not a.dry_run:
        step('held messages', flush_held)  # the night's messages first, in the order they were held
    # His answers on http://beacon/decisions are answer-dispatcher's (task 1776): it calls `reply` for this agent's tasks.
    if not a.dry_run and not a.id and ONLY:
        step('stale reports', stale_reports)
        step('weekly summary', weekly)
    if not a.dry_run and not a.id and TAPPED_ONLY:
        step('moves land', land_moves)
    if not a.dry_run and not a.id and not ONLY and not TAPPED_ONLY:
        step('PR sync', sync_prs)
        if not paused():  # paused: nothing routed, and only a move he tapped is worked
            for t in step('routing', to_route) or []:
                step(f'routing #{t["id"]}', route, t)
    if not a.dry_run and not a.id:
        if stopped():
            return 0  # the kill switch or the circuit breaker: `start` lifts it
        why = step('spend cap', money_stop)
        if why:
            if ONLY:
                step('cap notice', cap_notice, why)
            return 0
        if len(runs_today()) >= MAX_RUNS_A_DAY:
            if ONLY:
                step('cap notice', cap_notice)
            return 0  # the day's runs are used up; the queue waits
    ready = queue()
    if (paused() or TAPPED_ONLY) and not a.id and not ONLY:
        ready = [t for t in ready if tapped(t)]
    if a.id:
        ready = [t for t in ready if t['id'] == a.id]
        if not ready:
            sys.exit(f'task-agent: #{a.id} is not waiting for the agent (open, todo, tagged {TAG}, not parked)')
    if a.dry_run:
        for t in ready:
            print(cli.line(t))
    if not ready:
        if a.dry_run:
            print('queue empty')
        return 0
    return work(ready[0], dry=a.dry_run)


if __name__ == '__main__':
    sys.exit(main())
