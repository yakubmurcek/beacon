    return isinstance(said, dict) and said.get('retry') is True


def requeue(task, after, claimed, words):
    """A run that could not start goes back in the queue with its tags, quietly, and is not counted as one of the
    day's runs; the preflight's backoff applies before the next try. False once it has done so RETRIES_A_DAY times
    in 24 h (then it goes back to him)."""
    tid = task['id']
    path = os.path.join(STATE, 'retries')
    try:
        with open(path) as f:
            seen = json.load(f)
    except (OSError, ValueError):
        seen = {}
    seen = {k: [x for x in v if x > time.time() - 86400] for k, v in seen.items() if isinstance(v, list)}
    if len(seen.get(str(tid), [])) >= RETRIES_A_DAY:
        return False
    seen.setdefault(str(tid), []).append(time.time())
    os.makedirs(STATE, exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump({k: v for k, v in seen.items() if v}, f)
    os.replace(path + '.tmp', path)
    note(tid, '↩️ Agent nemohl začít' + (f' ({words})' if words else '') + '; zkusí to znovu za chvíli.')
    cli.call(f'/api/tasks/{tid}', {'status': 'todo', 'tags': list(dict.fromkeys([*after['tags'], TAG]))})
    unlog_run(claimed)
    open(os.path.join(STATE, f"preflight-failed-{task['project']}"), 'w').close()
    return True


def photos(proof):
    """A repo run's proof for his phone: the newest `before-*` and the newest `after-*` shot (a gate shot is named
    `<unix time>-<capture id>.png`), each captioned with what it shows. Never anything else (`junk-*`)."""
    if not proof or not os.path.isdir(proof):
        return []
    found = {}
    for f in os.listdir(proof):
        m = re.fullmatch(r'(?:(\d+)-)?(before|after)-(.+)\.(png|jpe?g)', f, re.I)
        if not m:
            continue
        path = os.path.join(proof, f)
        rank = (int(m.group(1)) if m.group(1) else int(os.path.getmtime(path)), os.path.getmtime(path), f)
        kind = m.group(2).lower()
        if kind not in found or rank > found[kind][0]:
            found[kind] = (rank, path, m.group(3))
    return [(found[k][1], f"#{os.path.basename(proof).split('-')[1]} {cz}: {found[k][2]}")
            for k, cz in (('before', 'před'), ('after', 'po')) if k in found]


def give_back(task, why, words='', conf=None, since=None, cz=None):
