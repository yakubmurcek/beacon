def suite(conf, where, only=None):
    """The project's regression checks (guardrail 4), run outside the jail: {name: {"bad": n} | {"error"}} or None
    when they could not run at all (Studio busy, someone in Team Create)."""
    cmd = list(conf['suite']) + (['--only', ','.join(only)] if only else [])
    try:
        r = subprocess.run(cmd, cwd=where, capture_output=True, text=True, timeout=20 * 60)
        res = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        res = None
    return res.get('checks') if isinstance(res, dict) else None


def suite_worse(conf, where, base):
    """The checks that got worse than right before the fix (each re-run once: a flaky one must fail twice), or
    None when they could not run. Returns (worse lines, after)."""
    after = suite(conf, where)
    if after is None:
        return None, None
    def bad(res, k):
        v = (res or {}).get(k) or {}
        return v.get('bad') if isinstance(v.get('bad'), int) else None
    worse = [k for k in base if bad(base, k) is not None and (bad(after, k) is None or bad(after, k) > bad(base, k))]
    if worse:
        again = suite(conf, where, worse) or {}
        after.update(again)
        worse = [k for k in worse if bad(after, k) is None or bad(after, k) > bad(base, k)]
    lines = [f"{k}: {bad(base, k)} → {bad(after, k) if bad(after, k) is not None else 'neběžela'}"
             + (f" ({'; '.join(map(str, after[k].get('lines', [])[:2]))})" if isinstance(after.get(k), dict) and after[k].get('lines') else '')
             for k in worse]
    return lines, after


def suite_note(base, after):
    keys = list(dict.fromkeys([*(base or {}), *(after or {})]))
    def val(res, k):
        v = (res or {}).get(k) or {}
        return v.get('bad') if isinstance(v.get('bad'), int) else '–'
    return 'Sada kontrol (před opravou → po ní): ' + ', '.join(f'{k} {val(base, k)} → {val(after, k)}' for k in keys)


def lock_ok(conf, where=None):
    """Right before the checker: nobody else in Studio's Team Create session. Waits up to 30 min, else False."""
    if not conf.get('lock'):
        return True
    end = time.time() + int(os.environ.get('TASK_AGENT_LOCK_MAX', str(30 * 60)))
    while True:
        try:
            if subprocess.run(conf['lock'], cwd=where, capture_output=True, text=True, timeout=300).returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
        if time.time() > end:
            return False
        time.sleep(int(os.environ.get('TASK_AGENT_LOCK_WAIT', '120')))


# The scorecard (guardrail 7): per bug, every run's minutes and cost, the checker's verdict and his answer.
def score(tid, **kv):
    path = os.path.join(STATE, 'scorecard.json')
    try:
        with open(path) as f:
            card = json.load(f)
    except (OSError, ValueError):
        card = {}
    row = card.setdefault(str(tid), {'runs': 0, 'minutes': 0.0, 'usd': 0.0, 'first': NOW()})
    for k, v in kv.items():
        if k in ('runs', 'minutes', 'usd'):
            row[k] = round(row.get(k, 0) + v, 4)
        elif v is not None:
            row[k] = v
    row['last'] = NOW()
    os.makedirs(STATE, exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump(card, f, ensure_ascii=False, indent=1)
    os.replace(path + '.tmp', path)


def scorecard():
    try:
        with open(os.path.join(STATE, 'scorecard.json')) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def week_summary(card, since):
    rows = [r for r in card.values() if (r.get('last') or 0) >= since and not r.get('test')
            and not str(r.get('title', '')).startswith('TEST')]
    if not rows:
        return ''
    n = lambda pred: sum(1 for r in rows if pred(r))
    ok = n(lambda r: r.get('outcome') == 'přijato')
    no = n(lambda r: r.get('outcome') == 'zamítnuto')
    unver = n(lambda r: str(r.get('verdict', '')).startswith(('neověřeno', 'vzdáno')) and not r.get('outcome'))
    wait = len(rows) - ok - no - unver
    usd = sum(r.get('usd') or 0 for r in rows)
    mins = sum(r.get('minutes') or 0 for r in rows)
    per = f', na přijatou opravu ${usd / ok:.2f}' if ok else ''
    return (f"📊 Agent na chyby, posledních 7 dní: {len(rows)} {cz_plural(len(rows), 'chyba', 'chyby', 'chyb')}\n"
            f"✅ přijato {ok} · ❌ zamítnuto {no} · ⚠️ neověřeno {unver} · ⏳ čeká {wait}\n"
            f"⏱️ {mins:.0f} min práce · 💵 ${usd:.2f} v cenách API{per} (platí předplatné)")


def weekly():
    """Mondays from 9:00 Prague, once a week: the scorecard's last 7 days on Telegram, in Czech."""
    now = datetime.datetime.fromtimestamp(NOW(), zoneinfo.ZoneInfo('Europe/Prague'))
    if now.weekday() != 0 or now.hour < 9:
        return
    week = now.strftime('%G-W%V')
    stamp = os.path.join(STATE, 'weekly-told')
    try:
        with open(stamp) as f:
            if f.read().strip() == week:
                return
    except OSError:
        pass
    text = week_summary(scorecard(), NOW() - 7 * 86400)
    os.makedirs(STATE, exist_ok=True)
    with open(stamp, 'w') as f:
        f.write(week)
    if text:
        conf = agent_conf(os.path.join(PROJECTS, ONLY[0][0])) if ONLY else None
        deliver([[*(['--from', conf['from']] if conf and conf.get('from') else []), text]], hold=True)


def stale_reports():
    """A report of this agent he has not answered (its question still the task's last word): one reminder after
    REMIND_DAYS, closed after CLOSE_DAYS with a note; a task whose fix is still in the game goes back to the agent
    to put it back first (the `zahoď` path)."""
    path = os.path.join(STATE, 'reminded')
    try:
        with open(path) as f:
            told = json.load(f)
    except (OSError, ValueError):
        told = {}
    for t in cli.call('/api/tasks?status=todo&limit=2000', auth=False)['tasks']:
        n = t.get('last_note') or {}
        if not allowed(t) or TAG in t['tags'] or not n.get('text', '').startswith('⏳') or not (
                n.get('author') == ME or str(n.get('author', '')).startswith('Claude Code')):
            continue
        age, tid = NOW() - n['at'], t['id']
        conf = agent_conf(os.path.join(PROJECTS, t['project'])) or {}
        ask = n['text'].lstrip('⏳').strip()
        ask = ask[len('Needs you:'):].strip() if ask.startswith('Needs you:') else ask
        if age >= CLOSE_DAYS * 86400:
            full = cli.call(f'/api/tasks/{tid}', auth=False)
            with contextlib.suppress(Exception, SystemExit):
                for q in cli.call(f'/api/questions?status=open&task={tid}', auth=False)['questions']:
                    cli.call(f"/api/questions/{q['id']}/withdraw", {'note': f'bez odpovědi {CLOSE_DAYS} dní'})
            if re.search(rf'-- AGENT #{tid}\b', json.dumps(full.get('comments') or [], ensure_ascii=False)):
                note(tid, f'{STALE} Bez odpovědi {CLOSE_DAYS} dní: agent vrátí své změny v testovací kopii a úkol '
                          'zavře (vrať změny agenta a zavři úkol).')
                cli.call(f'/api/tasks/{tid}', {'status': 'todo', 'tags': list(dict.fromkeys([*t['tags'], TAG]))})
                words = 'agent vrátí svou změnu a úkol zavře'
            else:
                note(tid, f'{STALE} Bez odpovědi {CLOSE_DAYS} dní: zavřeno. Odpověď ho kdykoli otevře znovu.')
                cli.call(f'/api/tasks/{tid}', {'status': 'dropped'})
                words = 'zavřeno'
            score(tid, outcome='bez odpovědi')
            tell(t, f'{STALE} {CLOSE_DAYS} dní bez odpovědi: {words}.', sender=conf.get('from', ''), limit=None, quiet=True)
            told.pop(str(tid), None)
        elif age >= REMIND_DAYS * 86400 and told.get(str(tid)) != n['at']:
            tell(t, f'⏰ Čeká na tebe {int(age // 86400)} dny: {short(ask, ASK_CHARS, CZ_MORE)}',
                 f'Bez odpovědi se za {CLOSE_DAYS - int(age // 86400)} dní zavře.', sender=conf.get('from', ''), limit=None)
            told[str(tid)] = n['at']
    os.makedirs(STATE, exist_ok=True)
    with open(path, 'w') as f:
        json.dump(told, f)


def seed_scorecard():
    """The scorecard from the runs so far (the hub's notes + each run's transcript), once: every task this agent
    ever picked up. Tasks whose bug was planted for a test are marked `test` and left out of the summaries."""
    card = {}
    homes = [p for p in [*glob.glob(os.path.join(WORK, 'claude-*-home')), os.path.join(os.path.expanduser('~'), '.claude')]
             if os.path.isdir(p)]  # jailed runs' config dirs, and root's own for the first unjailed runs
    for t in cli.call('/api/tasks?status=all&limit=4000', auth=False)['tasks']:
        if not allowed(t):
            continue
        full = cli.call(f"/api/tasks/{t['id']}", auth=False)
        picks = [c for c in full['comments'] if c['author'] == ME and c['text'].startswith(PICKUP)]
        if not picks:
            continue
        row = {'title': t['title'], 'first': picks[0]['at'], 'last': full['comments'][-1]['at'], 'runs': 0,
               'minutes': 0.0, 'usd': 0.0}
        for i, c in enumerate(full['comments']):
            m = re.search(r'session ([0-9a-f]{8})', c['text']) if c['author'] == ME and (
                c['text'].startswith(PICKUP) or c['text'].startswith('🔁')) else None
            if not m:
                continue
            row['runs'] += 1
            later = [x for x in full['comments'][i + 1:] if x['author'] != ME or x['text'].startswith('🔎')]
            row['minutes'] += round(((later[0]['at'] if later else c['at']) - c['at']) / 60, 1)
            for home in homes:
                for path in glob.glob(os.path.join(home, 'projects', '*', m.group(1) + '*.jsonl')):
                    row['usd'] += transcript_cost(home, os.path.basename(path)[:-len('.jsonl')])
        row['usd'] = round(row['usd'], 4)
        checks = [c['text'].splitlines()[0] for c in full['comments'] if c['author'] == ME and c['text'].startswith('🔎 Nezávislá')]
        if checks:
            row['verdict'] = 'ověřeno' if '✅' in checks[-1] else 'neověřeno'
        his = [c['text'] for c in full['comments'] if c['author'] == OWNER]
        if his:
            word = ' '.join(his[-1].lower().strip(' .!?').split())
            row['outcome'] = 'přijato' if word in OK_WORDS else 'zamítnuto' if word in DROP else None
        blob = json.dumps(full, ensure_ascii=False)
        row['test'] = bool(re.search(r'AgentPlant|planted|podstrčen|test plant|\bjail copy\b', blob, re.I))
        card[str(t['id'])] = {k: v for k, v in row.items() if v is not None}
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, 'scorecard.json'), 'w') as f:
        json.dump(card, f, ensure_ascii=False, indent=1)
    return card


def show_scorecard(argv):
    if '--seed' in argv:
        seed_scorecard()
    card = scorecard()
    for tid, r in sorted(card.items(), key=lambda x: int(x[0])):
        print(f"#{tid:>5} {'TEST ' if r.get('test') else ''}{str(r.get('title', ''))[:50]:50} runs {r.get('runs', 0)}"
              f" {r.get('minutes', 0):5.0f} min ${r.get('usd', 0):6.2f}  {r.get('verdict', '-')} / {r.get('outcome', '-')}")
    text = week_summary(card, 0 if '--all' in argv else NOW() - 7 * 86400)
    print(text or '(nothing in the window)')
    if '--send' in argv and text:
        conf = agent_conf(os.path.join(PROJECTS, ONLY[0][0])) if ONLY else None
        deliver([[*(['--from', conf['from']] if conf and conf.get('from') else []), text]], hold=True)
    return 0


# ------------------------------------------------------------------ quiet hours

NOW = time.time  # tests set the clock


def quiet_now():
    """22:00-08:00 in Prague: a repo run's messages wait for the morning (the agent may still work)."""
    hour = datetime.datetime.fromtimestamp(NOW(), zoneinfo.ZoneInfo('Europe/Prague')).hour
    return hour >= QUIET[0] or hour < QUIET[1]


def send(args):
    try:
        subprocess.run([TELL, *args], capture_output=True, timeout=120 if '--photo' in args else 60)
    except (OSError, subprocess.SubprocessError):
        pass


def deliver(sends, hold=False):
    """Send now, or (quiet hours, hold) queue them in order in the state folder for flush_held."""
    if hold and quiet_now():
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, 'held.jsonl'), 'a') as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            for args in sends:
                f.write(json.dumps({'args': args, 'at': NOW()}, ensure_ascii=False) + '\n')
        return
    flush_held()
    for args in sends:
        send(args)


def flush_held():
    """The night's held messages, in order, on the first tick after the quiet hours."""
    path = os.path.join(STATE, 'held.jsonl')
    if not os.path.exists(path) or quiet_now():
        return
    sending = path + '.sending'
    try:
        os.replace(path, sending)  # a crash mid-way never sends the first ones twice
    except OSError:
        return
    with open(sending, encoding='utf-8') as f:
        rows = f.read().splitlines()
    for line in rows:
        try:
            send(json.loads(line)['args'])
        except (ValueError, KeyError, TypeError):
            continue
    os.remove(sending)


def cap_notice(why=None):
    """Scoped mode, the day's runs (or its budget) used up while a task waits: one Telegram a day says so."""
    ready = queue()
    if not ready:
        return
    today = datetime.datetime.fromtimestamp(NOW(), zoneinfo.ZoneInfo('Europe/Prague')).strftime('%Y-%m-%d')
    stamp = os.path.join(STATE, 'cap-told')
    try:
        with open(stamp) as f:
            if f.read().strip() == today:
                return
    except OSError:
        pass
    os.makedirs(STATE, exist_ok=True)
    with open(stamp, 'w') as f:
        f.write(today)
    t = ready[0]
    conf = agent_conf(os.path.join(PROJECTS, t['project'])) or {}
    n = MAX_RUNS_A_DAY
    head = (why[0].upper() + why[1:]) if why else f"Dnešní limit agenta vyčerpán ({n} {cz_plural(n, 'běh', 'běhy', 'běhů')})"
    tell(t, f"{head}, #{t['id']} počká do zítřka.", sender=conf.get('from', ''), limit=None)


