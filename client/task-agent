         + '\n\nZpět u tebe: odpověď s podrobnostmi ho vrátí agentovi.')
    tell(task, short(head, ASK_CHARS, CZ_MORE), 'Napiš víc a agent to zkusí znovu, nebo zahoď.',
         sender=conf.get('from', ''), photos=photos(proof), limit=None,
         quiet=why == 'could not start')  # Studio busy all day: nothing for him to do
    return 1


def tell(task, text, hint='', icon='🤖', sender='', photos=(), limit=TELL_CHARS, quiet=False):
    """One Telegram message. It starts with the task number, which is how Hermes knows what a
    reply to it is about (it sees the replied-to text). Proof photos go first, each captioned with
    the task number (a repo run's: also what it shows), then the message. A repo run's message (or
    any in scoped mode) waits out the night (QUIET)."""
    if limit and len(text) > limit:  # he reads it on a phone; the full text is on the task
        text = short(text, limit)
    # Line 1 is what a lock-screen notification shows: the project's emoji and the task in words; its
    # number only at the end of that line as "(#N)", which Hermes routes a reply by (SOUL.md). Not at the
    # message's end: Hermes quotes only the first 500 chars of a replied-to message. 2026-11-22.
    if sender and icon == '🤖':
        icon = sender.split(' ', 1)[0]
    msg = f"{icon} {task['title'][:60]} (#{task['id']})\n{text}" + (f'\n{hint}' if hint else '')
    head = ['--from', sender] if sender else []
    sends = []
    for i, pic in enumerate(photos):
        path, cap = pic if isinstance(pic, tuple) else (pic, f"#{task['id']} {i + 1}/{len(photos)}")
        cap = re.sub(r'^#(\d+) (.*)$', r'📸 \2 (#\1)', cap, flags=re.S)  # "#1755 po: x" → "📸 po: x (#1755)"
        sends.append([*head, '--quiet', '--photo', path, cap])  # the message after it is the one that buzzes
    # quiet: news that needs nothing from him arrives without a sound (2026-11-22, #624)
    sends.append([*head, *(['--quiet'] if quiet else []), msg])
    deliver(sends, hold=bool(ONLY or sender))
    print(msg)


