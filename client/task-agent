def allowed(t):
    """In scoped mode only the listed project:tag pairs; otherwise every task."""
    return not ONLY or any(t['project'] == p and (not tag or tag in t['tags']) for p, tag in ONLY)


# A move he tapped on a Beacon page (a lead's 'Write the draft'…): his own go-ahead for that one task, so it goes
# first and runs even while the agent is paused (the pause stops agents working on their own; 2026-11-24).
TAPPED = re.compile(r'^Beacon move: \S+$', re.M)
# TASK_AGENT_TAPPED=1: an instance that works only those (task-agent-moves on the home server, its own state and lock),
# so a tap never waits behind, or depends on, the scoped game agent.
TAPPED_ONLY = os.environ.get('TASK_AGENT_TAPPED') == '1'


def tapped(t):
    return bool(TAPPED.search(t.get('body') or '')) and AUTO not in (t.get('tags') or [])


def queue():
    tasks = cli.call('/api/tasks?status=todo&limit=2000', auth=False)['tasks']
    today = time.strftime('%Y-%m-%d')
    ready = [t for t in tasks if TAG in t['tags'] and allowed(t) and not any(w in t['tags'] for w in WAITS)
             and not any(d > today for d in NOT_BEFORE.findall(t.get('body') or ''))]
    return sorted(ready, key=lambda t: (not tapped(t), t.get('priority') or 5, (t.get('due') or '9999')[:16], t['created_at']))


def note(tid, text, author=ME):
    cli.call(f'/api/tasks/{tid}/comments', {'text': text, 'author': author})


def gh_env():
