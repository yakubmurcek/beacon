def claims_fix(text):
    """The fixer's last note says the fix works and asks him to test it (`⏳ Needs you: Otestuj …`)."""
    return bool(CLAIM.match(text or ''))


def gate_diff(conf, since):
    """What the fixer really changed, from the Studio gate's own log (outside the jail), never from its notes: every
    script edit and every Edit-mode Luau call since `since`. Play-time calls end with the Play: left out."""
    rows = []
    try:
        with open(conf['checker']['writes_log'], encoding='utf-8', errors='replace') as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(r, dict) or float(r.get('t') or 0) < since:
                    continue
                edit_dm = r.get('datamodel') == 'Edit' or (r.get('datamodel') is None and r.get('mode') == 'Edit')
                if r.get('tool') == 'multi_edit' or (r.get('tool') == 'execute_luau' and edit_dm):
                    rows.append(r)
    except (OSError, KeyError, TypeError, ValueError):
        pass
    out = []
    for r in rows:
        if r['tool'] == 'multi_edit':
            out.append(f"### Script edit: {r.get('file')}")
            for e in r.get('edits') or []:
                out += ['OLD:', '```lua', str(e.get('old_string', '')).rstrip('\n'), '```',
                        'NEW:', '```lua', str(e.get('new_string', '')).rstrip('\n'), '```']
        else:
            out += ['### Luau run on the Edit copy (may be a lasting change, may only read)', '```lua',
                    str(r.get('code') or '').rstrip('\n'), '```']
    return '\n'.join(out)


def check_package(task, conf, claimed, proof, where):
    """The checker's input in `where/check-input`: the bug report (the task as filed plus notes by people, Discord
    and stats before the fix run), the fixer's before/after shots (labelled claims) and the gate's diff. No word the
    fixer wrote, so its reasoning can't sway the verdict. Returns False when there is no diff to check."""
    diff = gate_diff(conf, claimed)
    if not diff.strip():
        return False
    t = cli.call(f"/api/tasks/{task['id']}", auth=False)
    by_people = [c for c in t.get('comments') or [] if c['at'] < claimed and c['author'] not in (ME, ROUTER)
                 and not c['author'].startswith('Claude Code')]
    inp = os.path.join(where, CHECK_INPUT)
    os.makedirs(inp, exist_ok=True)
    frozen = criteria(task, conf, t)
    report = [f"# #{task['id']} {t['title']}", '']
    if frozen:
        report += ['## The frozen definition of fixed (judge only against this and your own runs)', '', frozen, '',
                   '## The report as filed', '']
    report += [t.get('body') or '']
    for c in by_people:
        report += ['', f"## Note by {c['author']}", c['text']]
    with open(os.path.join(inp, 'report.md'), 'w') as f:
        f.write('\n'.join(report) + '\n')
    with open(os.path.join(inp, 'diff.md'), 'w') as f:
        f.write(diff + '\n')
    for path, cap in photos(proof):  # neutral names: the fixer's capture ids are its words
        shutil.copy(path, os.path.join(inp, f"fixer-claim-{'before' if ' před:' in cap else 'after'}{os.path.splitext(path)[1]}"))
    return True


def verify(task, conf, claimed, proof, round_no):
    """One fresh checker run: its own worktree, config dir, jail and gate (check mode), no hub, no Bash, and its
    answer is structured. A pass without a new `after-*` shot of its own is not a pass. Returns the verdict dict
    (with its `photos` and `session`)."""
    cconf, tid = conf['checker'], task['id']
    base = {'verdict': 'cant_verify', 'saw': '', 'why': '', 'photos': [], 'round': round_no}
    if not login_lasts((int(cconf.get('timeout_min') or 35) + 15) * 60):
        return dict(base, why='přihlášení Claude by vypršelo během kontroly')
    try:
        where, repo = workdir(task)
    except (Exception, SystemExit) as e:
        return dict(base, why=f'kontrola se nespustila ({str(e)[:120]})')
    started = time.time()
    cproof = os.path.join(proof, f'check-{round_no}')
    try:
        if not check_package(task, conf, claimed, proof, where):
            return dict(base, why='v logu Studia není žádná změna ke kontrole')
        with open(os.path.join(where, cconf['brief'])) as f:
            brief = f.read().replace('{id}', str(tid)).replace('{input}', os.path.join(where, CHECK_INPUT))
        csid = str(uuid.uuid4())
        log_run()
        cmd = [CLAUDE, '-p', brief, '--session-id', csid, '--permission-mode', 'auto', '--output-format', 'json',
               '--json-schema', CHECK_SCHEMA, '--mcp-config', os.path.join(where, cconf['mcp_config']),
               '--strict-mcp-config', '--tools', ','.join(cconf.get('tools') or ['Read', 'Glob', 'Grep', 'ToolSearch']),
               '--no-chrome', '--setting-sources', 'project', '--max-budget-usd', f'{RUN_USD:g}']
        if cconf.get('model'):
            cmd += ['--model', cconf['model']]
        if cconf.get('effort'):
            cmd += ['--effort', cconf['effort']]
        env = gh_env()
        for k in ('CLAUDE_CODE_SESSION_ID', 'GH_TOKEN', 'TASKS_TOKEN', 'TASKS_URL'):
            env.pop(k, None)  # no hub at all: it can't read the fixer's notes
        env.update({k: str(v) for k, v in (conf.get('env') or {}).items()})
        env['_CONF_ENV'] = ' '.join(conf.get('env') or {})
        env['CTS_AGENT_TASK'] = str(tid)
        timeout = int(cconf.get('timeout_min') or 35) * 60
        unit = CHECK_UNIT.format(id=tid)
        stop_unit(unit)
        # A config dir of its own each time: an earlier check's transcript (the first round's) is never there.
        home = os.path.join(cconf['jail']['config_dir'], f'{tid}-{round_no}-{int(started)}')
        cmd = jailed(cmd, env, where, dict(cconf['jail'], config_dir=home), timeout, unit)
        whole = None
        try:
            r = run_timed(cmd, timeout, unit, cwd=where, env=env)
            whole = json.loads(r.stdout)
            said = whole.get('structured_output')
        except subprocess.TimeoutExpired:
            said = {'verdict': 'cant_verify', 'saw': '', 'why': f'kontrola nestihla doběhnout za {timeout // 60} min'}
        except (ValueError, AttributeError):
            said = {'verdict': 'cant_verify', 'saw': '', 'why': 'kontrola neodevzdala výsledek'}
        finally:
            stop_unit(unit)
            with contextlib.suppress(Exception):  # its cost, read before its config dir (and transcript) goes
                spend(tid, 'checker', csid, run_cost(whole, home, csid), (time.time() - started) / 60)
            shutil.rmtree(home, ignore_errors=True)
        collect_shots(cconf, cproof, started)
        tidy(where, repo, conf, cproof)
    except (Exception, SystemExit) as e:
        with contextlib.suppress(Exception):
            git('worktree', 'remove', '--force', where, cwd=repo)
        return dict(base, why=f'kontrola spadla ({(str(e).strip() or type(e).__name__)[:120]})')
    check = dict(base, **{k: v for k, v in (said or {}).items() if isinstance(v, (str, list, bool))}, session=csid)
    if check.get('verdict') not in ('pass', 'reject', 'cant_verify'):
        check['verdict'] = 'cant_verify'
    check['photos'] = [(p, f"#{tid} kontrola {cap.split(' ', 1)[1]}") for p, cap in photos(cproof)]
    if check['verdict'] == 'pass' and check.get('reproduced_without_fix') is not True:
        # Fail before, pass after (guardrail 3): no bug seen with the fix off = nothing proves the fix did it.
        check.update(verdict='cant_verify', why='kontrola chybu bez opravy sama nezopakovala, takže nic nedokazuje, '
                                                'že ji opravila oprava')
    unmet = [c.get('line', '?') for c in check.get('criteria') or [] if isinstance(c, dict) and c.get('met') is not True]
    if check['verdict'] == 'pass' and (unmet or not check.get('criteria')):
        check.update(verdict='cant_verify', why='nesplněno z „Hotovo když“: ' + ('; '.join(unmet)[:200] if unmet else
                                                                                  'kontrola body nevyhodnotila'))
    if check['verdict'] == 'pass':
        # Evidence, not text: a pass needs its own shot with the fix off and with it on (fail before, pass after).
        for kind, cz in ((' před:', 'před opravou'), (' po:', 'po opravě')):
            if not any(kind in cap for _, cap in check['photos']):
                check.update(verdict='cant_verify', why=f'kontrola řekla „funguje“, ale bez vlastního snímku {cz}')
                break
    return check


def checked(task, conf, claimed, proof, round_no, base):
    """Guardrails round the checker: nobody else in Team Create (else wait, then neověřeno), the regression suite
    against the baseline taken right before the fix (worse = rejected without spending a checker run), then the
    fresh checker itself."""
    gone = {'verdict': 'cant_verify', 'saw': '', 'photos': [], 'round': round_no}
    if not lock_ok(conf):
        return dict(gone, why='v testovací kopii celou dobu editoval někdo jiný (Team Create), kontrola neběžela')
    after, note_line = None, ''
    if conf.get('suite'):
        if base is None:
            return dict(gone, why='sada kontrol před opravou neběžela, není s čím porovnat')
        worse, after = suite_worse(conf, None, base)
        if after is None:
            return dict(gone, why='sada kontrol po opravě neběžela (Studio obsazené?)')
        note_line = suite_note(base, after)
        if worse:
            return {'verdict': 'reject', 'round': round_no, 'photos': [], 'suite': note_line,
                    'saw': 'Po opravě se zhoršila kontrola hry: ' + ', '.join(w.split(' (')[0] for w in worse),
                    'why': 'Po opravě je horší sada kontrol (před → po): ' + '; '.join(worse)
                           + '. Oprav to tak, aby žádná kontrola nebyla horší než před opravou.'}
    check = verify(task, conf, claimed, proof, round_no)
    if note_line:
        check['suite'] = note_line
    return check


def hold_questions(tid):
    """Withdraw the task's open question (the fixer's `⏳ Otestuj`) while its fix is checked: he answers the copy
    task-agent asks again after the verdict, never a fix that may be rejected."""
    try:
        for q in cli.call(f'/api/questions?status=open&task={tid}', auth=False)['questions']:
            cli.call(f"/api/questions/{q['id']}/withdraw", {'note': 'nezávislá kontrola běží; zeptá se znovu'})
    except (Exception, SystemExit) as e:
        print(f'task-agent: #{tid} question not held: {e}', file=sys.stderr)


def reject_note(check):
    """The checker's reject, for the fixer's second run (brief step 1) and for him: its evidence, not an opinion."""
    parts = [f"🔎 Kontrola zamítla opravu (kolo {check['round']}; nezávislý kontrolor, neviděl postup opravy).",
             f"Proč: {check.get('why') or '-'}"]
    for k, cz in (('repro', 'Co hrál'), ('before', 'Bez opravy'), ('after', 'S opravou'), ('console', 'Konzole'),
                  ('suite', 'Sada kontrol')):
        if check.get(k):
            parts.append(f'{cz}: {check[k]}')
    return '\n'.join(parts)


def check_line(check):
    """His phone's line about the check."""
    v = check['verdict']
    if v == 'pass':
        return f"🔎 Nezávislá kontrola: ✅ ověřeno – {check.get('saw') or check.get('why')}"
    if v == 'reject' and check.get('then'):
        return f"🔎 Nezávislá kontrola: ❌ opravu zamítla ({check.get('saw') or check.get('why')}); pak: {check['then']}"
    if v == 'reject':
        return f"🔎 Nezávislá kontrola: ❌ neověřeno, zamítla i opravenou verzi – {check.get('saw') or check.get('why')}"
    return f"🔎 Nezávislá kontrola: ⚠️ neověřeno – {check.get('why') or check.get('saw') or 'bez důvodu'}"


def check_note(check):
    """The full check result as a note on the task (its session, so it can be read later)."""
    lines = [check_line(check)]
    for k, cz in (('expected', 'Očekával'), ('repro', 'Co hrál'), ('before', 'Bez opravy'), ('after', 'S opravou'),
                  ('console', 'Konzole'), ('suite', 'Sada kontrol'), ('why', 'Důvod'), ('limits', 'Neověřil')):
        if check.get(k):
            lines.append(f'{cz}: {check[k]}')
    for c in check.get('criteria') or []:
        if isinstance(c, dict):
            lines.append(f"{'✅' if c.get('met') is True else '❌'} {c.get('line', '?')}"
                         + (f" – {c['evidence']}" if c.get('evidence') else ''))
    if check.get('session'):
        lines.append(f"(kontrola: session {check['session'][:8]}, kolo {check['round']})")
    return '\n'.join(lines)


def refix(task, conf, claimed):
    """The fixer's one retry after a reject: a fresh run on the same task (it reads the reject note first). Returns
    (out, err, sid, its notes, task, asked, left) or None when it could not start."""
    tid = task['id']
    if any(c['author'] == OWNER and c['at'] >= claimed for c in cli.call(f'/api/tasks/{tid}', auth=False)['comments']):
        return None  # he answered meanwhile: his word, not a second try, decides what happens next
    try:
        where, repo = workdir(task)
    except (Exception, SystemExit):
        return None
    if not login_lasts((int(conf.get('timeout_min') or TIMEOUT // 60) + 15) * 60):
        git('worktree', 'remove', '--force', where, cwd=repo)
        return None
    sid = str(uuid.uuid4())
    again = time.time()
    try:
        cli.call(f'/api/tasks/{tid}/sessions', {'session_id': f'Claude Code:{sid}'})
        note(tid, f'🔁 Kontrola opravu zamítla: agent ji opravuje znovu (session {sid[:8]}).')
    except (Exception, SystemExit):
        git('worktree', 'remove', '--force', where, cwd=repo)
        return None
    log_run()
    proof = proof_dir(tid, claimed)
    out, err = run_claude(task, sid, where, brief_prompt(task, where, conf, origin(task, own={f'Claude Code:{sid}'}), proof),
                          conf, proof)
    collect_shots(conf, proof, again)
    left = tidy(where, repo, conf, proof)
    after = cli.call(f'/api/tasks/{tid}', auth=False)
    mine = [c for c in after['comments'] if c['at'] >= again and c['author'] == f'Claude Code {sid[:8]}']
    asked = after['status'] == 'doing' and bool(mine) and mine[-1]['text'].startswith('⏳')
    return out, err, sid, mine, after, asked, left


def proof_dir(tid, claimed):
    return os.path.join(WORK, 'proof', f'task-{tid}-{int(claimed)}')


CZ_MORE = ' … (zbytek je na úkolu)'


def short(text, n, more=' … (the rest is on the task)'):
    """At most n characters, cut at a word; the full text is on the task."""
    return text if len(text) <= n else text[:n].rsplit(' ', 1)[0].rstrip(' ,;:') + more


def conf_hint(ask):
    """What a reply does, for a repo run's ending (his replies: `ok` notes it and hands it back, `zahoď` drops it)."""
    for prefix, hint in AGENT.get('forward_hints', {}).items():  # "send it to <collaborator>" asks: what to reply
        if ask.startswith(prefix):
            return hint
    if re.match(r'(otestuj|ověř|vyzkoušej)', ask, re.I):
        return 'Napiš ok / co je špatně / zahoď.'
    return 'Odpověz sem a agent pokračuje, nebo napiš zahoď.'


def cz_plural(n, one, few, many):
    return one if n == 1 else few if 2 <= n <= 4 else many


def studio_writes(conf, proof, since):
    """The Studio writes of this run, for his phone and the task: from the gate's log (`writes_from`, outside the
    jail, every run appends to it; this run's lines are copied next to the proof), else the worktree's copy in the
    proof folder. Returns (what lasts, e.g. 'Foo: 2 úpravy, execute_luau (Edit): 1 úprava' or '', and how many
    calls ran in a Play's Server/Client, which end with the Play: the repro's ClaudeAgentPlay mark is one)."""
    rows = []
    gate = os.path.join(conf['writes_from'], 'studio-edits.log') if conf.get('writes_from') else None
    src = gate if gate and os.path.isfile(gate) else os.path.join(proof or '', 'studio-edits.log')
    try:
        with open(src, encoding='utf-8', errors='replace') as f:
            for line in f:
                parts = line.rstrip('\n').split('\t')
                if len(parts) < 3:
                    continue
                try:
                    at = datetime.datetime.fromisoformat(parts[0].replace('Z', '+00:00')).timestamp()
                except ValueError:
                    continue
                if src != gate or at >= since:
                    rows.append((line, parts[2]))
    except OSError:
        pass
    if src == gate and rows and proof:
        os.makedirs(proof, exist_ok=True)
        with open(os.path.join(proof, 'gate-studio-edits.log'), 'w') as f:
            f.writelines(line for line, _ in rows)
    count, play = {}, 0
    for _, target in rows:
        m = re.fullmatch(r'execute_luau\((\w*)\)', target)
        if m and m.group(1) in ('Server', 'Client'):
            play += 1
            continue
        name = f'execute_luau ({m.group(1) or "?"})' if m else target.rsplit('.', 1)[-1] or target
        count[name] = count.get(name, 0) + 1
    items = [f"{k}: {n} {cz_plural(n, 'úprava', 'úpravy', 'úprav')}" for k, n in count.items()]
    return ', '.join(items[:6]) + (f' a {len(items) - 6} dalších' if len(items) > 6 else ''), play


def writes_line(writes):
    """'Foo: 1 úprava (+2 v Play, nic trvalého)', 'žádné (+1 v Play, nic trvalého)', 'žádné'."""
    lasting, play = writes
    return (lasting or 'žádné') + (f' (+{play} v Play, nic trvalého)' if play else '')


CZ_WHY = [(re.compile(r'^stopped after (\d+) min'), r'zastaven po \1 min'),
          (re.compile(r'^it ended without a note on the task'), 'skončil bez jediné poznámky na úkolu'),
          (re.compile(r'^it ended without a PR, a question or closing the task'), 'skončil bez otázky a bez uzavření úkolu'),
          (re.compile(r'^the run broke off'), 'běh se přerušil'),
          (re.compile(r'unsaved work left in '), 'v pracovní složce zůstaly neuložené změny: ')]


def cz_why(why):
    for pat, cz in CZ_WHY:
        why = pat.sub(cz, why)
    return why


def wants_retry(out):
