             + '\n\nBack with you: a reply with more detail hands it back to the agent.')
        tell(task, f'The agent stopped short: {why}.', 'Tell me a little more and it tries again, or say mine.')
        return 1
    # A repo's own run: in Czech, with what it changed in Studio before it stopped, so nothing is silent.
    with contextlib.suppress(Exception):
