            outcome(task, False, cz or cz_why(why)[:80])
        score(tid, title=task['title'], verdict='nedokončeno')
    proof = proof_dir(tid, since) if since else None
    writes = writes_line(studio_writes(conf, proof, since) if since else ('', 0))
    head = f'Agent skončil předčasně ({cz or cz_why(why)}). Změny v testovací kopii: {writes}.'
