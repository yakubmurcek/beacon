def criteria(task, conf, full=None):
    """The frozen "Hotovo když" (Done when) block: written when the task was filed, from the reporter's own words,
    in a root-only folder the jailed runs can't see (`criteria_dir`). A task filed with it only in its body (or a
    stats task's) is frozen the first time it is worked. Returns the text, or '' when the task has none."""
    folder = conf.get('criteria_dir')
    if not folder:
        return ''
    path = os.path.join(folder, f"{task['id']}.md")
    try:
        with open(path, encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        pass
    body = (full or task).get('body') or ''
    # "## Done when" (the watchers' frozen block) first; else the "## Done-test" every task body has since the
    # tasks client asks for one: missing it left four specced tasks asking him "Kdy to bude opravené?" (2026-11-22).
    m = CRITERIA_HEAD.search(body) or DONE_TEST.search(body)
    if m:
        nxt = re.search(r'^#{1,4}\s', body[m.end():], re.M)
        block = body[m.start(): m.end() + (nxt.start() if nxt else len(body) - m.end())].strip()
        if not CRITERIA_HEAD.search(body):  # a task's Done-test also names steps after this run: never judged here
            block += '\n' + OUT_OF_RUN
    else:  # a vague report he was asked about (needs_spec, the watcher's question): his answer is the definition
        notes = (full or {}).get('comments') or []
        asked = [i for i, c in enumerate(notes) if SPEC_ASK in c['text'] and c['author'] != OWNER]
        his = [c['text'].strip() for c in notes[asked[-1] + 1:] if c['author'] == OWNER] if asked else []
        if not his:
            return ''
        block = '\n'.join(['## Hotovo když (z odpovědi vlastníka)', *[f'- {x}' for x in his],
                           '- Žádná kontrola ze sady (snow_reach, escape_scan, light_span_check, ui_*) není horší.'])
    os.makedirs(folder, exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(block + '\n')
    return block


def spec_card(task, full):
    """The spec question as a card he can answer without opening the task (2026-11-22: a bare "Kdy to bude
    opravené?" four times, no word on which bug): the bug in the question, what was reported, a one-tap default."""
    title = re.sub(r'^[^:]{1,40}:\s*', '', task['title'])  # "Clean the Snow: …" -> the bug itself
    body = (full or task).get('body') or ''
    said = re.search(r'^Summary:\s*(.+)$', body, re.M)
    if said:
        said = said.group(1).strip()
    else:
        lines = [x.strip() for x in body.splitlines() if x.strip() and not x.lstrip().startswith(('#', '```', 'From ', 'Filed by'))]
        said = lines[0] if lines else ''
    said = said if len(said) <= 300 else said[:299].rstrip() + '…'
    gone = f'Už se neděje: {title}'
    return {
        'question': f'Kdy je „{title}“ opravené? Napiš, co má hráč vidět.',
        'context': '\n'.join([*([f'- 🐞 Nahlášeno: {said}'] if said else []),
                              '- 🤖 Bez toho agent nezačne: nepozná, kdy je hotovo. Tvoje odpověď se stane zadáním.']),
        'options': [gone], 'default': gone, 'kind': 'spec', 'blocking': True, 'task_id': task['id'],
        'asked_by': 'task-agent', 'project': task['project'],
    }


def needs_spec(task, full, conf):  # conf: same signature as the other outcomes
