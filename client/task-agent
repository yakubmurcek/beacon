def tasks_in_jail():
    """Where `tasks` resolves inside the jail (/usr/local/bin/tasks links into the ro-bound client checkout)."""
    found = shutil.which('tasks')
    return os.path.realpath(found) if found else os.path.join(settings.p('projects'), '.tasks-client/client/tasks')


def jailed(cmd, env, where, jail, timeout, unit, sock=None):
    """The run as a transient systemd unit that sees almost nothing: the system read-only, an empty home with only
    the paths the conf lists (no ~/.ssh, no vault, no gh login, no hub token), its own Claude config dir sharing the
    login file, writes only in its worktree. Root's tools to other machines are simply not there (task 1744 review).
    Its unit has a fixed name (`unit`), so a timeout stops it instead of leaving it to RuntimeMaxSec. The hub only
    through `sock`, a TaskProxy for this one task, seen inside at JAIL_SOCK, with `tasks-jail` as its `tasks`."""
    home = jail['config_dir']
    os.makedirs(home, exist_ok=True)
    creds = os.path.join(os.path.expanduser('~'), '.claude', '.credentials.json')
    if not os.path.exists(os.path.join(home, '.credentials.json')):
        open(os.path.join(home, '.credentials.json'), 'w').close()
    keep = {'HOME', 'PATH', 'LANG', 'TASKS_URL', 'CTS_AGENT_TASK', 'CLAUDE_CONFIG_DIR', *(jail.get('env_keep') or []),
            *(env.get('_CONF_ENV') or '').split()} - {'TASKS_TOKEN', 'GH_TOKEN'}
    env.pop('TASKS_TOKEN', None)
    env['CLAUDE_CONFIG_DIR'] = home
    binds = [p for p in ['/run/systemd/resolve', *(jail.get('run') or [])] if os.path.exists(p)]
    if sock:
        binds += [f'{sock}:{JAIL_SOCK}', f'{JAIL_TASKS}:{tasks_in_jail()}']
    # Root without capabilities, namespaces, /proc of others or systemd/D-Bus/tailscale sockets: a fresh
    # systemd-run, /proc/1/root and nsenter all got past the first jail (probe 2026-11-21).
    run = ['systemd-run', f'--unit={unit}', '--wait', '--pipe', '--collect', '--quiet', '-p', 'ProtectSystem=strict',
           '-p', 'ProtectHome=tmpfs', '-p', 'PrivateTmp=yes', '-p', 'NoNewPrivileges=yes',
           '-p', 'CapabilityBoundingSet=', '-p', 'AmbientCapabilities=', '-p', 'RestrictNamespaces=yes',
           '-p', 'ProtectProc=invisible', '-p', 'ProtectKernelTunables=yes', '-p', 'ProtectKernelModules=yes',
           '-p', 'ProtectControlGroups=yes', '-p', 'LockPersonality=yes', '-p', 'TemporaryFileSystem=/run',
           '-p', 'BindReadOnlyPaths=' + ' '.join(binds),
           '-p', f'RuntimeMaxSec={timeout + HELD_MAX}', '-p', f'WorkingDirectory={where}',
           '-p', 'BindReadOnlyPaths=' + ' '.join(p for p in jail.get('ro') or [] if os.path.exists(p)),
           '-p', f'BindPaths={where} {home} {creds}:{home}/.credentials.json']
    for k in sorted(keep):
        if env.get(k):
            run += ['-E', f'{k}={env[k]}']
    return run + cmd


BRAKE_STATE = os.environ.get('TASK_AGENT_BRAKE_STATE', '/var/lib/claude-usage/brake.json')
HELD_MAX = 6 * 3600  # a jailed unit's RuntimeMaxSec on top of its timeout: room for the usage brake's holds


def held(unit):
    """The usage brake (claude-usage-brake) holds this run: its jailed unit frozen, or task-agent's own calls."""
    try:
        with open(BRAKE_STATE) as f:
            units = json.load(f).get('units') or {}
    except (OSError, ValueError, AttributeError):
        return False
    return f'{unit or "task-agent"}.service' in units


def run_timed(cmd, timeout, unit=None, **kw):
    """subprocess.run(capture_output, text, timeout) whose timeout counts only the time the run could work:
    minutes the usage brake froze it don't count (2026-11-22 night: three runs frozen by the brake hit their
    70 min, were called failed and tripped the circuit breaker)."""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         stdin=subprocess.DEVNULL, **kw)
    used, last = 0.0, time.monotonic()
    while True:
        try:
            out, err = p.communicate(timeout=max(0.2, min(15.0, timeout - used)))
            return subprocess.CompletedProcess(cmd, p.returncode, out, err)
        except subprocess.TimeoutExpired:
            now = time.monotonic()
            if not held(unit):
                used += now - last
            last = now
            if used >= timeout:
                p.kill()
                p.communicate()
                raise


def stop_unit(unit):
    """Stop a jailed run's unit and forget a failed one (a leftover makes the next systemd-run of that name fail)."""
    for verb in ('stop', 'reset-failed'):
        try:
            subprocess.run([SYSTEMCTL, verb, f'{unit}.service'], capture_output=True, timeout=120)
        except (OSError, subprocess.SubprocessError):
            pass


def stop_leftover_jails():
    """Called holding the run lock, so no run is going: a jailed unit still alive is a leftover (task-agent killed)."""
    for pattern in (JAIL_UNIT, CHECK_UNIT):  # a fixer's or a checker's run
        try:
            r = subprocess.run([SYSTEMCTL, 'list-units', pattern.format(id='*') + '.service', '--all', '--plain',
                                '--no-legend'], capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            continue
        for line in r.stdout.splitlines():
            name = line.split()[0] if line.split() else ''
            if re.fullmatch(pattern.format(id=r'\d+') + r'\.service', name):
                print(f'task-agent: stopping leftover {name}', file=sys.stderr)
                stop_unit(name[:-len('.service')])


class TaskProxy:
    """The jailed run's only way to the hub: a unix socket that does, for this one task only, what its brief uses:
    `show` (with every note), `note` and `done`. Writes carry the run's own author (`Claude Code <sid8>`, set here,
    never by the caller), so finish() still finds its notes. One JSON request per connection:
    {"cmd": "show"|"note"|"done", "id": N, "text": "...", "json": bool} -> {"out": "..."} or {"error": "..."}."""
    MAX = 200_000

    def __init__(self, tid, sid, path):
        self.tid, self.author, self.path = int(tid), f'Claude Code {sid[:8]}', path
        self.server = None

    def start(self):
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(self.path)
        proxy = self

        class Handler(socketserver.StreamRequestHandler):
            def handle(self):
                try:
                    req = json.loads(self.rfile.readline(proxy.MAX + 1000) or b'{}')
                    out = {'out': proxy.answer(req)}
                except PermissionError as e:
                    out = {'error': str(e)}
                except (Exception, SystemExit) as e:
                    out = {'error': str(e).strip() or type(e).__name__}
                self.wfile.write((json.dumps(out, ensure_ascii=False) + '\n').encode())

        old = os.umask(0o177)  # the socket is root's alone (0600) from its first moment
        try:
            self.server = socketserver.ThreadingUnixStreamServer(self.path, Handler)
        finally:
            os.umask(old)
        os.chmod(self.path, 0o600)
        self.server.daemon_threads = True
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        return self

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None
        with contextlib.suppress(FileNotFoundError):
            os.unlink(self.path)

    def answer(self, req):
        cmd, tid = req.get('cmd'), req.get('id')
        if cmd not in ('show', 'note', 'done'):
            raise PermissionError(f'only `tasks show|note|done {self.tid}` here')
        if not isinstance(tid, int) or isinstance(tid, bool) or tid != self.tid:
            raise PermissionError(f'only your own task #{self.tid}')
        text = req.get('text')
        if text is not None and (not isinstance(text, str) or len(text) > self.MAX):
            raise PermissionError('the text must be a string under 200 kB')
        if cmd == 'show':
            t = cli.call(f'/api/tasks/{tid}', auth=False)
            if req.get('json'):
                return json.dumps(t, ensure_ascii=False, indent=1)
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):  # the client's own layout (the main thread prints nothing meanwhile)
                cli.show(t)
            return buf.getvalue().rstrip('\n')
        if cmd == 'note':
            if not (text or '').strip():
                raise PermissionError('an empty note')
            cli.call(f'/api/tasks/{tid}/comments', {'text': text, 'author': self.author})
            return f'noted on #{tid}'
        if text:
            cli.call(f'/api/tasks/{tid}/comments', {'text': text, 'author': self.author})
        return cli.line(cli.call(f'/api/tasks/{tid}', {'status': 'done'}))


def login_lasts(seconds):
    """True when root's Claude login token is good for `seconds` more. A jailed run shares the login file through
    its own config dir, so it must never be the one to refresh it (a rotated token lost there kills root's login,
    which hosts his Remote Control sessions). An already expired token is refreshed here, as root, first."""
    path = os.path.join(os.path.expanduser('~'), '.claude', '.credentials.json')
    def left():
        try:
            with open(path) as f:
                return json.load(f)['claudeAiOauth']['expiresAt'] / 1000 - time.time()
        except (OSError, ValueError, KeyError, TypeError):
            return -1
    if left() <= 0:
        env = {k: v for k, v in os.environ.items() if k != 'CLAUDE_CODE_SESSION_ID'}
        subprocess.run([CLAUDE, '-p', 'ok', '--model', 'haiku', '--tools', '', '--strict-mcp-config', '--setting-sources', ''],
                       capture_output=True, text=True, timeout=180, env=env, stdin=subprocess.DEVNULL, cwd=WORK if os.path.isdir(WORK) else None)
    return left() > seconds


def run_claude(task, sid, where, text, conf=None, proof=None):
    env = gh_env()
    env.pop('CLAUDE_CODE_SESSION_ID', None)  # its own id comes from --session-id
    cmd = [CLAUDE, '-p', text, '--session-id', sid, '--permission-mode', 'auto', '--output-format', 'json',
           '--json-schema', CONF_SCHEMA if conf else PHONE_SCHEMA, '--max-budget-usd', f'{RUN_USD:g}',
           '--name', task['title'][:60]]  # the session is called by its task, like `tasks doing` names one
    timeout = TIMEOUT
    began = time.time()
    home = ((conf or {}).get('jail') or {}).get('config_dir') or os.path.join(os.path.expanduser('~'), '.claude')
    unit = proxy = None
    if conf:  # the repo's own run: only its MCP servers, its guard hooks on top of the repo's, no browser
        if conf.get('mcp_config'):
            cmd += ['--mcp-config', os.path.join(where, conf['mcp_config']), '--strict-mcp-config']
        if conf.get('settings'):
            cmd += ['--settings', os.path.join(where, conf['settings'])]
        if conf.get('tools'):
            cmd += ['--tools', ','.join(conf['tools'])]
        cmd += ['--no-chrome', '--setting-sources', 'project']  # never his user settings (they authorize push, ssh)
        # Pinned per repo, so a default change in the CLI never silently changes who fixes his bugs.
        if conf.get('model'):
            cmd += ['--model', conf['model']]
        if conf.get('effort'):
            cmd += ['--effort', conf['effort']]
        env.pop('GH_TOKEN', None)
        env.update({k: str(v) for k, v in (conf.get('env') or {}).items()})
        env['_CONF_ENV'] = ' '.join(list(conf.get('env') or {}) + ([conf['proof_env']] if conf.get('proof_env') else []))
        env['CTS_AGENT_TASK'] = str(task['id'])
        if conf.get('proof_env') and proof:
            env[conf['proof_env']] = proof
        if conf.get('timeout_min'):
            timeout = int(conf['timeout_min']) * 60
        if conf.get('jail'):
            unit = JAIL_UNIT.format(id=task['id'])
            stop_unit(unit)  # a leftover of an earlier run of this task
            proxy = TaskProxy(task['id'], sid, os.path.join(SOCK_DIR, f"{task['id']}.sock")).start()
            cmd = jailed(cmd, env, where, conf['jail'], timeout, unit, proxy.path)
    out = None
    try:
        r = run_timed(cmd, timeout, unit, cwd=where, env=env)
    except subprocess.TimeoutExpired:
        return None, f'stopped after {timeout // 60} min'
    finally:  # only the systemd-run client dies with the timeout: the jailed claude would run on
        if unit:
            stop_unit(unit)
        if proxy:
            proxy.stop()
        with contextlib.suppress(Exception):  # the ledger never breaks a run
            try:
                out = json.loads(r.stdout)
            except (NameError, UnboundLocalError, ValueError):
                out = None
            spend(task['id'], 'fixer', sid, run_cost(out, home, sid), (time.time() - began) / 60)
    if not isinstance(out, dict):
        return None, (r.stderr or r.stdout or f'exit {r.returncode}').strip()[-400:]
    if out.get('is_error') or r.returncode != 0:
        return None, str(out.get('result') or f'exit {r.returncode}').strip()[-400:]
    return out, None


# A session's ending in his setup (`⏳ Needs you:` items, their italic detail lines, the status
# legend, `✅ All done.`): never a line for his phone.
ENDING = ('✅', '⏳', '*', '- ', '• ', '|', '#', '🚧', '🔀', '🚀', '👀', '🔴', '```')


def last_line(text):
    lines = [x.strip() for x in (text or '').strip().splitlines() if x.strip() and not x.strip().startswith(ENDING)]
    return lines[-1][:300] if lines else ''


def phone(out):
    """The line for his phone from a finished run: its structured `phone` answer, else the last
    plain line of its reply."""
    if not out:
        return ''
    said = out.get('structured_output')
    words = said.get('phone') if isinstance(said, dict) else None
    words = (words if isinstance(words, str) else '') or last_line(out.get('result'))
    return re.sub(r'^\s*\**ozpin\**\s*:\s*', '', words.strip(), flags=re.I)[:300]


def tidy(where, repo, conf=None, proof=None):
    """Remove the worktree once nothing in it is unsaved; keep it (and say so) otherwise. A repo with its own run
    (conf) keeps only tracked changes: its untracked files are hook logs, copied next to the proof first."""
    if not repo:
        return None
    if conf:
        logs = os.path.join(where, '.claude')
        for fn in os.listdir(logs) if os.path.isdir(logs) else []:
            if proof and (fn.endswith('.log') or fn.endswith('.jsonl')):
                os.makedirs(proof, exist_ok=True)
                shutil.copy(os.path.join(logs, fn), os.path.join(proof, fn))
    dirty = git('status', '--porcelain', *(['--untracked-files=no'] if conf else []), cwd=where).stdout.strip()
    unpushed = git('log', '--oneline', '@{u}..', cwd=where)
    if dirty or (unpushed.returncode == 0 and unpushed.stdout.strip()):
        return f'unsaved work left in {MACHINE}:{where}'
    git('worktree', 'remove', '--force', where, cwd=repo)
    return None


def work(task, dry=False):
    tid = task['id']
    if dry:  # as if its repo were cloned already, when GitHub has one
        repo = os.path.join(PROJECTS, task['project'])
        has = os.path.isdir(os.path.join(repo, '.git')) or (task['project'] != 'personal' and git(
            'ls-remote', '--heads', f"git@github.com:{GITHUB}/{task['project']}.git").returncode == 0)
        print(prompt(task, os.path.join(WORK, f'task-{tid}-…') if has else PROJECTS, repo if has else None, origin(task)))
        return 0
    try:
        where, repo = workdir(task)
    except RuntimeError as e:
        return give_back(task, f'could not set up its repo: {e}')
    except (Exception, SystemExit) as e:  # the hub or git gone mid-way: never left half set up
        return give_back(task, f'the run broke off ({(str(e).strip() or type(e).__name__)[:200]})')
    conf = agent_conf(where)
    base = None
    if conf:
        full = cli.call(f'/api/tasks/{tid}', auth=False)
        if attempts(full['comments']) >= MAX_ATTEMPTS:
            git('worktree', 'remove', '--force', where, cwd=repo)
            return give_up(task, full, conf)
        if conf.get('criteria_dir') and not criteria(task, conf, full):
            git('worktree', 'remove', '--force', where, cwd=repo)
            return needs_spec(task, full, conf)
    if conf and conf.get('preflight'):
        # Before the claim: a busy or sleeping machine leaves the task queued for the next run, never handed back.
        # After a failure it waits `preflight_backoff_min` (the preflight may open apps on another machine).
        stamp = os.path.join(STATE, f"preflight-failed-{task['project']}")
        try:
            if time.time() - os.path.getmtime(stamp) < int(conf.get('preflight_backoff_min', 15)) * 60:
                git('worktree', 'remove', '--force', where, cwd=repo)
                return 0
        except OSError:
            pass
        try:
            pre = subprocess.run(conf['preflight'], cwd=where, capture_output=True, text=True, timeout=600)
            why = '' if pre.returncode == 0 else (pre.stderr or pre.stdout).strip()[-300:]
        except (OSError, subprocess.SubprocessError) as e:
            why = str(e)
        if why:
            print(f'task-agent: #{tid} waits, preflight: {why}', file=sys.stderr)
            git('worktree', 'remove', '--force', where, cwd=repo)
            os.makedirs(STATE, exist_ok=True)
            open(stamp, 'w').close()
            return 0
    if conf and conf.get('suite'):
        # The baseline right before the fix (guardrail 4): what passes now must still pass after it. Can't run =
        # the task waits like a failed preflight.
        base = suite(conf, where)
        if base is None:
            print(f'task-agent: #{tid} waits: the regression suite could not run (Studio busy or someone in Team Create)',
                  file=sys.stderr)
            git('worktree', 'remove', '--force', where, cwd=repo)
            os.makedirs(STATE, exist_ok=True)
            open(os.path.join(STATE, f"preflight-failed-{task['project']}"), 'w').close()
            return 0
    if conf and conf.get('jail') and not login_lasts((int(conf.get('timeout_min') or TIMEOUT // 60) + 15) * 60):
        print(f'task-agent: #{tid} waits: the Claude login expires before a jailed run would end', file=sys.stderr)
        git('worktree', 'remove', '--force', where, cwd=repo)
        return 0
    sid = str(uuid.uuid4())
    claimed = time.time()
    log_run()
    cli.call(f'/api/tasks/{tid}', {'status': 'doing'})
    try:
        return finish(task, sid, claimed, where, repo, conf, base)
    except (Exception, SystemExit) as e:  # never leave it doing with nobody on it
        why = str(e).strip() or type(e).__name__
        print(f'task-agent: #{tid} failed: {why}', file=sys.stderr)
        try:
            return give_back(task, f'the run broke off ({why[:200]})', '', conf, claimed)
        except (Exception, SystemExit):
            return 1  # the hub is gone too: the orphan sweep gives it back on a later run


def finish(task, sid, claimed, where, repo, conf=None, base=None):
    """Run the agent on a claimed task, then act on what the task shows: check a claimed fix, queue a run that
    could not start, give back a run that left nothing, and tell him the result."""
    run = start_run(task, sid, claimed, where, repo, conf)
    run.update(task_outcome(task['id'], claimed, run['sid'], conf))
    run['writes'] = studio_writes(conf, run['proof'], claimed) if conf else None
    run['check'] = None
    if conf and conf.get('checker') and run['asked'] and claims_fix(run['mine'][-1]['text']) and run['writes'][0]:
        check_the_fix(task, conf, claimed, base, run)
    if conf and wants_retry(run['out']) and run['after']['status'] == 'doing' and not (run['asked'] or run['opened']):
        # It could not start (Studio busy, the machine not ready): queued again quietly, not one of the day's runs.
        if not run['writes'][0] and requeue(task, run['after'], claimed, phone(run['out'])):
            return 0
        if not run['writes'][0]:
            why = phone(run['out'])
            return give_back(task, 'could not start', why, conf, claimed,
                             cz=f'dnes už {RETRIES_A_DAY}× nemohl začít' + (f": {why.rstrip('.')}" if why else ''))
    # What the task shows decides, not how the process ended: a PR opened, a question asked or the
    # task closed stands even if the run errored after it; anything else would sit doing with
    # nobody on it, so it goes back.
    if not (run['asked'] or run['opened'] or run['after']['status'] in ('done', 'dropped')):
        why = run['err'] or ('it ended without a note on the task' if not run['said']
                             else 'it ended without a PR, a question or closing the task')
        return give_back(task, why + (f" ({run['left']})" if run['left'] else ''), phone(run['out']), conf, claimed)
    if run['left']:
        note(task['id'], f"⚠️ {run['left']}")
    if conf:
        check, good = run['check'], not run['check'] or run['check']['verdict'] == 'pass'
        outcome(task, good, '' if good else f"kontrola: {check['verdict']}")
        score(task['id'], verdict=('ověřeno' if good else 'neověřeno') if check
              else ('předáno' if run['asked'] else run['after']['status']))
    report(task, run, conf)
    return 0


def start_run(task, sid, claimed, where, repo, conf):
    """Link the session, note the pickup, run the agent and tidy its worktree: the run's raw results."""
    tid = task['id']
    if conf:
        score(tid, title=task['title'])
    cli.call(f'/api/tasks/{tid}/sessions', {'session_id': f'Claude Code:{sid}'})
    context = origin(task, own={f'Claude Code:{sid}'})
    note(tid, f'{PICKUP} on {MACHINE} (session {sid[:8]})'
              + (', with what he said in the session it came from.' if context else '.'))
    proof = proof_dir(tid, claimed) if conf else None
    text = brief_prompt(task, where, conf, context, proof) if conf else prompt(task, where, repo, context)
    out, err = run_claude(task, sid, where, text, conf, proof)
    collect_shots(conf, proof, claimed)
    return {'sid': sid, 'out': out, 'err': err, 'proof': proof, 'left': tidy(where, repo, conf, proof)}


def task_outcome(tid, claimed, sid, conf):
    """What the task shows after the run: its notes since the claim, the agent's own, a question asked, a PR."""
    after = cli.call(f'/api/tasks/{tid}', auth=False)
    said = [c for c in after['comments'] if c['at'] >= claimed and c['author'] != ME]
    mine = [c for c in said if c['author'] == f'Claude Code {sid[:8]}'] if conf else said
    return {'after': after, 'said': said, 'mine': mine,
            'asked': after['status'] == 'doing' and bool(mine) and mine[-1]['text'].startswith('⏳'),
            'opened': after['status'] == 'doing' and any(PR_URL.search(c['text']) for c in said)}


def check_the_fix(task, conf, claimed, base, run):
    """The fixer says a dev-copy fix works: an independent checker verifies it; a reject goes back to the fixer
    once, then a fresh checker judges the whole diff. Updates `run` with the retry's results and the verdict."""
    tid = task['id']
    hold_questions(tid)  # nobody tests a fix the checker may still reject: asked again after the check
    check = checked(task, conf, claimed, run['proof'], 1, base)
    if check['verdict'] == 'reject':
        note(tid, reject_note(check))
        check = refix_after_reject(task, conf, claimed, base, run, check)
    run['check'] = check
    note(tid, check_note(check))
    if run['asked']:  # the question again, after the verdict (its first copy was held while the check ran)
        note(tid, run['mine'][-1]['text'])


def refix_after_reject(task, conf, claimed, base, run, check):
    """The fixer's one retry with the checker's evidence as a note; returns the final check."""
    used = attempts(cli.call(f"/api/tasks/{task['id']}", auth=False)['comments']) >= MAX_ATTEMPTS
    redo = None if used else refix(task, conf, claimed)
    if used:
        return dict(check, then=f'{MAX_ATTEMPTS} pokusy vyčerpány, další už ne')
    if not redo:
        return dict(check, then='agent ji nestihl opravit znovu')
    out, err, sid, mine, after, asked, left2 = redo
    said = [c for c in after['comments'] if c['at'] >= claimed and c['author'] != ME]
    run.update(out=out, err=err, sid=sid, mine=mine, after=after, asked=asked, left=run['left'] or left2, said=said,
               opened=after['status'] == 'doing' and any(PR_URL.search(c['text']) for c in said),
               writes=studio_writes(conf, run['proof'], claimed))
    if asked and claims_fix(mine[-1]['text']) and run['writes'][0]:
        return checked(task, conf, claimed, run['proof'], 2, base)
    # the retry reverted, gave up or asked something else: what it did, in its own phone line
    return dict(check, then=phone(out) or 'oprava se znovu neověřila')


def report(task, run, conf):
    """Tell him how it ended: a question first, a PR to merge, or quiet news."""
    sender = (conf or {}).get('from', '')
    after, check = run['after'], run['check']
    words = phone(run['out']) or f"{after['status']}: see the task"
    changed = f"\n🛠️ Změny v testovací kopii: {writes_line(run['writes'])}." if conf else ''
    pics = photos(run['proof'])
    if check:
        changed += '\n' + check_line(check)
        if check['verdict'] != 'pass':
            words = f'⚠️ Neověřeno: {words}'
        pics = check['photos'] or pics
    if run['asked']:
        # It needs him: back on his list (without the tag, so it isn't picked up again until he
        # answers, which hands it back).
        cli.call(f"/api/tasks/{task['id']}", {'status': 'todo', 'tags': [t for t in after['tags'] if t != TAG]})
        ask = run['mine'][-1]['text'].lstrip('⏳').strip()
        ask = ask[len("Needs you:"):].strip() if ask.startswith("Needs you:") else ask
        if conf:  # a report, not a question: his phone line, then what it needs from him, never cut short
            tell(task, f'{short(words, TELL_CHARS, CZ_MORE)}\n👉 {short(ask, ASK_CHARS, CZ_MORE)}{changed}',
                 conf_hint(ask), sender=sender, photos=pics, limit=None)
        else:
            tell(task, f'One question first: {ask}', 'Answer here and the work carries on, or say mine.')
    elif run['opened']:
        tell(task, PR_URL.sub(lambda m: 'PR #' + m.group(0).rsplit('/', 1)[-1], words), 'Merge it, or tell me what to change.')
    elif conf:  # finished, nothing asked of him: news, no sound
        tell(task, short(words, TELL_CHARS, CZ_MORE) + changed, sender=sender, photos=pics, limit=None, quiet=True)
    else:
        tell(task, words, sender=sender, photos=photos(run['proof']), quiet=True)


def collect_shots(conf, proof, since, src_key='proof_from'):
    """Shots the Studio gate saved during a run (its `proof_from` folder) move into the run's proof folder."""
    src_dir = (conf or {}).get(src_key)
    if not (src_dir and proof and os.path.isdir(src_dir)):
        return
    for f in sorted(os.listdir(src_dir)):
        src = os.path.join(src_dir, f)
        if os.path.getmtime(src) >= since:
            os.makedirs(proof, exist_ok=True)
            shutil.move(src, os.path.join(proof, f))


