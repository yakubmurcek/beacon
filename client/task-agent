def transcript_cost(home, sid):
    """A run's cost at API list prices from its own transcript (a timed-out run has no JSON answer)."""
    try:
        spec = importlib.util.spec_from_file_location('hub_pricing', os.path.join(HERE, '..', 'hub', 'pricing.py'))
        pricing = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(pricing)
    except (OSError, ImportError, AttributeError):
        return 0.0
    seen = {}
    for path in glob.glob(os.path.join(home or '', 'projects', '*', f'{sid}.jsonl')):
        with open(path, encoding='utf-8', errors='replace') as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                m = r.get('message') if isinstance(r, dict) else None
                if r.get('type') == 'assistant' and isinstance(m, dict) and m.get('usage'):
                    seen[m.get('id') or len(seen)] = (m.get('model'), m['usage'])
    usd = 0.0
    for model, u in seen.values():
        cc = u.get('cache_creation') or {}
        usd += pricing.cost(model, 'standard', input=u.get('input_tokens', 0),
                            cache_write_5m=cc.get('ephemeral_5m_input_tokens', 0) if cc else u.get('cache_creation_input_tokens', 0),
                            cache_write_1h=cc.get('ephemeral_1h_input_tokens', 0), cache_read=u.get('cache_read_input_tokens', 0),
