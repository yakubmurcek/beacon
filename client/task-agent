# ------------------------------------------------------------------ the router

def to_route():
    """New open tasks nobody has routed yet: todo, filed since ROUTE_SINCE but over ROUTE_GRACE
    ago, not handed to the agent, not parked, and with no note from the router. Tasks once seen
    routed are remembered on this box, so a minute costs one list read, not one read per task."""
    tasks = cli.call('/api/tasks?status=todo&limit=2000', auth=False)['tasks']
    routed = read_ids('routed')
    fresh = [t for t in tasks if ROUTE_SINCE <= t['created_at'] <= time.time() - ROUTE_GRACE
             and TAG not in t['tags'] and AUTO not in t['tags'] and not any(w in t['tags'] for w in WAITS)
             and t['id'] not in routed]
    out, seen = [], set()
    for t in sorted(fresh, key=lambda t: t['created_at']):
        if (t.get('last_note') or {}).get('author') == ROUTER:
            seen.add(t['id'])
            continue
        full = cli.call(f"/api/tasks/{t['id']}", auth=False)
        if any(c['author'] == ROUTER for c in full['comments']):
            seen.add(t['id'])
            continue
        out.append(dict(t, comments=full['comments']))
        if len(out) >= ROUTE_PER_RUN:
            break
    if seen:
        write_ids('routed', routed | seen)
    return out


def read_ids(name):
    try:
        with open(os.path.join(STATE, name)) as f:
            return {int(x) for x in f.read().split() if x.isdigit()}
    except OSError:
        return set()


def write_ids(name, ids):
    os.makedirs(STATE, exist_ok=True)
    tmp = os.path.join(STATE, name + '.tmp')
    with open(tmp, 'w') as f:
        f.write('\n'.join(map(str, sorted(ids))))
    os.replace(tmp, os.path.join(STATE, name))


def route_prompt(task, context):
    notes = '\n'.join(f"- {c['author']}: {c['text'][:600]}" for c in task.get('comments') or [])
    return f"""Decide who does this task: an AI coding agent working alone, or {OWNER_NAME} (the owner).

The agent is Claude Code running unattended on a Linux server ({MACHINE}) with: every one of his GitHub
repos (it clones, branches, tests and opens a PR; it never merges or deploys to users), the web,
his notes and past conversations (gbrain), his mail (read), ssh to his servers, and his task list.
It can NOT: type a password or 2FA code, pay or spend money, sign anything, touch a physical device
or his Mac/iPhone (Xcode, the simulator, Mac apps, App Store Connect in a browser), send messages to
people in his name, make his product, pricing, taste or client decisions, or merge to production.

route = "agent" when the agent can finish it alone and the result is clear enough to check.
route = "human" when it needs his hands, his accounts, his decision or his voice.
route = "ask" only when the agent could do it but what he wants is unclear: give the one question
that would make it clear.

Task #{task['id']} [{task['project']}]: {task['title']}

{task.get('body') or '(no body)'}
{('Notes:' + chr(10) + notes) if notes else ''}
{('What he typed in the session that filed it:' + chr(10) + context) if context else ''}"""


def decide(task, context):
    cmd = [CLAUDE, '-p', route_prompt(task, context), '--model', ROUTE_MODEL, '--effort', 'low', '--tools', '',
           '--system-prompt', 'You route tasks. Answer only with the JSON asked for.',
           '--setting-sources', '', '--strict-mcp-config', '--output-format', 'json', '--json-schema', ROUTE_SCHEMA,
           '--name', f"Route: {task['title']}"[:60]]  # a readable name in --resume and the usage page
    try:
        r = subprocess.run(cmd, cwd=WORK if os.path.isdir(WORK) else None, capture_output=True, text=True, timeout=300)
        out = json.loads(r.stdout)
        out = out.get('structured_output') if isinstance(out, dict) else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return out if isinstance(out, dict) and out.get('route') in ('agent', 'human', 'ask') else None


def route(task):
    tid = task['id']
    d = decide(task, origin(task))
    if not d:
        return None  # no answer this time: tried again next minute
    why = d.get('why', '').strip()
    if d['route'] == 'agent':
        note(tid, f'🧭 To the agent: {why}', ROUTER)
        cli.call(f'/api/tasks/{tid}', {'tags': [*task['tags'], TAG]})
    elif d['route'] == 'ask' and d.get('question'):
        note(tid, f"🧭 Routing asks first: {why}", ROUTER)
        note(tid, f"⏳ Needs you: {d['question'].strip()}", ROUTER)
        tell(task, f"Before I hand this over, one question: {d['question'].strip()}",
             'Answer here, or say mine and I will leave it to you.', icon='🧭')
    else:
        note(tid, f'🧭 Yours: {why}', ROUTER)
    return d['route']


def runs_today():
    """Agent runs in the last 24 h (a small log on this box), to stay inside MAX_RUNS_A_DAY."""
    path = os.path.join(STATE, 'runs')
    try:
        with open(path) as f:
            words = f.read().split()
    except OSError:
        return []
    out = []
    for x in words:  # a torn line (a crash mid-write) is skipped, never the whole log
        try:
            if float(x) > time.time() - 86400:
                out.append(float(x))
        except ValueError:
            pass
    return out


def unlog_run(at):
    """A run that could not start is not one of the day's runs: its stamp (log_run's, within a second or two) goes."""
    keep, gone = [], False
    for x in runs_today():
        if not gone and abs(x - at) < 3:
            gone = True
            continue
        keep.append(x)
    with open(os.path.join(STATE, 'runs'), 'w') as f:
        f.write('\n'.join(f'{x:.0f}' for x in keep))


def log_run():
    os.makedirs(STATE, exist_ok=True)
    keep = runs_today() + [time.time()]
    with open(os.path.join(STATE, 'runs'), 'w') as f:
        f.write('\n'.join(f'{x:.0f}' for x in keep))


def git(*args, cwd=None):
    return subprocess.run(['git', *args], cwd=cwd, capture_output=True, text=True, timeout=300)


def workdir(task):
    """A fresh worktree of the task's repo at origin's default branch, or the projects folder for
    a task with no repo (a check, research). The repo is cloned there first if it isn't yet."""
    project = task['project']
    repo = os.path.join(PROJECTS, project)
    if not os.path.isdir(os.path.join(repo, '.git')):
        if project == 'personal' or not project.replace('-', '').replace('_', '').replace('.', '').isalnum():
            return PROJECTS, None
        url = f'git@github.com:{GITHUB}/{project}.git'
        if git('ls-remote', '--heads', url).returncode != 0:
            return PROJECTS, None
        if git('clone', '-q', url, repo).returncode != 0:
            return PROJECTS, None
    git('fetch', '-q', 'origin', cwd=repo)
    head = git('symbolic-ref', '--short', 'refs/remotes/origin/HEAD', cwd=repo).stdout.strip() or 'origin/main'
    path = os.path.join(WORK, f"task-{task['id']}-{int(time.time())}")
    os.makedirs(WORK, exist_ok=True)
    r = git('worktree', 'add', '-q', '--detach', path, head, cwd=repo)
    if r.returncode != 0:
        raise RuntimeError(f'git worktree add failed: {r.stderr.strip()[:300]}')
    return path, repo


def origin(task, own=()):
    """What he typed in the sessions linked to the task (the one that filed it, or worked it
    before), from the hub, which has every machine's prompts within seconds. The agent can't
    read a session on another machine, so this is how that conversation reaches it."""
    out, size = [], 0
    for sid in task.get('sessions') or []:
        sid = sid['session_id'] if isinstance(sid, dict) else sid
        if sid in own:
            continue
        try:
            s = cli.call('/api/session?session=' + urllib.parse.quote(sid), auth=False)
        except (SystemExit, Exception):  # not in the hub, or the hub didn't answer: work without it
            continue
        said = [t['text'].strip() for t in s.get('turns') or []
                if t.get('text') and not t['text'].startswith(SCHEDULED) and not t['text'].startswith(SELF)]
        kept = []
        for text in reversed(said[-PROMPTS:]):  # newest first, so a full budget drops the oldest
            text = text if len(text) <= PROMPT_CHARS else text[:PROMPT_CHARS] + ' …'
            if size + len(text) > CONTEXT_CHARS:
                break
            size += len(text)
            kept.insert(0, '  > ' + text.replace('\n', '\n    '))
        if kept:
            out.append('\n'.join([f"Session {sid.split(':', 1)[-1]} ({s.get('agent')} on {s.get('machine')}, "
                                  f"project {s.get('project')}):", *kept]))
    return '\n\n'.join(out)


def agent_conf(where):
    """A repo's own run setup (`.claude/agent/task-agent.json` in the worktree), or None."""
    try:
        with open(os.path.join(where, AGENT_CONF)) as f:
            conf = json.load(f)
    except (OSError, ValueError):
        return None
    return conf if isinstance(conf, dict) else None


def frozen_for_fixer(task, conf):
    block = criteria(task, conf)
    return (f"""
## Hotovo když (frozen when the bug was filed; you can't change it)
The independent checker judges your fix only against this block and its own before/after Play. If you think it is
wrong, say so in your report; never fix toward anything else.

{block}
""") if block else ''


