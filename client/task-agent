def money_stop():
    """Why no run may start now for money, or '': the day's API-price estimate is spent, his plan's week is nearly
    used up, or real money (the plan's paid extra usage) went out today."""
    spent = spent_today()
    if spent >= DAILY_USD:
        return f'dnešní rozpočet agenta je vyčerpaný (${spent:.2f} z ${DAILY_USD:.0f} v cenách API)'
    try:
        with open(USAGE) as f:
            u = json.load(f)
        fetched = datetime.datetime.fromisoformat(u['fetched_at'].replace('Z', '+00:00')).timestamp()
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return ''  # no poller reading: the dollar cap above still holds
    if NOW() - fetched > 3 * 3600:
        return ''
    week = (u.get('weekly') or {}).get('used_percent', u.get('used_percent'))
    if isinstance(week, (int, float)) and week >= WEEK_PCT:
        return f'týdenní limit předplatného je na {week:.0f} % (agent nechává zbytek tobě)'
    extra = u.get('extra_usage') or {}
    used = extra.get('used')
    if isinstance(used, (int, float)):
        path = os.path.join(STATE, 'extra-baseline')
        try:
            with open(path) as f:
                base = json.load(f)
        except (OSError, ValueError):
            base = {}
        if base.get('day') != prague_day() or not isinstance(base.get('used'), (int, float)):
            base = {'day': prague_day(), 'used': used}
            os.makedirs(STATE, exist_ok=True)
            with open(path, 'w') as f:
                json.dump(base, f)
        if used > base['used'] + 0.005:
            return (f"dnes se platí skutečné peníze navíc ({used - base['used']:.2f} {extra.get('currency') or ''}"
                    ' nad předplatné)').replace(' )', ')')
    return ''


