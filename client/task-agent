def attempts(comments):
    """Fix attempts since his last word on the task (or the stale close): a pickup or an after-reject retry each,
    a run that could not start none. Counted from the task's own notes, so it holds across days and machines."""
    start = max([i + 1 for i, c in enumerate(comments) if c['author'] == OWNER
                 or (c['author'] == ME and c['text'].startswith(STALE))] or [0])
    n = 0
    for c in comments[start:]:
        if c['author'] != ME:
            continue
        if c['text'].startswith(PICKUP) or c['text'].startswith('🔁'):
            n += 1
        elif c['text'].startswith('↩️ Agent nemohl začít'):
            n -= 1
    return max(n, 0)


def tried(comments):
    """What the attempts since his last word did, one line each, for his phone."""
    start = max([i + 1 for i, c in enumerate(comments) if c['author'] == OWNER
                 or (c['author'] == ME and c['text'].startswith(STALE))] or [0])
    out = []
    for c in comments[start:]:
        first = c['text'].strip().splitlines()[0] if c['text'].strip() else ''
