{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "moduleDetection": "force",
    "types": []
  },
  "include": ["*.js", "globals.d.ts"],
  "exclude": ["vendor", "sw.js", "knowledge-layout.js"]
}
